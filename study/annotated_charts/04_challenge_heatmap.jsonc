// Vega/Vega-Lite specification with versioned source-data URLs.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 430,
  "background": null,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#405652",
      "titleColor": "#24443f",
      "gridColor": "#e4ebe7"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "data": {
    "url": "data/trails.json?v=8682a4aafe0b"
  },
  "transform": [
    {
      "filter": "datum.grade !== 'Unknown' && datum.gradient !== 'Unknown'"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "trail_count"
        }
      ],
      "groupby": [
        "grade",
        "gradient"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "C1",
            "C2",
            "C3",
            "C4",
            "C5",
            "C6",
            "3"
          ],
          "title": "Recorded code"
        },
        "y": {
          "field": "gradient",
          "type": "ordinal",
          "sort": [
            "Flat",
            "Gentle hills",
            "Short steep hills",
            "Very steep",
            "Very steep and difficult"
          ],
          "title": null,
          "axis": {
            "labelLimit": 145,
            "labelExpr": "datum.label === 'Very steep and difficult' ? 'Very steep + difficult' : datum.label"
          }
        },
        "color": {
          "field": "trail_count",
          "type": "quantitative",
          "scale": {
            "scheme": "blues"
          },
          "legend": {
            "title": "Trails",
            "orient": "bottom"
          }
        },
        "tooltip": [
          {
            "field": "grade",
            "title": "Code"
          },
          {
            "field": "gradient",
            "title": "Terrain"
          },
          {
            "field": "trail_count",
            "title": "Trails"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "C1",
            "C2",
            "C3",
            "C4",
            "C5",
            "C6",
            "3"
          ],
          "title": "Recorded code"
        },
        "y": {
          "field": "gradient",
          "type": "ordinal",
          "sort": [
            "Flat",
            "Gentle hills",
            "Short steep hills",
            "Very steep",
            "Very steep and difficult"
          ],
          "title": null,
          "axis": {
            "labelLimit": 145,
            "labelExpr": "datum.label === 'Very steep and difficult' ? 'Very steep + difficult' : datum.label"
          }
        },
        "text": {
          "field": "trail_count"
        },
        "color": {
          "condition": {
            "test": "datum.trail_count >= 20",
            "value": "white"
          },
          "value": "#183e3b"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "grade": "C3",
            "gradient": "Short steep hills"
          },
          {
            "grade": "C4",
            "gradient": "Short steep hills"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "fill": null,
        "stroke": "#D55E00",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "C1",
            "C2",
            "C3",
            "C4",
            "C5",
            "C6",
            "3"
          ],
          "title": "Recorded code"
        },
        "y": {
          "field": "gradient",
          "type": "ordinal",
          "sort": [
            "Flat",
            "Gentle hills",
            "Short steep hills",
            "Very steep",
            "Very steep and difficult"
          ],
          "title": null,
          "axis": {
            "labelLimit": 145,
            "labelExpr": "datum.label === 'Very steep and difficult' ? 'Very steep + difficult' : datum.label"
          }
        }
      }
    },
    {
      "name": "insight_explanation",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 600,
        "lineHeight": 15,
        "lineBreak": "\n",
        "color": "#24443f"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": -58
        },
        "text": {
          "value": "Largest cell: 31 C3 routes with short steep hills.\nHighlights the most common code–terrain pairing.\nThe outlined C4 cell has 20: terrain crosses codes."
        }
      }
    }
  ],
  "description": "Joint counts of recorded codes and terrain. Missing grades are excluded; the C6 record stays separate.",
  "padding": {
    "left": 8,
    "right": 8,
    "top": 8,
    "bottom": 8
  },
  "usermeta": {
    "annotation_design": "On-chart highlighted finding with a reason for its significance; filtered findings follow the selected cohort."
  }
}
