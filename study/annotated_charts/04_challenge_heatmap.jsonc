// Current chart specification; see DATA_AND_CAVEATS.md for methods.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "data": {
    "url": "data/trails.json"
  },
  "transform": [
    {
      "filter": "datum.grade !== 'Unknown' && datum.gradient !== 'Unknown'"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "trail_count"
        }
      ],
      "groupby": [
        "grade",
        "gradient"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 4
      },
      "encoding": {
        "x": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "Grade 1",
            "Grade 2",
            "Grade 3",
            "Grade 4",
            "Grade 5"
          ],
          "title": "Walking grade",
          "axis": {
            "labelAngle": 0,
            "labelExpr": "replace(datum.label, 'Grade ', '')"
          }
        },
        "y": {
          "field": "gradient",
          "type": "nominal",
          "sort": [
            "Very steep and difficult",
            "Very steep",
            "Short steep hills",
            "Gentle hills",
            "Flat"
          ],
          "title": "Terrain",
          "axis": {
            "labelFontSize": 11,
            "labelLimit": 112,
            "labelExpr": "datum.label === 'Very steep and difficult' ? 'Steep + difficult' : datum.label"
          }
        },
        "color": {
          "field": "trail_count",
          "type": "quantitative",
          "scale": {
            "scheme": "greys"
          },
          "title": "Trail count",
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 150,
            "title": "Trail count"
          }
        },
        "tooltip": [
          {
            "field": "grade",
            "title": "Grade"
          },
          {
            "field": "gradient",
            "title": "Gradient"
          },
          {
            "field": "trail_count",
            "title": "Trails"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 700,
        "limit": 170
      },
      "encoding": {
        "x": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "Grade 1",
            "Grade 2",
            "Grade 3",
            "Grade 4",
            "Grade 5"
          ],
          "axis": {
            "labelAngle": 0,
            "labelExpr": "replace(datum.label, 'Grade ', '')"
          },
          "title": "Walking grade"
        },
        "y": {
          "field": "gradient",
          "type": "nominal",
          "sort": [
            "Very steep and difficult",
            "Very steep",
            "Short steep hills",
            "Gentle hills",
            "Flat"
          ],
          "title": "Terrain",
          "axis": {
            "labelFontSize": 11,
            "labelLimit": 112,
            "labelExpr": "datum.label === 'Very steep and difficult' ? 'Steep + difficult' : datum.label"
          }
        },
        "text": {
          "field": "trail_count"
        },
        "color": {
          "condition": {
            "test": "datum.trail_count > 22",
            "value": "white"
          },
          "value": "#12332f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.grade === 'Grade 3' && datum.gradient === 'Short steep hills'"
        }
      ],
      "mark": {
        "type": "rect",
        "fillOpacity": 0,
        "stroke": "#d95d39",
        "strokeWidth": 3,
        "cornerRadius": 4
      },
      "encoding": {
        "x": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "Grade 1",
            "Grade 2",
            "Grade 3",
            "Grade 4",
            "Grade 5"
          ],
          "title": "Walking grade",
          "axis": {
            "labelAngle": 0,
            "labelExpr": "replace(datum.label, 'Grade ', '')"
          }
        },
        "y": {
          "field": "gradient",
          "type": "nominal",
          "sort": [
            "Very steep and difficult",
            "Very steep",
            "Short steep hills",
            "Gentle hills",
            "Flat"
          ],
          "title": "Terrain",
          "axis": {
            "labelFontSize": 11,
            "labelLimit": 112,
            "labelExpr": "datum.label === 'Very steep and difficult' ? 'Steep + difficult' : datum.label"
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.grade === 'Grade 3' && datum.gradient === 'Short steep hills'"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#20343A",
        "strokeWidth": 1.3
      },
      "encoding": {
        "x": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "Grade 1",
            "Grade 2",
            "Grade 3",
            "Grade 4",
            "Grade 5"
          ]
        },
        "y": {
          "field": "gradient",
          "type": "nominal",
          "sort": [
            "Very steep and difficult",
            "Very steep",
            "Short steep hills",
            "Gentle hills",
            "Flat"
          ]
        },
        "x2": {
          "value": 20
        },
        "y2": {
          "value": 55
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 14,
        "align": "left",
        "baseline": "top",
        "color": "#20343A",
        "stroke": "white",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "x": {
          "value": 8
        },
        "y": {
          "value": 20
        },
        "text": {
          "field": "annotation"
        }
      },
      "transform": [
        {
          "filter": "datum.grade === 'Grade 3' && datum.gradient === 'Short steep hills'"
        },
        {
          "calculate": "'Grade 3 + short steep hills\\n' + datum.trail_count + ' trails: the largest group'",
          "as": "annotation"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 14,
        "align": "left",
        "baseline": "top",
        "color": "#20343A"
      },
      "encoding": {
        "x": {
          "value": 8
        },
        "y": {
          "value": 20
        },
        "text": {
          "field": "annotation"
        }
      },
      "transform": [
        {
          "filter": "datum.grade === 'Grade 3' && datum.gradient === 'Short steep hills'"
        },
        {
          "calculate": "'Grade 3 + short steep hills\\n' + datum.trail_count + ' trails: the largest group'",
          "as": "annotation"
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "domainColor": "#9aa7a4",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "padding": 8,
      "columns": 2,
      "labelLimit": 150
    },
    "header": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#0f172a"
    },
    "text": {
      "font": "Inter",
      "fontSize": 11,
      "color": "#20343A"
    }
  },
  "description": "Direct labels and explanatory callouts are part of the plotting area. Grade colours are consistent across charts."
}
