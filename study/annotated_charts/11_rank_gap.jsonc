// Vega/Vega-Lite specification with versioned source-data URLs.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 520,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "data": {
    "url": "data/lga_stats.json?v=d802712761fc"
  },
  "transform": [
    {
      "filter": "datum.trail_count > 0 && datum.population_rank <= 18"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#a8b8b4",
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "field": "name",
          "type": "nominal",
          "sort": {
            "field": "population_rank",
            "op": "min",
            "order": "ascending"
          },
          "title": null,
          "axis": {
            "grid": true,
            "gridColor": "#e6ece9",
            "gridWidth": 0.7,
            "ticks": false,
            "labelLimit": 145
          },
          "scale": {
            "padding": 0.9
          }
        },
        "x": {
          "field": "population_rank",
          "type": "quantitative",
          "title": [
            "Rank among areas with trails",
            "1 = highest"
          ],
          "scale": {
            "domain": [
              0,
              33
            ],
            "nice": false
          },
          "axis": {
            "values": [
              1,
              5,
              10,
              15,
              20,
              25,
              30,
              32
            ],
            "grid": true,
            "gridColor": "#ccd6d2",
            "gridDash": [
              2,
              3
            ],
            "gridWidth": 1
          }
        },
        "x2": {
          "field": "supply_rank"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "stroke": "#d95d39",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "name",
          "type": "nominal",
          "sort": {
            "field": "population_rank",
            "op": "min",
            "order": "ascending"
          },
          "title": null
        },
        "x": {
          "field": "population_rank",
          "type": "quantitative",
          "title": [
            "Rank among areas with trails",
            "1 = highest"
          ],
          "scale": {
            "domain": [
              0,
              33
            ],
            "nice": false
          }
        },
        "x2": {
          "field": "supply_rank"
        }
      },
      "transform": [
        {
          "filter": "datum.name === 'Whittlesea' || datum.name === 'Cardinia'"
        }
      ]
    },
    {
      "transform": [
        {
          "fold": [
            "population_rank",
            "supply_rank"
          ],
          "as": [
            "measure",
            "rank"
          ]
        },
        {
          "calculate": "datum.measure === 'population_rank' ? 'Population rank' : 'Trail supply rank'",
          "as": "measure_label"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 95
      },
      "encoding": {
        "y": {
          "field": "name",
          "type": "nominal",
          "sort": {
            "field": "population_rank",
            "op": "min",
            "order": "ascending"
          },
          "title": null
        },
        "x": {
          "field": "rank",
          "type": "quantitative"
        },
        "color": {
          "field": "measure_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "Population rank",
              "Trail supply rank"
            ],
            "range": [
              "#264653",
              "#e76f51"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "labelLimit": 180
          }
        },
        "tooltip": [
          {
            "field": "name",
            "title": "LGA"
          },
          {
            "field": "measure_label",
            "title": "Measure"
          },
          {
            "field": "rank",
            "title": "Rank"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.name === 'Whittlesea' || datum.name === 'Cardinia'"
        },
        {
          "calculate": "(datum.population_rank + datum.supply_rank) / 2",
          "as": "annotation_rank"
        },
        {
          "calculate": "datum.name === 'Whittlesea' ? 'Largest shown rank gap · 1 → 30: population leads, supply lags' : 'Lowest supply rank · 4 → 32: populous area, limited km per resident'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 600,
        "align": "center",
        "baseline": "bottom",
        "dy": -8,
        "color": "#20343A",
        "stroke": "white",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "x": {
          "field": "annotation_rank",
          "type": "quantitative"
        },
        "y": {
          "field": "name",
          "type": "nominal",
          "sort": {
            "field": "population_rank",
            "op": "min",
            "order": "ascending"
          },
          "title": null
        },
        "text": {
          "field": "annotation"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.name === 'Whittlesea' || datum.name === 'Cardinia'"
        },
        {
          "calculate": "(datum.population_rank + datum.supply_rank) / 2",
          "as": "annotation_rank"
        },
        {
          "calculate": "datum.name === 'Whittlesea' ? 'Largest shown rank gap · 1 → 30: population leads, supply lags' : 'Lowest supply rank · 4 → 32: populous area, limited km per resident'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 600,
        "align": "center",
        "baseline": "bottom",
        "dy": -8,
        "color": "#20343A"
      },
      "encoding": {
        "x": {
          "field": "annotation_rank",
          "type": "quantitative"
        },
        "y": {
          "field": "name",
          "type": "nominal",
          "sort": {
            "field": "population_rank",
            "op": "min",
            "order": "ascending"
          },
          "title": null
        },
        "text": {
          "field": "annotation"
        }
      }
    },
    {
      "name": "insight_rank_highlight",
      "transform": [
        {
          "filter": "datum.name === 'Whittlesea' || datum.name === 'Cardinia'"
        }
      ],
      "mark": {
        "type": "point",
        "filled": false,
        "stroke": "#b94e13",
        "strokeWidth": 2,
        "size": 170
      },
      "encoding": {
        "x": {
          "field": "supply_rank",
          "type": "quantitative"
        },
        "y": {
          "field": "name",
          "type": "nominal",
          "sort": {
            "field": "population_rank",
            "op": "min",
            "order": "ascending"
          },
          "title": null,
          "axis": {
            "grid": true,
            "gridColor": "#e6ece9",
            "gridWidth": 0.7,
            "ticks": false,
            "labelLimit": 145
          },
          "scale": {
            "padding": 0.9
          }
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "domainColor": "#9aa7a4",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "padding": 8,
      "columns": 1,
      "labelLimit": 220,
      "symbolType": "circle",
      "symbolStrokeWidth": 0,
      "symbolOpacity": 1
    },
    "header": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#0f172a"
    },
    "text": {
      "font": "Inter",
      "fontSize": 11,
      "color": "#20343A"
    }
  },
  "description": "Population and resident-adjusted walking supply ranks among 32 councils with walking records.",
  "usermeta": {
    "annotation_design": "On-chart highlighted finding with a reason for its significance; filtered findings follow the selected cohort."
  }
}
