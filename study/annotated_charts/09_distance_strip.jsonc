// Study copy of charts/09_distance_strip.json. The website loads strict JSON, not this file.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 1099,
  "height": 330,
  "background": null,
  // Shared font, axis and legend settings.
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "domainColor": "#9aa7a4",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "padding": 8
    },
    "header": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#0f172a"
    }
  },
  // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
  "data": {
    "url": "data/distance_points.json"
  },
  // Layers draw in order: context, data, emphasis and annotations.
  "layer": [
    {
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "circle",
        "size": 58,
        "opacity": 0.72,
        "stroke": "#ffffff",
        "strokeWidth": 0.4
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "x": {
          "field": "length_km",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              {
                "expr": "maximumKm"
              }
            ],
            "nice": false
          },
          "axis": {
            "tickCount": 7,
            "grid": true,
            "labelFontSize": 12,
            "titleFontSize": 13,
            "title": {
              "expr": "small ? ['Trail distance (km)','square-root scale'] : 'Trail distance (km, square-root scale)'"
            }
          }
        },
        "y": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "Grade 1",
            "Grade 2",
            "Grade 3",
            "Grade 4",
            "Grade 5"
          ],
          "title": null,
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ]
          }
        },
        "yOffset": {
          "field": "lane",
          "type": "quantitative"
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ],
            "range": [
              "#2a9d8f",
              "#69b578",
              "#e9c46a",
              "#f4a261",
              "#e76f51",
              "#9aa2a6"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Trail"
          },
          {
            "field": "grade",
            "title": "Grade"
          },
          {
            "field": "length_km",
            "title": "Distance (km)",
            "format": ".1f"
          }
        ],
        "opacity": {
          "condition": {
            "test": "selectedTrail === '' || datum.name === selectedTrail",
            "value": 0.85
          },
          "value": 0.1
        },
        "strokeWidth": {
          "condition": {
            "test": "selectedTrail !== '' && datum.name === selectedTrail",
            "value": 3
          },
          "value": 0.5
        }
      }
    },
    {
      // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
      "data": {
        "values": [
          {
            "distance": 5
          }
        ]
      },
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "rule",
        "stroke": "#52716a",
        "strokeDash": [
          4,
          4
        ],
        "strokeWidth": 1.5
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "x": {
          "field": "distance",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              {
                "expr": "maximumKm"
              }
            ],
            "nice": false
          }
        }
      },
      // Ordered filtering and calculations. These definitions now live here rather than in app.js.
      "transform": [
        {
          "filter": "maximumKm >= 5"
        }
      ]
    },
    {
      // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
      "data": {
        "values": [
          {
            "distance": 5,
            "label": "5 km guide"
          }
        ]
      },
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "dy": -8,
        "fontSize": 12,
        "color": "#52716a",
        "limit": {
          "expr": "small ? 135 : 0"
        }
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "x": {
          "field": "distance",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              {
                "expr": "maximumKm"
              }
            ],
            "nice": false
          }
        },
        "y": {
          "value": 0
        },
        "text": {
          "field": "label"
        }
      },
      // Ordered filtering and calculations. These definitions now live here rather than in app.js.
      "transform": [
        {
          "filter": "maximumKm >= 5"
        }
      ]
    },
    {
      // Ordered filtering and calculations. These definitions now live here rather than in app.js.
      "transform": [
        {
          "filter": "selectedTrail === '' || datum.name === selectedTrail"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "annotation_rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.annotation_rank === 1"
        },
        {
          "calculate": "datum.name + '\\n' + format(datum.length_km, '.1f') + ' km'",
          "as": "annotation"
        }
      ],
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "point",
        "filled": false,
        "stroke": "#b34e2d",
        "strokeWidth": 2.5,
        "size": 230
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "x": {
          "field": "length_km",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              {
                "expr": "maximumKm"
              }
            ],
            "nice": false
          },
          "axis": {
            "title": {
              "expr": "small ? ['Trail distance (km)','square-root scale'] : 'Trail distance (km, square-root scale)'"
            }
          }
        },
        "y": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "Grade 1",
            "Grade 2",
            "Grade 3",
            "Grade 4",
            "Grade 5"
          ],
          "title": null,
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ]
          }
        },
        "yOffset": {
          "field": "lane",
          "type": "quantitative"
        }
      }
    },
    {
      // Ordered filtering and calculations. These definitions now live here rather than in app.js.
      "transform": [
        {
          "filter": "selectedTrail === '' || datum.name === selectedTrail"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "annotation_rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.annotation_rank === 1"
        },
        {
          "calculate": "datum.name + '\\n' + format(datum.length_km, '.1f') + ' km'",
          "as": "annotation"
        }
      ],
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "dy": -13,
        "fontSize": 12,
        "fontWeight": 700,
        "lineBreak": "\n",
        "limit": {
          "expr": "small ? 135 : 240"
        },
        "color": "#173b37"
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "x": {
          "field": "length_km",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              {
                "expr": "maximumKm"
              }
            ],
            "nice": false
          },
          "axis": {
            "title": {
              "expr": "small ? ['Trail distance (km)','square-root scale'] : 'Trail distance (km, square-root scale)'"
            }
          }
        },
        "y": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "Grade 1",
            "Grade 2",
            "Grade 3",
            "Grade 4",
            "Grade 5"
          ],
          "title": null,
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ]
          }
        },
        "yOffset": {
          "field": "lane",
          "type": "quantitative"
        },
        "text": {
          "field": "annotation"
        }
      }
    },
    {
      // Ordered filtering and calculations. These definitions now live here rather than in app.js.
      "transform": [
        {
          "calculate": "datum.length_km <= 5 ? 1 : 0",
          "as": "short_walk"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "short_walk",
              "as": "short_count"
            },
            {
              "op": "count",
              "as": "total"
            }
          ]
        },
        {
          "filter": "datum.total > 0"
        },
        {
          "calculate": "'≤5 km: ' + datum.short_count + '/' + datum.total + ' (' + format(datum.short_count/datum.total, '.0%') + ')'",
          "as": "annotation"
        }
      ],
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "text",
        "align": "right",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#52716a",
        "limit": {
          "expr": "small ? 135 : 0"
        }
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "x": {
          "value": {
            "expr": "width - 8"
          }
        },
        "y": {
          "value": {
            "expr": "height - 10"
          }
        },
        "text": {
          "field": "annotation"
        }
      }
    },
    {
      // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
      "data": {
        "values": [
          {}
        ]
      },
      // Ordered filtering and calculations. These definitions now live here rather than in app.js.
      "transform": [
        {
          "filter": "visibleCount === 0"
        }
      ],
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": 700,
        "color": "#173b37",
        "lineBreak": "\n",
        "stroke": "white",
        "strokeWidth": 0.5,
        "limit": {
          "expr": "small ? 135 : 0"
        }
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "x": {
          "value": {
            "expr": "width/2"
          }
        },
        "y": {
          "value": {
            "expr": "height/2"
          }
        },
        "text": {
          "value": "No recorded trails match\nTry another grade, area or distance"
        }
      }
    }
  ],
  // Parameters that the short HTML controls update; expressions react to those changes.
  "params": [
    {
      "name": "chosenGrade",
      "value": "All"
    },
    {
      "name": "chosenLga",
      "value": "All"
    },
    {
      "name": "maximumKm",
      "value": 95
    },
    {
      "name": "accessOnly",
      "value": false
    },
    {
      "name": "selectedTrail",
      "value": ""
    },
    {
      "name": "visibleCount",
      "value": 194
    },
    {
      "name": "distanceExtent",
      "value": 40
    },
    {
      "name": "timeExtent",
      "value": 50
    },
    {
      "name": "small",
      "value": false
    },
    {
      "name": "compact",
      "value": false
    }
  ],
  // Ordered filtering and calculations. These definitions now live here rather than in app.js.
  "transform": [
    {
      "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (chosenLga === 'All' || datum.lga === chosenLga) && isValid(datum.length_km) && datum.length_km <= maximumKm && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
    }
  ],
  // Small sizing metadata read by fitSize() in the HTML; it is not a data encoding.
  "usermeta": {
    "container": "#chart-09",
    "layout": "standard",
    "gutter": 95
  }
}
