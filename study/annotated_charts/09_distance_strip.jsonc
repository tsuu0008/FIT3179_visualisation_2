// STUDY COPY ONLY: the website loads the matching .json, not this .jsonc.
// Filter by a bound grade dropdown. Distance is x; grade is y; lane separates nearby dots.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "autosize": {"type": "fit", "contains": "padding"},
  "background": null,
  // Input records or prepared plotting values.
  "data": {"url": "data/distance_points.json"},
  // Vega-Lite creates these controls; no JavaScript event handler is needed.
  "params": [
    {
      "name": "chosenGrade",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5", "Unknown"],
        "name": "Grade: "
      }
    }
  ],
  // Filter, group or calculate before drawing.
  "transform": [{"filter": "chosenGrade === 'All' || datum.grade === chosenGrade"}],
  // Draw these layers in order, from background to foreground.
  "layer": [
    {
      "mark": {"type": "circle", "size": 58, "opacity": 0.72, "stroke": "#ffffff", "strokeWidth": 0.4},
      "encoding": {
        "x": {
          "field": "length_km",
          "type": "quantitative",
          "scale": {"type": "sqrt", "domain": [0, 95], "nice": false},
          "axis": {
            "tickCount": 7,
            "grid": true,
            "labelFontSize": 12,
            "titleFontSize": 13,
            "title": ["Trail distance (km)", "square-root scale"]
          }
        },
        "y": {
          "field": "grade",
          "type": "ordinal",
          "sort": ["Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5"],
          "title": null,
          "scale": {"domain": ["Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5", "Unknown"]}
        },
        "yOffset": {"field": "lane", "type": "quantitative"},
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": ["Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5", "Unknown"],
            "range": ["#2a9d8f", "#69b578", "#e9c46a", "#f4a261", "#e76f51", "#9aa2a6"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "name", "title": "Trail"},
          {"field": "grade", "title": "Grade"},
          {"field": "length_km", "title": "Distance (km)", "format": ".1f"}
        ]
      }
    },
    {
      "data": {"values": [{"distance": 5}]},
      "mark": {"type": "rule", "stroke": "#52716a", "strokeDash": [4, 4], "strokeWidth": 1.5},
      "encoding": {
        "x": {
          "field": "distance",
          "type": "quantitative",
          "scale": {"type": "sqrt", "domain": [0, 95], "nice": false}
        }
      }
    },
    {
      "data": {"values": [{"distance": 5, "label": "5 km guide"}]},
      "mark": {"type": "text", "align": "left", "dx": 6, "dy": -8, "fontSize": 12, "color": "#52716a", "limit": 135},
      "encoding": {
        "x": {
          "field": "distance",
          "type": "quantitative",
          "scale": {"type": "sqrt", "domain": [0, 95], "nice": false}
        },
        "y": {"value": 0},
        "text": {"field": "label"}
      }
    },
    {
      "transform": [
        {
          "window": [{"op": "row_number", "as": "annotation_rank"}],
          "sort": [{"field": "length_km", "order": "descending"}]
        },
        {"filter": "datum.annotation_rank === 1"},
        {"calculate": "datum.name + '\\n' + format(datum.length_km, '.1f') + ' km'", "as": "annotation"}
      ],
      "mark": {"type": "point", "filled": false, "stroke": "#b34e2d", "strokeWidth": 2.5, "size": 230},
      "encoding": {
        "x": {
          "field": "length_km",
          "type": "quantitative",
          "scale": {"type": "sqrt", "domain": [0, 95], "nice": false},
          "axis": {"title": ["Trail distance (km)", "square-root scale"]}
        },
        "y": {
          "field": "grade",
          "type": "ordinal",
          "sort": ["Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5"],
          "title": null,
          "scale": {"domain": ["Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5", "Unknown"]}
        },
        "yOffset": {"field": "lane", "type": "quantitative"}
      }
    },
    {
      "transform": [
        {
          "window": [{"op": "row_number", "as": "annotation_rank"}],
          "sort": [{"field": "length_km", "order": "descending"}]
        },
        {"filter": "datum.annotation_rank === 1"},
        {"calculate": "datum.name + '\\n' + format(datum.length_km, '.1f') + ' km'", "as": "annotation"}
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "dy": -13,
        "fontSize": 11,
        "fontWeight": 700,
        "lineBreak": "\n",
        "limit": 180,
        "color": "#173b37"
      },
      "encoding": {
        "x": {
          "field": "length_km",
          "type": "quantitative",
          "scale": {"type": "sqrt", "domain": [0, 95], "nice": false},
          "axis": {"title": ["Trail distance (km)", "square-root scale"]}
        },
        "y": {
          "field": "grade",
          "type": "ordinal",
          "sort": ["Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5"],
          "title": null,
          "scale": {"domain": ["Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5", "Unknown"]}
        },
        "yOffset": {"field": "lane", "type": "quantitative"},
        "text": {"field": "annotation"}
      }
    },
    {
      "transform": [
        {"calculate": "datum.length_km <= 5 ? 1 : 0", "as": "short_walk"},
        {
          "aggregate": [{"op": "sum", "field": "short_walk", "as": "short_count"}, {"op": "count", "as": "total"}]
        },
        {"filter": "datum.total > 0"},
        {"calculate": "'≤5 km: ' + datum.short_count + '/' + datum.total", "as": "annotation"}
      ],
      "mark": {"type": "text", "align": "right", "fontSize": 11, "fontWeight": 700, "color": "#52716a", "limit": 135},
      "encoding": {
        "x": {"value": {"expr": "width - 8"}},
        "y": {"value": {"expr": "height - 10"}},
        "text": {"field": "annotation"}
      }
    }
  ],
  // Shared styling for this chart.
  "config": {
    "view": {"stroke": null},
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "domainColor": "#9aa7a4",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "padding": 8,
      "columns": 2,
      "labelLimit": 150
    },
    "header": {"labelFont": "Inter", "titleFont": "Inter", "labelColor": "#0f172a"}
  }
}
