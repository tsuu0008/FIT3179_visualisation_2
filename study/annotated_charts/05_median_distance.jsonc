// Current displayed specification; see DATA_AND_CAVEATS.md for methods.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "data": {
    "url": "data/trails.json"
  },
  "transform": [
    {
      "filter": "datum.grade !== 'Unknown' && isValid(datum.length_km)"
    },
    {
      "aggregate": [
        {
          "op": "median",
          "field": "length_km",
          "as": "median_km"
        },
        {
          "op": "count",
          "as": "trail_count"
        }
      ],
      "groupby": [
        "grade"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 4,
        "strokeCap": "round"
      },
      "encoding": {
        "y": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "Grade 1",
            "Grade 2",
            "Grade 3",
            "Grade 4",
            "Grade 5"
          ],
          "title": null
        },
        "x": {
          "field": "median_km",
          "type": "quantitative",
          "title": "Median trail distance (km)",
          "scale": {
            "domain": [
              0,
              28
            ],
            "nice": false
          }
        },
        "x2": {
          "datum": 0
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#CC79A7",
              "#252525"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 170,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "y": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "Grade 1",
            "Grade 2",
            "Grade 3",
            "Grade 4",
            "Grade 5"
          ],
          "title": null
        },
        "x": {
          "field": "median_km",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              28
            ],
            "nice": false
          }
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#CC79A7",
              "#252525"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "grade",
            "title": "Grade"
          },
          {
            "field": "median_km",
            "title": "Median distance (km)",
            "format": ".1f"
          },
          {
            "field": "trail_count",
            "title": "Trails"
          }
        ],
        "shape": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ],
            "range": [
              "circle",
              "square",
              "triangle-up",
              "diamond",
              "triangle-down",
              "cross"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": false,
        "stroke": "#a64629",
        "strokeWidth": 2,
        "size": 360
      },
      "encoding": {
        "y": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "Grade 1",
            "Grade 2",
            "Grade 3",
            "Grade 4",
            "Grade 5"
          ],
          "title": null
        },
        "x": {
          "field": "median_km",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              28
            ],
            "nice": false
          }
        },
        "tooltip": [
          {
            "field": "grade",
            "title": "Grade"
          },
          {
            "field": "median_km",
            "title": "Median distance (km)",
            "format": ".1f"
          },
          {
            "field": "trail_count",
            "title": "Trails"
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.grade === 'Grade 5'"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "align": {
          "expr": "datum.grade === 'Grade 5' ? 'right' : 'left'"
        },
        "dx": {
          "expr": "datum.grade === 'Grade 5' ? -12 : 10"
        },
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#173b37",
        "lineBreak": "\n",
        "lineHeight": 15,
        "dy": {
          "expr": "datum.grade === 'Grade 5' ? -25 : 0"
        }
      },
      "encoding": {
        "y": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "Grade 1",
            "Grade 2",
            "Grade 3",
            "Grade 4",
            "Grade 5"
          ]
        },
        "x": {
          "field": "median_km",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              28
            ],
            "nice": false
          }
        },
        "text": {
          "field": "annotation"
        }
      },
      "transform": [
        {
          "calculate": "format(datum.median_km,'.1f') + ' km · n=' + datum.trail_count + (datum.grade === 'Grade 5' ? '\\nSmall sample; use caution' : datum.grade === 'Grade 2' ? '\\nTypical short outing' : '')",
          "as": "annotation"
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6,
      "tickCount": 7
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "padding": 8,
      "columns": 2,
      "labelLimit": 150,
      "symbolType": "circle",
      "symbolStrokeWidth": 0,
      "symbolOpacity": 1
    },
    "text": {
      "font": "Inter",
      "fontSize": 11,
      "color": "#20343A"
    }
  },
  "description": "Compact median-distance lollipop chart with a 0–28 km axis, full grade labels, direct value annotations and a caution beside the two-trail Grade 5 sample."
}
