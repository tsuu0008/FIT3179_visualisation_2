// Vega/Vega-Lite specification with versioned source-data URLs.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 430,
  "background": null,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#405652",
      "titleColor": "#24443f",
      "gridColor": "#e4ebe7"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "data": {
    "url": "data/trails.json?v=8682a4aafe0b"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "median",
          "field": "length_km",
          "as": "median_km"
        },
        {
          "op": "count",
          "as": "n"
        }
      ],
      "groupby": [
        "grade"
      ]
    },
    {
      "calculate": "format(datum.median_km,'.1f') + ' km · ' + datum.n + (datum.n === 1 ? ' route' : ' routes')",
      "as": "label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#bccfc8"
      },
      "encoding": {
        "y": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "C1",
            "C2",
            "C3",
            "C4",
            "C5",
            "C6",
            "3",
            "Unknown"
          ],
          "title": "Code"
        },
        "x": {
          "field": "median_km",
          "type": "quantitative",
          "title": "Median distance (km)",
          "scale": {
            "domain": [
              0,
              10
            ]
          }
        },
        "x2": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 95
      },
      "encoding": {
        "y": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "C1",
            "C2",
            "C3",
            "C4",
            "C5",
            "C6",
            "3",
            "Unknown"
          ],
          "title": "Code"
        },
        "x": {
          "field": "median_km",
          "type": "quantitative",
          "title": "Median distance (km)",
          "scale": {
            "domain": [
              0,
              10
            ]
          }
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C6",
              "3",
              "Unknown"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#CC79A7",
              "#252525",
              "#6f52a3",
              "#985d3f",
              "#9daca9"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": {
          "expr": "datum.grade === 'C5' ? 'right' : 'left'"
        },
        "dx": {
          "expr": "datum.grade === 'C5' ? -10 : 10"
        },
        "fontSize": 12,
        "color": "#24443f"
      },
      "encoding": {
        "y": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "C1",
            "C2",
            "C3",
            "C4",
            "C5",
            "C6",
            "3",
            "Unknown"
          ],
          "title": "Code"
        },
        "x": {
          "field": "median_km",
          "type": "quantitative",
          "title": "Median distance (km)",
          "scale": {
            "domain": [
              0,
              10
            ]
          }
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "name": "insight_highlight",
      "transform": [
        {
          "filter": "datum.grade === 'C5' || datum.grade === 'C1'"
        }
      ],
      "mark": {
        "type": "point",
        "filled": false,
        "size": 230,
        "stroke": "#b94e13",
        "strokeWidth": 2
      },
