        },
        "x": {
          "field": "median_km",
          "type": "quantitative",
          "title": "Median distance (km)",
          "scale": {
            "domain": [
              0,
              10
            ]
          }
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "C1",
