        "align": "left",
        "baseline": "top",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 600,
        "lineHeight": 15,
        "lineBreak": "\n",
        "color": "#24443f"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": -72
