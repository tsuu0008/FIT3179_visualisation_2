// Displayed Vega-Lite specification. See source_audit.json for verification.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 350,
  "background": null,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#405652",
      "titleColor": "#24443f",
      "gridColor": "#e4ebe7"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "data": {
    "url": "data/trails.json"
  },
  "layer": [
    {
      "mark": {
        "type": "boxplot",
        "extent": 1.5,
        "size": 18,
        "color": "#407b73"
      },
      "encoding": {
        "y": {
          "field": "duration_group",
          "type": "ordinal",
          "sort": [
            "Under 1 hour",
            "1–4 hours",
            "Over 4 hours",
            "Overnight",
            "Multiple days",
            "Not recorded"
          ],
          "title": null,
          "axis": {
            "labelLimit": 130
          }
        },
        "x": {
          "field": "length_km",
          "type": "quantitative",
          "title": "Recorded distance (km)",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.length_km === 95"
        }
      ],
      "mark": {
        "type": "point",
        "size": 110,
        "filled": false,
        "stroke": "#D55E00",
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "field": "duration_group",
          "type": "ordinal",
          "sort": [
            "Under 1 hour",
            "1–4 hours",
            "Over 4 hours",
            "Overnight",
            "Multiple days",
            "Not recorded"
          ]
        },
        "x": {
          "field": "length_km",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Trail"
          },
          {
            "field": "track_code",
            "title": "Source code"
          },
          {
            "field": "length_km",
            "title": "Distance (km)",
            "format": ".2f"
          },
          {
            "field": "duration_group",
            "title": "Source duration category"
          },
          {
            "field": "gradient",
            "title": "Terrain"
          },
          {
            "field": "lga",
            "title": "Council"
          }
        ]
      }
    }
  ],
  "description": "Distance distributions within official duration categories. Boxes show the middle half of distances and a median line; no exact hours are inferred."
}
