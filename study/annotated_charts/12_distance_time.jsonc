// STUDY COPY ONLY: the website loads the matching .json, not this .jsonc.
// Draw distance/time points, fit a linear regression and label two unusual records.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 390,
  "autosize": {"type": "fit", "contains": "padding"},
  "background": null,
  // Input records or prepared plotting values.
  "data": {"url": "data/trails.json"},
  // Filter, group or calculate before drawing.
  "transform": [
    {"filter": "isValid(datum.length_km) && isValid(datum.hours) && datum.hours > 0"},
    {"calculate": "datum.length_km / datum.hours", "as": "pace_kmh"}
  ],
  // Draw these layers in order, from background to foreground.
  "layer": [
    {
      "mark": {"type": "point", "filled": true, "opacity": 0.68, "size": 72},
      "encoding": {
        "x": {
          "field": "length_km",
          "type": "quantitative",
          "title": "Distance (km)",
          "scale": {"domain": [0, 42], "nice": false}
        },
        "y": {
          "field": "hours",
          "type": "quantitative",
          "scale": {"domain": [0, 52], "nice": false},
          "title": "Estimated time (hours)"
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": ["Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5", "Unknown"],
            "range": ["#bdd7e7", "#6baed6", "#4292c6", "#2171b5", "#084594", "#9aa2a6"]
          },
          "title": "Grade"
        },
        "tooltip": [
          {"field": "name", "title": "Trail"},
          {"field": "grade", "title": "Grade"},
          {"field": "length_km", "title": "Distance (km)"},
          {"field": "hours", "title": "Hours"},
          {"field": "pace_kmh", "title": "Implied pace (km/h)", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [{"regression": "hours", "on": "length_km", "method": "linear"}],
      "mark": {"type": "line", "color": "#153e3a", "strokeDash": [6, 4], "strokeWidth": 2},
      "encoding": {
        "x": {"field": "length_km", "type": "quantitative", "scale": {"domain": [0, 42], "nice": false}},
        "y": {"field": "hours", "type": "quantitative", "scale": {"domain": [0, 52], "nice": false}}
      }
    },
    {
      "mark": {"type": "point", "filled": false, "size": 240, "stroke": "#b34e2d", "strokeWidth": 2},
      "encoding": {
        "x": {
          "field": "length_km",
          "type": "quantitative",
          "title": "Distance (km)",
          "scale": {"domain": [0, 42], "nice": false}
        },
        "y": {
          "field": "hours",
          "type": "quantitative",
          "scale": {"domain": [0, 52], "nice": false},
          "title": "Estimated time (hours)"
        },
        "tooltip": [
          {"field": "name", "title": "Trail"},
          {"field": "grade", "title": "Grade"},
          {"field": "length_km", "title": "Distance (km)"},
          {"field": "hours", "title": "Hours"},
          {"field": "pace_kmh", "title": "Implied pace (km/h)", "format": ".1f"}
        ]
      },
      "transform": [{"filter": "datum.name === 'Track Ninety Six' || datum.name === 'Great Dividing Trail'"}]
    },
    {
      "transform": [
        {"filter": "datum.name === 'Track Ninety Six' || datum.name === 'Great Dividing Trail'"},
        {
          "calculate": "datum.name + '\\n' + format(datum.length_km, '.1f') + ' km · ' + format(datum.hours, '.0f') + ' hours'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -7,
        "dy": -12,
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#173b37",
        "lineBreak": "\n",
        "limit": 135
      },
      "encoding": {
        "x": {"field": "length_km", "type": "quantitative", "scale": {"domain": [0, 42], "nice": false}},
        "y": {"field": "hours", "type": "quantitative", "scale": {"domain": [0, 52], "nice": false}},
        "text": {"field": "annotation"}
      }
    },
    {
      "transform": [
        {"regression": "hours", "on": "length_km", "method": "linear", "params": true},
        {"calculate": "'Trend: ' + format(datum.coef[1], '.2f') + ' h/km'", "as": "annotation"}
      ],
      "mark": {"type": "text", "align": "right", "fontSize": 12, "color": "#173b37", "dy": -8, "limit": 135},
      "encoding": {
        "x": {"value": {"expr": "width - 14"}},
        "y": {"value": {"expr": "height * 0.47"}},
        "text": {"field": "annotation"}
      }
    }
  ],
  // Shared styling for this chart.
  "config": {
    "view": {"stroke": null},
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "domainColor": "#9aa7a4",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6,
      "tickCount": 7
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "padding": 8,
      "columns": 2,
      "labelLimit": 150
    },
    "header": {"labelFont": "Inter", "titleFont": "Inter", "labelColor": "#0f172a"}
  }
}
