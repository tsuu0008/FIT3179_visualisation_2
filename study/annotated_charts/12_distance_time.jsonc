// Vega/Vega-Lite specification with versioned source-data URLs.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 440,
  "background": null,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#405652",
      "titleColor": "#24443f",
      "gridColor": "#e4ebe7"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "data": {
    "url": "data/trails.json?v=d0f82fb8345d"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "trails"
        }
      ],
      "groupby": [
        "duration_group"
      ]
    },
    {
      "calculate": "datum.trails + ' trails · ' + format(datum.trails / 195, '.0%')",
      "as": "label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 25,
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "y": {
          "field": "duration_group",
          "type": "ordinal",
          "sort": [
            "Under 1 hour",
            "1–4 hours",
            "Over 4 hours",
            "Overnight",
            "Multiple days",
            "Not recorded"
          ],
          "title": null,
          "axis": {
            "labelLimit": 135
          }
        },
        "x": {
          "field": "trails",
          "type": "quantitative",
          "title": "Number of walking routes",
          "scale": {
            "domain": [
              0,
              140
            ]
          }
        },
        "color": {
          "condition": {
            "test": "datum.duration_group === 'Not recorded'",
            "value": "#D55E00"
          },
          "value": "#407b73"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": {
          "expr": "datum.duration_group === 'Under 1 hour' || datum.duration_group === 'Overnight' ? 32 : 8"
        },
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#24443f"
      },
      "encoding": {
        "y": {
          "field": "duration_group",
          "type": "ordinal",
          "sort": [
            "Under 1 hour",
            "1–4 hours",
            "Over 4 hours",
            "Overnight",
            "Multiple days",
            "Not recorded"
          ],
          "title": null,
          "axis": {
            "labelLimit": 135
          }
        },
        "x": {
          "field": "trails",
          "type": "quantitative",
          "title": "Number of walking routes",
          "scale": {
            "domain": [
              0,
              140
            ]
          }
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "name": "insight_duration_outline",
      "transform": [
        {
          "filter": "datum.duration_group === 'Under 1 hour' || datum.duration_group === 'Overnight'"
        }
      ],
      "mark": {
        "type": "bar",
        "height": 29,
        "filled": false,
        "stroke": "#b94e13",
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "field": "duration_group",
          "type": "ordinal",
          "sort": [
            "Under 1 hour",
            "1–4 hours",
            "Over 4 hours",
            "Overnight",
            "Multiple days",
            "Not recorded"
          ],
          "title": null,
          "axis": {
            "labelLimit": 135
          }
        },
        "x": {
          "field": "trails",
          "type": "quantitative",
          "title": "Number of walking routes",
          "scale": {
            "domain": [
              0,
              140
            ]
          }
        }
      }
    },
    {
      "name": "review_duration_max",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 16,
        "color": "#24443f"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": -66
        },
        "text": {
          "value": "MOST COMMON: UNDER 1 HOUR\n111 routes · 57% of all 195 records\nMost recorded options fit a brief outing."
        }
