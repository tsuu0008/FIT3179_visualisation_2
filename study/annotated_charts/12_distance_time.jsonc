// Current displayed specification; see DATA_AND_CAVEATS.md for methods.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 480,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "data": {
    "url": "data/trails.json"
  },
  "transform": [
    {
      "filter": "isValid(datum.length_km) && isValid(datum.hours) && datum.hours > 0"
    },
    {
      "calculate": "datum.length_km / datum.hours",
      "as": "pace_kmh"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "point",
        "filled": true,
        "opacity": 0.68,
        "size": 72
      },
      "encoding": {
        "x": {
          "field": "length_km",
          "type": "quantitative",
          "title": "Distance (km)",
          "scale": {
            "domain": [
              0,
              42
            ],
            "nice": false
          }
        },
        "y": {
          "field": "hours",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              62
            ],
            "nice": false
          },
          "title": "Estimated time (hours)"
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#CC79A7",
              "#252525",
              "#9B9B9B"
            ]
          },
          "title": "Grade"
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Trail"
          },
          {
            "field": "grade",
            "title": "Grade"
          },
          {
            "field": "length_km",
            "title": "Distance (km)"
          },
          {
            "field": "hours",
            "title": "Hours"
          },
          {
            "field": "pace_kmh",
            "title": "Implied pace (km/h)",
            "format": ".1f"
          }
        ],
        "shape": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ],
            "range": [
              "circle",
              "square",
              "triangle-up",
              "diamond",
              "triangle-down",
              "cross"
            ]
          },
          "legend": {},
          "title": "Grade"
        }
      }
    },
    {
      "transform": [
        {
          "regression": "hours",
          "on": "length_km",
          "method": "linear"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#153e3a",
        "strokeDash": [
          6,
          4
        ],
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "length_km",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              42
            ],
            "nice": false
          }
        },
        "y": {
          "field": "hours",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              62
            ],
            "nice": false
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.name === \"Track Ninety Six\""
        },
        {
          "calculate": "datum.name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + format(datum.hours,'.0f') + ' h\\n48 h estimate: a major time outlier'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "point",
        "size": 250,
        "filled": false,
        "color": "#20343A",
        "strokeWidth": 1.6
      },
      "encoding": {
        "x": {
          "field": "length_km",
          "type": "quantitative"
        },
        "y": {
          "field": "hours",
          "type": "quantitative"
        }
      },
      "name": "outlierPoint"
    },
    {
      "name": "outlierLeader",
      "transform": [
        {
          "filter": "datum.name === \"Track Ninety Six\""
        },
        {
          "calculate": "datum.name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + format(datum.hours,'.0f') + ' h\\n48 h estimate: a major time outlier'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#20343A",
        "strokeWidth": 1.1
      },
      "encoding": {
        "x": {
          "field": "length_km",
          "type": "quantitative"
        },
        "y": {
          "value": {
            "expr": "scale('y',datum.hours)-10"
          }
        },
        "y2": {
          "value": 52
        }
      }
    },
    {
      "name": "outlierNoteHalo",
      "transform": [
        {
          "filter": "datum.name === \"Track Ninety Six\""
        },
        {
          "calculate": "datum.name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + format(datum.hours,'.0f') + ' h\\n48 h estimate: a major time outlier'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 13,
        "align": "right",
        "baseline": "top",
        "color": "#20343A",
        "stroke": "white",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width-12"
          }
        },
        "y": {
          "value": 12
        },
        "text": {
          "field": "annotation"
        }
      }
    },
    {
      "name": "outlierNote",
      "transform": [
        {
          "filter": "datum.name === \"Track Ninety Six\""
        },
        {
          "calculate": "datum.name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + format(datum.hours,'.0f') + ' h\\n48 h estimate: a major time outlier'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 13,
        "align": "right",
        "baseline": "top",
        "color": "#20343A"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width-12"
          }
        },
        "y": {
          "value": 12
        },
        "text": {
          "field": "annotation"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.name === \"Great Dividing Trail\""
        },
        {
          "calculate": "datum.name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + format(datum.hours,'.0f') + ' h\\nLonger distance, much shorter estimate'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "point",
        "size": 250,
        "filled": false,
        "color": "#20343A",
        "strokeWidth": 1.6
      },
      "encoding": {
        "x": {
          "field": "length_km",
          "type": "quantitative"
        },
        "y": {
          "field": "hours",
          "type": "quantitative"
        }
      },
      "name": "longerPoint"
    },
    {
      "name": "longerLeader",
      "transform": [
        {
          "filter": "datum.name === \"Great Dividing Trail\""
        },
        {
          "calculate": "datum.name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + format(datum.hours,'.0f') + ' h\\nLonger walk; shorter time'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#20343A",
        "strokeWidth": 1.1
      },
      "encoding": {
        "x": {
          "field": "length_km",
          "type": "quantitative"
        },
        "y": {
          "value": {
            "expr": "scale('y',datum.hours)+10"
          }
        },
        "y2": {
          "value": {
            "expr": "scale('y',datum.hours)+19"
          }
        }
      }
    },
    {
      "name": "longerNoteHalo",
      "transform": [
        {
          "filter": "datum.name === \"Great Dividing Trail\""
        },
        {
          "calculate": "datum.name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + format(datum.hours,'.0f') + ' h\\nLonger walk; shorter time'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 13,
        "align": "right",
        "baseline": "top",
        "color": "#20343A",
        "stroke": "white",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width-12"
          }
        },
        "y": {
          "value": {
            "expr": "scale('y',datum.hours)+24"
          }
        },
        "text": {
          "field": "annotation"
        }
      }
    },
    {
      "name": "longerNote",
      "transform": [
        {
          "filter": "datum.name === \"Great Dividing Trail\""
        },
        {
          "calculate": "datum.name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + format(datum.hours,'.0f') + ' h\\nLonger walk; shorter time'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 13,
        "align": "right",
        "baseline": "top",
        "color": "#20343A"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width-12"
          }
        },
        "y": {
          "value": {
            "expr": "scale('y',datum.hours)+24"
          }
        },
        "text": {
          "field": "annotation"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "domainColor": "#9aa7a4",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6,
      "tickCount": 7
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "padding": 8,
      "columns": 2,
      "labelLimit": 150
    },
    "header": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#0f172a"
    },
    "text": {
      "font": "Inter",
      "fontSize": 11,
      "color": "#20343A"
    }
  },
  "description": "Distance–time scatterplot with short vertical annotation leaders: the time-outlier note sits above its point and the longer-walk note below its point. Both leaders stay on the same side of the fitted trend as their target and stop outside the text and point rings."
}
