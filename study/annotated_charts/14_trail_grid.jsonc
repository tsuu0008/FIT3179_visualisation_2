// Vega/Vega-Lite specification with versioned source-data URLs.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 680,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "description": "Square spatial bin map of retained trail midpoints in fixed 25 km equal-area cells. A clipped grid shows empty land bins. The lettered peak-bin pointer and explanation share the legend footer.",
  "projection": {
    "type": "identity",
    "reflectY": true,
    "scale": {
      "expr": "min((width-20)/840000,(height-20)/600000)"
    },
    "translate": {
      "expr": "[width/2-30000*(min((width-20)/840000,(height-20)/600000)),8+340000*(min((width-20)/840000,(height-20)/600000))]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/trail_grid.json?v=3ead494c8619",
        "format": {
          "type": "json",
          "property": "outline"
        },
        "name": "grid_outline"
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0f3f5",
        "stroke": "#8b9da8",
        "strokeWidth": 0.8
      }
    },
    {
      "name": "landGrid",
