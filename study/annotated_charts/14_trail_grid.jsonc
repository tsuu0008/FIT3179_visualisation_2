      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -390000,
              450000
            ],
            "range": [
              {
                "expr": "width/2-420000*(min((width-20)/840000,(height-20)/600000))"
              },
              {
                "expr": "width/2+420000*(min((width-20)/840000,(height-20)/600000))"
              }
            ],
            "nice": false,
            "zero": false
          }
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -260000,
              340000
            ],
            "range": [
              {
                "expr": "8+600000*(min((width-20)/840000,(height-20)/600000))"
              },
              8
            ],
            "nice": false,
            "zero": false
          }
        },
        "x2": {
          "field": "x1"
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "count_band",
          "type": "ordinal",
          "scale": {
            "domain": [
              "0",
              "1",
              "2–3",
              "4–6",
              "7–13"
            ],
            "range": [
              "#f0f3f5",
              "#d3e4ed",
              "#8abbd5",
              "#3e87b0",
              "#13557c"
            ]
          },
          "legend": {
            "title": "Trails per 25 km bin",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 5,
            "symbolType": "circle",
            "symbolSize": 110,
            "titleLimit": 300,
            "labelExpr": "datum.label === '0' ? '0 recorded' : datum.label"
          }
        },
        "tooltip": [
          {
            "field": "trail_count",
            "title": "Recorded trails"
          },
          {
            "field": "share",
            "type": "quantitative",
            "format": ".1%",
            "title": "Share of all 195 trails"
          },
          {
            "field": "areas",
            "title": "Council counts"
          },
          {
            "field": "trail_km",
            "type": "quantitative",
            "format": ".1f",
            "title": "Combined trail km"
          },
          {
            "field": "cell_id",
            "title": "Grid cell"
          }
        ]
      }
    },
