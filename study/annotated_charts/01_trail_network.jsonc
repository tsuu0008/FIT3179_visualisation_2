// STUDY COPY ONLY: the website loads the matching .json, not this .jsonc.
// Layer boundaries, coloured route lines, an outlier point and a value label.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "autosize": {"type": "fit", "contains": "padding"},
  "background": null,
  "projection": {"type": "mercator"},
  // Draw these layers in order, from background to foreground.
  "layer": [
    {
      // Input records or prepared plotting values.
  "data": {"url": "data/lga.geojson", "format": {"type": "json", "property": "features"}},
      "mark": {"type": "geoshape", "fill": "#eef3f1", "stroke": "#9eafaa", "strokeWidth": 0.8},
      "encoding": {}
    },
    {
      "data": {"url": "data/trails.geojson", "format": {"type": "json", "property": "features"}},
      "mark": {"type": "geoshape", "filled": false, "strokeWidth": 3, "strokeCap": "round"},
      "encoding": {
        "color": {
          "field": "properties.grade",
          "type": "nominal",
          "scale": {
            "domain": ["Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5", "Unknown"],
            "range": ["#2a9d8f", "#69b578", "#e9c46a", "#f4a261", "#e76f51", "#9aa2a6"]
          },
          "title": "Grade",
          "legend": null
        },
        "opacity": {"value": 0.9},
        "tooltip": [
          {"field": "properties.name", "type": "nominal", "title": "Trail"},
          {"field": "properties.grade", "type": "nominal", "title": "Grade"},
          {"field": "properties.length_km", "type": "quantitative", "title": "Distance (km)", "format": ".1f"},
          {"field": "properties.hours", "type": "quantitative", "title": "Time (hours)", "format": ".1f"},
          {"field": "properties.lga", "type": "nominal", "title": "LGA"}
        ]
      }
    },
    {
      "data": {"url": "data/trails.json"},
      // Filter, group or calculate before drawing.
  "transform": [{"filter": "datum.name === 'Upper Yarra Walking Track'"}],
      "mark": {
        "type": "circle",
        "size": 130,
        "filled": true,
        "color": "#7f1d1d",
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "tooltip": [
          {"field": "name", "title": "Trail"},
          {"field": "length_km", "title": "Distance (km)"},
          {"field": "grade", "title": "Grade"}
        ]
      }
    },
    {
      "data": {"url": "data/trails.json"},
      "transform": [{"filter": "datum.name === 'Upper Yarra Walking Track'"}],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "dy": -16,
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#7f1d1d",
        "lineBreak": "\n",
        "limit": 180,
        "stroke": "white",
        "strokeWidth": 3,
        "strokeJoin": "round"
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"value": "Longest recorded walk\nUpper Yarra · 95 km"}
      }
    },
    {
      "data": {"url": "data/trails.json"},
      "transform": [{"filter": "datum.name === 'Upper Yarra Walking Track'"}],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "dy": -16,
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#7f1d1d",
        "lineBreak": "\n",
        "limit": 180
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"value": "Longest recorded walk\nUpper Yarra · 95 km"}
      }
    }
  ],
  // Shared styling for this chart.
  "config": {
    "view": {"stroke": null},
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "domainColor": "#9aa7a4",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "orient": "bottom",
      "padding": 8,
      "columns": 2,
      "direction": "horizontal",
      "labelLimit": 150
    },
    "header": {"labelFont": "Inter", "titleFont": "Inter", "labelColor": "#0f172a"}
  }
}
