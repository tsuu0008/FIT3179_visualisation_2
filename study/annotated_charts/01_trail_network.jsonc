    },
    {
      "name": "frame",
      "update": "frames[pickTrail] || frames[0]"
    },
    {
      "name": "fitZoom",
      "update": "clamp(log(min((width-60)/(256*frame.dx),(height-90)/(256*frame.dy)))/LN2,5,16)"
    },
    {
      "name": "zoom",
      "init": "fitZoom",
      "on": [
        {
          "events": {
            "signal": "fitZoom"
          },
          "update": "fitZoom"
        },
        {
          "events": {
            "signal": "reset"
          },
          "update": "fitZoom"
        },
        {
          "events": {
            "signal": "zoomIn"
          },
          "update": "min(zoom+1,16)"
        },
        {
          "events": {
            "signal": "zoomOut"
          },
          "update": "max(zoom-1,5)"
        }
      ]
    },
    {
      "name": "world",
      "update": "256 * pow(2,zoom)"
    },
    {
      "name": "tileZoom",
      "update": "floor(zoom)"
    },
    {
      "name": "tileSize",
      "update": "256 * pow(2,zoom-tileZoom)"
    },
    {
      "name": "dragStart",
      "value": null,
      "on": [
        {
          "events": "view:pointerdown",
          "update": "[x(),y(),center[0],center[1]]"
        }
      ]
    },
    {
      "name": "center",
      "value": [
        0.9041666666666666,
        0.6094445289046861
      ],
      "on": [
        {
          "events": {
            "signal": "frame"
          },
          "update": "[frame.x,frame.y]"
        },
        {
          "events": {
            "signal": "reset"
          },
          "update": "[frame.x,frame.y]"
        },
        {
          "events": "[view:pointerdown, window:pointerup] > window:pointermove",
          "update": "dragStart ? [clamp(dragStart[2]+(dragStart[0]-x())/world,0,1),clamp(dragStart[3]+(dragStart[1]-y())/world,.01,.99)] : center"
        }
      ]
    },
    {
      "name": "left",
      "update": "center[0]*world-width/2"
    },
    {
      "name": "top",
      "update": "center[1]*world-height/2"
    },
    {
      "name": "tileColumns",
      "update": "ceil(width/tileSize)+1"
    },
    {
      "name": "tileRows",
      "update": "ceil(height/tileSize)+1"
    }
  ],
  "projections": [
    {
      "name": "mapProjection",
      "type": "mercator",
      "scale": {
        "signal": "world/(2*PI)"
      },
      "translate": [
        {
          "signal": "width/2-center[0]*world+world/2"
        },
        {
          "signal": "height/2-center[1]*world+world/2"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "tiles",
      "transform": [
        {
          "type": "sequence",
          "start": 0,
          "stop": {
            "signal": "tileColumns*tileRows"
          },
          "as": "index"
        },
        {
          "type": "formula",
          "expr": "floor(left/tileSize)+datum.index%tileColumns",
          "as": "tx"
        },
        {
          "type": "formula",
          "expr": "floor(top/tileSize)+floor(datum.index/tileColumns)",
          "as": "ty"
        },
        {
          "type": "filter",
          "expr": "datum.tx>=0 && datum.ty>=0 && datum.tx<pow(2,tileZoom) && datum.ty<pow(2,tileZoom)"
        },
        {
          "type": "formula",
          "expr": "'https://tile.openstreetmap.org/'+tileZoom+'/'+datum.tx+'/'+datum.ty+'.png'",
          "as": "tileUrl"
        }
      ]
    },
    {
      "name": "routes",
      "url": "data/trails.geojson?v=a56d45f25728",
      "format": {
        "type": "json",
        "property": "features"
      }
    },
    {
      "name": "callouts",
      "values": [
        {
          "mx": 0.9045279497546302,
          "my": 0.6118542133534499,
          "side": "left",
          "label": [
            "Largest council cluster: 32 routes",
            "Murrindindi offers more recorded choices",
            "Highlights concentration, rather than easy access"
          ]
        },
        {
          "mx": 0.9055973069139864,
          "my": 0.6134619598440708,
          "side": "right",
          "label": [
            "Maximum: Upper Yarra · 95 km",
            "Over 43× the 2.2 km middle distance",
            "Highlights an unusually long commitment"
          ]
        }
      ],
      "transform": [
        {
          "type": "filter",
          "expr": "pickTrail===0 && zoom<=8"
        }
      ]
    },
    {
      "name": "selectedRoute",
      "source": "routes",
      "transform": [
        {
          "type": "filter",
          "expr": "pickTrail !== 0 && datum.properties.id === pickTrail"
        },
        {
          "type": "formula",
          "as": "insight",
          "expr": "[datum.properties.name, format(datum.properties.length_km,'.1f')+' km · '+datum.properties.grade, datum.properties.length_km === 95 ? 'Dataset maximum: highlights the long-distance tail.' : datum.properties.length_km > 2.2 ? 'Above the 2.2 km middle distance: compare the greater distance commitment.' : 'At or below the 2.2 km middle distance: a short route can still be demanding.']"
        }
      ]
    },
    {
      "name": "insight_east_west",
      "values": [
        {}
      ],
      "transform": [
        {
          "type": "filter",
          "expr": "pickTrail===0 && zoom<=8 && width>650"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "group",
      "name": "mapSurface",
      "clip": true,
      "encode": {
        "update": {
          "width": {
            "signal": "width"
          },
          "height": {
            "signal": "height"
          }
        }
      },
      "marks": [
        {
          "type": "image",
          "interactive": false,
          "from": {
            "data": "tiles"
          },
          "encode": {
            "update": {
              "url": {
                "field": "tileUrl"
              },
              "x": {
                "signal": "datum.tx*tileSize-left"
              },
              "y": {
                "signal": "datum.ty*tileSize-top"
              },
              "width": {
                "signal": "tileSize"
              },
              "height": {
                "signal": "tileSize"
              }
            }
          }
        },
        {
          "type": "shape",
          "name": "walkingRoutes",
          "from": {
            "data": "routes"
          },
          "encode": {
            "update": {
              "fill": {
                "value": null
              },
              "stroke": {
                "value": "#3155d9"
              },
              "strokeWidth": {
                "value": 2.3
              },
              "opacity": {
                "signal": "pickTrail===0 ? .95 : .25"
              },
              "tooltip": {
                "signal": "{'Trail':datum.properties.name,'Recorded grade':datum.properties.grade,'Distance (km)':datum.properties.length_km,'Duration':datum.properties.duration_group,'Recorded route status':datum.properties.closure,'Council':datum.properties.lga}"
              }
            }
          },
          "transform": [
            {
              "type": "geoshape",
              "projection": "mapProjection"
            }
          ]
        },
        {
          "type": "shape",
          "name": "selectedWalkingRoute",
          "from": {
            "data": "selectedRoute"
          },
          "encode": {
            "update": {
              "fill": {
                "value": null
              },
              "stroke": {
                "value": "#D55E00"
              },
              "strokeWidth": {
                "value": 4
              },
              "tooltip": {
                "signal": "{'Trail':datum.properties.name,'Recorded grade':datum.properties.grade,'Distance (km)':datum.properties.length_km,'Duration':datum.properties.duration_group,'Recorded route status':datum.properties.closure}"
              }
            }
          },
          "transform": [
            {
              "type": "geoshape",
              "projection": "mapProjection"
            }
          ]
        },
        {
          "type": "rule",
          "interactive": false,
          "from": {
            "data": "callouts"
          },
          "encode": {
            "update": {
              "x": {
                "signal": "datum.mx*world-left"
              },
              "y": {
                "signal": "datum.my*world-top"
              },
              "x2": {
                "signal": "width>650 ? (datum.side==='left' ? 38 : width-280) : 32"
              },
              "y2": {
                "signal": "width>650 || datum.side==='left' ? 88 : 170"
              },
              "stroke": {
                "value": "#405952"
              },
              "strokeDash": {
                "value": [
                  4,
                  3
                ]
              }
            }
          }
        },
        {
          "type": "symbol",
          "interactive": false,
          "from": {
            "data": "callouts"
          },
          "encode": {
            "update": {
              "x": {
                "signal": "datum.mx*world-left"
              },
              "y": {
                "signal": "datum.my*world-top"
              },
              "size": {
                "value": 150
              },
              "fill": {
                "value": "white"
              },
              "stroke": {
                "value": "#405952"
              }
            }
          }
        },
        {
          "type": "rect",
          "interactive": false,
          "from": {
            "data": "callouts"
          },
          "encode": {
            "update": {
              "x": {
                "signal": "width>650 ? (datum.side==='left' ? 16 : width-326) : 12"
              },
              "y": {
                "signal": "width>650 || datum.side==='left' ? 12 : 94"
              },
              "width": {
                "signal": "width>650 ? 310 : width-24"
              },
              "height": {
                "value": 76
              },
              "fill": {
                "value": "#ffffff"
              },
              "fillOpacity": {
                "value": 0.95
              },
              "cornerRadius": {
                "value": 5
              }
            }
          }
        },
        {
          "type": "text",
          "interactive": false,
          "from": {
            "data": "callouts"
          },
          "encode": {
            "update": {
              "x": {
                "signal": "width>650 ? (datum.side==='left' ? 26 : width-316) : 22"
              },
              "y": {
                "signal": "width>650 || datum.side==='left' ? 25 : 107"
              },
              "text": {
                "field": "label"
              },
              "fontSize": {
                "value": 11.5
              },
              "lineHeight": {
                "value": 19
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "value": "#183c36"
              },
              "baseline": {
                "value": "top"
              }
            }
          }
        },
        {
          "type": "rect",
          "name": "insight_selected_back",
          "interactive": false,
          "from": {
            "data": "selectedRoute"
          },
          "encode": {
            "update": {
              "x": {
                "value": 12
              },
              "y": {
                "signal": "height-94"
              },
              "width": {
                "signal": "width-24"
              },
              "height": {
                "value": 82
              },
              "fill": {
                "value": "white"
              },
              "fillOpacity": {
                "value": 0.96
              },
              "cornerRadius": {
                "value": 5
              }
            }
          }
        },
        {
          "type": "text",
          "name": "insight_selected_label",
          "interactive": false,
          "from": {
            "data": "selectedRoute"
          },
          "encode": {
            "update": {
              "x": {
                "value": 24
              },
              "y": {
                "signal": "height-80"
              },
              "text": {
                "field": "insight"
              },
              "fontSize": {
                "value": 12
              },
              "lineHeight": {
                "value": 20
              },
              "fontWeight": {
                "value": 600
              },
              "baseline": {
                "value": "top"
              },
              "fill": {
                "value": "#24443f"
              }
            }
          }
        },
        {
          "type": "rect",
          "interactive": false,
          "from": {
            "data": "insight_east_west"
          },
          "encode": {
            "update": {
              "x": {
                "value": 16
              },
              "y": {
                "signal": "height-91"
              },
              "width": {
                "value": 344
              },
              "height": {
                "value": 77
              },
              "fill": {
                "value": "white"
              },
              "fillOpacity": {
