        },
        {
          "type": "text",
          "interactive": false,
          "from": {
            "data": "insight_east_west"
          },
          "encode": {
            "update": {
              "x": {
                "value": 26
              },
              "y": {
                "signal": "height-78"
              },
              "text": {
                "value": [
                  "East of 145°E: 152 routes; west: 43.",
                  "78% of recorded route points lie on the eastern side.",
                  "This concentration changes the regional choice set."
