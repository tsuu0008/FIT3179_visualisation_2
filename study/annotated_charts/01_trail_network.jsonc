// Study copy of charts/01_trail_network.json. The website loads strict JSON, not this file.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700,
  "height": 430,
  "background": null,
  // Shared font, axis and legend settings.
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "domainColor": "#9aa7a4",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "orient": "bottom",
      "padding": 8,
      "columns": 6,
      "direction": "horizontal",
      "labelLimit": 150
    },
    "header": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#0f172a"
    }
  },
  // Reactive geographic centre, scale, translation and clipping.
  "projection": {
    "type": "mercator",
    "center": {
      "expr": "mapCenter"
    },
    "scale": {
      "expr": "mapScale"
    },
    "translate": {
      "expr": "[width/2,height/2]"
    },
    "clipExtent": {
      "expr": "[[0,0],[width,height]]"
    }
  },
  // Layers draw in order: context, data, emphasis and annotations.
  "layer": [
    {
      // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
      "data": {
        "name": "mapBoundsData",
        "url": "data/map_bounds.json"
      },
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "point",
        "opacity": 0,
        "size": 0
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 0
        }
      }
    },
    {
      // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
      "data": {
        "url": "data/lga.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "geoshape",
        "fill": "#eef3f1",
        "stroke": "#9eafaa",
        "strokeWidth": 0.8
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        }
      }
    },
    {
      // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
      "data": {
        "url": "data/trails.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeWidth": 3,
        "strokeCap": "round"
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        },
        "color": {
          "field": "properties.grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ],
            "range": [
              "#2a9d8f",
              "#69b578",
              "#e9c46a",
              "#f4a261",
              "#e76f51",
              "#9aa2a6"
            ]
          },
          "title": "Grade"
        },
        "opacity": {
          "value": 0.9
        },
        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "Trail"
          },
          {
            "field": "properties.grade",
            "type": "nominal",
            "title": "Grade"
          },
          {
            "field": "properties.length_km",
            "type": "quantitative",
            "title": "Distance (km)",
            "format": ".1f"
          },
          {
            "field": "properties.hours",
            "type": "quantitative",
            "title": "Time (hours)",
            "format": ".1f"
          },
          {
            "field": "properties.lga",
            "type": "nominal",
            "title": "LGA"
          }
        ]
      }
    },
    {
      // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
      "data": {
        "url": "data/trails.json"
      },
      // Ordered filtering and calculations. These definitions now live here rather than in app.js.
      "transform": [
        {
          "filter": "datum.name === 'Upper Yarra Walking Track'"
        }
      ],
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "circle",
        "size": 130,
        "filled": true,
        "color": "#7f1d1d",
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Trail"
          },
          {
            "field": "length_km",
            "title": "Distance (km)"
          },
          {
            "field": "grade",
            "title": "Grade"
          }
        ]
      }
    },
    {
      // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
      "data": {
        "url": "data/trails.json"
      },
      // Ordered filtering and calculations. These definitions now live here rather than in app.js.
      "transform": [
        {
          "filter": "datum.name === 'Upper Yarra Walking Track'"
        }
      ],
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "dy": -16,
        "font": "Inter",
        "fontSize": {
          "expr": "width < 500 ? 10 : 11"
        },
        "fontWeight": 700,
        "color": "#7f1d1d",
        "lineBreak": "\n",
        "limit": {
          "expr": "width < 500 ? 140 : 200"
        },
        "stroke": "white",
        "strokeWidth": 3,
        "strokeJoin": "round"
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "value": "Longest recorded walk\nUpper Yarra · 95 km"
        }
      }
    },
    {
      // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
      "data": {
        "url": "data/trails.json"
      },
      // Ordered filtering and calculations. These definitions now live here rather than in app.js.
      "transform": [
        {
          "filter": "datum.name === 'Upper Yarra Walking Track'"
        }
      ],
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "dy": -16,
        "font": "Inter",
        "fontSize": {
          "expr": "width < 500 ? 10 : 11"
        },
        "fontWeight": 700,
        "color": "#7f1d1d",
        "lineBreak": "\n",
        "limit": {
          "expr": "width < 500 ? 140 : 200"
        }
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "value": "Longest recorded walk\nUpper Yarra · 95 km"
        }
      }
    },
    {
      "name": "selectedRegion",
      // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
      "data": {
        "url": "data/map_regions.json"
      },
      // Ordered filtering and calculations. These definitions now live here rather than in app.js.
      "transform": [
        {
          "filter": "chosenLga === 'All' ? datum.properties.name === 'Victoria' : datum.properties.name === chosenLga"
        }
      ],
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#6f8c7e",
        "strokeWidth": 1
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        },
        "tooltip": [
          {
            "field": "properties.name",
            "title": "Area"
          }
        ]
      }
    }
  ],
  // Parameters that the short HTML controls update; expressions react to those changes.
  "params": [
    {
      "name": "chosenLga",
      "value": "All"
    },
    {
      "name": "small",
      "value": false
    },
    {
      "name": "compact",
      "value": false
    },
    {
      "name": "zoom",
      "value": 1
    },
    {
      "name": "mapBounds",
      "expr": "data('mapBoundsData')[0]"
    },
    {
      "name": "mapCenter",
      "expr": "mapBounds ? mapBounds[chosenLga].center : [145,-37]"
    },
    {
      "name": "mapScale",
      "expr": "mapBounds ? min((width-28)/mapBounds[chosenLga].dx,(height-28)/mapBounds[chosenLga].dy)*zoom : 1"
    }
  ],
  // Small sizing metadata read by fitSize() in the HTML; it is not a data encoding.
  "usermeta": {
    "container": "#chart-01",
    "layout": "map",
    "gutter": 65
  }
}
