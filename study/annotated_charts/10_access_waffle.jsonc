// Study copy of charts/10_access_waffle.json. The website loads strict JSON, not this file.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 500,
  "height": 357,
  "background": null,
  // Shared font, axis and legend settings.
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "domainColor": "#9aa7a4",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "padding": 8
    },
    "header": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#0f172a"
    }
  },
  // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
  "data": {
    "url": "data/access_waffle.json"
  },
  // Layers draw in order: context, data, emphasis and annotations.
  "layer": [
    {
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "square",
        "size": {
          "expr": "pow(width/14*0.88,2)"
        },
        "cornerRadius": 3
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "x": {
          "field": "column",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -0.5,
              13.5
            ],
            "nice": false
          }
        },
        "y": {
          "field": "row",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -0.5,
              9.5
            ],
            "nice": false
          }
        },
        "color": {
          "field": "status",
          "type": "nominal",
          "scale": {
            "domain": [
              "Full or partial access",
              "No disabled access"
            ],
            "range": [
              "#e76f51",
              "#d8e2df"
            ]
          },
          "title": "Recorded access"
        },
        "tooltip": [
          {
            "field": "status",
            "title": "Each square = 1%"
          }
        ]
      }
    },
    {
      // Ordered filtering and calculations. These definitions now live here rather than in app.js.
      "transform": [
        {
          "filter": "datum.status === 'Full or partial access'"
        }
      ],
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "square",
        "size": {
          "expr": "pow(width/14*0.88,2)"
        },
        "fillOpacity": 0,
        "stroke": "#b34e2d",
        "strokeWidth": 1.2
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "x": {
          "field": "column",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -0.5,
              13.5
            ],
            "nice": false
          }
        },
        "y": {
          "field": "row",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -0.5,
              9.5
            ],
            "nice": false
          }
        }
      }
    },
    {
      // Ordered filtering and calculations. These definitions now live here rather than in app.js.
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "squares"
            }
          ]
        }
      ],
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "rule",
        "stroke": "#b34e2d",
        "strokeWidth": 1.5
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "x": {
          "datum": 7.7,
          "type": "quantitative"
        },
        "x2": {
          "datum": 10.3
        },
        "y": {
          "datum": 0,
          "type": "quantitative"
        },
        "y2": {
          "datum": 1.3
        }
      }
    },
    {
      // Ordered filtering and calculations. These definitions now live here rather than in app.js.
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "squares"
            }
          ]
        }
      ],
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "text",
        "lineBreak": "\n",
        "fontSize": 12,
        "fontWeight": 700,
        "align": "left",
        "dx": 0,
        "color": "#a64629",
        "limit": {
          "expr": "small ? 170 : 0"
        }
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "x": {
          "datum": 10.6,
          "type": "quantitative"
        },
        "y": {
          "datum": 1.9,
          "type": "quantitative"
        },
        "text": {
          "value": "15 of 179\nrated trails\n8.4%"
        }
      }
    }
  ],
  // Small sizing metadata read by fitSize() in the HTML; it is not a data encoding.
  "usermeta": {
    "container": "#chart-10",
    "layout": "waffle",
    "gutter": 65
  },
  // Parameters that the short HTML controls update; expressions react to those changes.
  "params": [
    {
      "name": "small",
      "value": false
    },
    {
      "name": "compact",
      "value": false
    }
  ]
}
