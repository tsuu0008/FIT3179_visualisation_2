// Vega/Vega-Lite specification with versioned source-data URLs.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "data": {
    "url": "data/access_waffle.json?v=bf130fb4fa85"
  },
  "layer": [
    {
      "mark": {
        "type": "square",
        "size": {
          "expr": "pow(min(width/16,height/10)*0.82,2)"
        },
        "cornerRadius": 3,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "column",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -0.5,
              15
            ],
            "nice": false
          }
        },
        "y": {
          "field": "row",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -0.5,
              9.5
            ],
            "nice": false
          }
        },
        "color": {
          "field": "status",
          "type": "nominal",
          "scale": {
            "domain": [
              "Full or partial access",
              "No disabled access"
            ],
            "range": [
              "#D55E00",
              "#D9DEDF"
            ]
          },
          "title": "Recorded access",
          "legend": {
            "title": "Recorded access",
            "labelExpr": "datum.label === 'No disabled access' ? 'Rated as no access' : 'Full or partial access'",
            "labelLimit": 260,
            "symbolType": "circle",
            "symbolOpacity": 1,
            "symbolStrokeWidth": 0
          }
        },
        "tooltip": [
          {
            "field": "status",
            "title": "Each square = 1%"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.status === 'Full or partial access'"
        }
      ],
      "mark": {
        "type": "square",
        "size": {
          "expr": "pow(min(width/16,height/10)*0.82,2)"
        },
        "fillOpacity": 0,
        "stroke": "#9b4200",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "column",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -0.5,
              15
            ],
            "nice": false
          }
        },
        "y": {
          "field": "row",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -0.5,
              9.5
            ],
            "nice": false
          }
        }
      }
    },
