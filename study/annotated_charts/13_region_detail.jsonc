  "projection": {
    "type": "mercator",
    "center": {
      "expr": "[regionFrame[0],regionFrame[1]]"
    },
    "scale": {
      "expr": "min((width-28)/regionFrame[2],(height-186)/regionFrame[3])"
    },
    "translate": {
      "expr": "[width/2,170+(height-186)/2]"
    }
  },
  "layer": [
    {
      "name": "detailBase",
      "data": {
        "url": "data/lga.geojson?v=152086eeafcf",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#edf3ef",
        "stroke": "#cbd6d1",
        "strokeWidth": 0.4
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.name",
            "title": "Area"
          }
        ]
      },
      "transform": [
        {
          "filter": "chosenLga === 'All' || datum.properties.name === chosenLga"
        }
      ]
    },
    {
      "data": {
        "url": "data/lga_label_points.json?v=f4538861d1ab"
      },
      "transform": [
        {
          "filter": "chosenLga === 'All' ? datum.name === 'Victoria' : datum.name === chosenLga"
        },
        {
          "calculate": "(regionFrame[0])+((width*.62)-width/2)/(min((width-28)/regionFrame[2],(height-186)/regionFrame[3]))*180/PI",
          "as": "callout_lon"
        },
        {
          "calculate": "(2*atan(exp(log(tan(PI/4+(regionFrame[1])*PI/360))+((170+(height-186)/2)-155)/(min((width-28)/regionFrame[2],(height-186)/regionFrame[3]))))-PI/2)*180/PI",
          "as": "callout_lat"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#5d7269",
        "strokeWidth": 1.1,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "callout_lon"
        },
        "latitude2": {
          "field": "callout_lat"
        }
      }
    },
    {
      "data": {
        "url": "data/trail_labels.json?v=f0f34f5d9d08"
      },
      "transform": [
        {
          "filter": "chosenLga === 'All' || datum.lga === chosenLga"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "id",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/route_label_points.json?v=5097fd9f4489"
            },
            "key": "id",
            "fields": [
              "lon",
              "lat",
              "name_label"
            ]
          },
          "as": [
            "anchor_lon",
            "anchor_lat",
            "annotation_name"
          ]
        },
        {
          "calculate": "(regionFrame[0])+((width*.78)-width/2)/(min((width-28)/regionFrame[2],(height-186)/regionFrame[3]))*180/PI",
          "as": "callout_lon"
        },
        {
          "calculate": "(2*atan(exp(log(tan(PI/4+(regionFrame[1])*PI/360))+((170+(height-186)/2)-96)/(min((width-28)/regionFrame[2],(height-186)/regionFrame[3]))))-PI/2)*180/PI",
          "as": "callout_lat"
        },
        {
          "calculate": "datum.annotation_name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + datum.grade + '\\nLongest route in this area\\nShows the local upper distance commitment.'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#5d7269",
        "strokeWidth": 1.1,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "longitude": {
          "field": "anchor_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "anchor_lat",
          "type": "quantitative"
        },
        "longitude2": {
