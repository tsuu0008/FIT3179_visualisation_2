// STUDY COPY ONLY: the website loads the matching .json, not this .jsonc.
// A bound area dropdown filters boundaries and routes. The projection fits them automatically.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "#ffffff",
  // Vega-Lite creates these controls; no JavaScript event handler is needed.
  "params": [
    {
      "name": "chosenLga",
      "value": "Murrindindi",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "Alpine",
          "Ararat",
          "Baw Baw",
          "Benalla",
          "Cardinia",
          "Central Goldfields",
          "Colac Otway",
          "East Gippsland",
          "Gannawarra",
          "Glenelg",
          "Golden Plains",
          "Greater Bendigo",
          "Hindmarsh",
          "Horsham",
          "Indigo",
          "Latrobe (Vic.)",
          "Loddon",
          "Macedon Ranges",
          "Mansfield",
          "Mildura",
          "Mitchell",
          "Moorabool",
          "Mount Alexander",
          "Murrindindi",
          "Northern Grampians",
          "Pyrenees",
          "Towong",
          "Unincorporated Vic",
          "Wellington",
          "Whittlesea",
          "Yarra Ranges"
        ],
        "name": "Area: ",
        "labels": [
          "All Victoria",
          "Alpine",
          "Ararat",
          "Baw Baw",
          "Benalla",
          "Cardinia",
          "Central Goldfields",
          "Colac Otway",
          "East Gippsland",
          "Gannawarra",
          "Glenelg",
          "Golden Plains",
          "Greater Bendigo",
          "Hindmarsh",
          "Horsham",
          "Indigo",
          "Latrobe (Vic.)",
          "Loddon",
          "Macedon Ranges",
          "Mansfield",
          "Mildura",
          "Mitchell",
          "Moorabool",
          "Mount Alexander",
          "Murrindindi",
          "Northern Grampians",
          "Pyrenees",
          "Towong",
          "Unincorporated Vic",
          "Wellington",
          "Whittlesea",
          "Yarra Ranges"
        ]
      }
    }
  ],
  "projection": {"type": "mercator"},
  // Draw these layers in order, from background to foreground.
  "layer": [
    {
      "name": "detailBase",
      // Input records or prepared plotting values.
  "data": {"url": "data/lga.geojson", "format": {"type": "json", "property": "features"}},
      "mark": {"type": "geoshape", "fill": "#edf3ef", "stroke": "#b4c4bc", "strokeWidth": 0.6},
      "encoding": {"tooltip": [{"field": "properties.name", "title": "Area"}]},
      // Filter, group or calculate before drawing.
  "transform": [{"filter": "chosenLga === 'All' || datum.properties.name === chosenLga"}]
    },
    {
      "data": {"url": "data/trails.geojson", "format": {"type": "json", "property": "features"}},
      "transform": [{"filter": "chosenLga === 'All' || datum.properties.lga === chosenLga"}],
      "mark": {"type": "geoshape", "filled": false, "strokeWidth": 2.5},
      "encoding": {
        "color": {
          "field": "properties.grade",
          "type": "nominal",
          "scale": {
            "domain": ["Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5", "Unknown"],
            "range": ["#2a9d8f", "#69b578", "#e9c46a", "#f4a261", "#e76f51", "#9aa2a6"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "properties.name", "title": "Trail"},
          {"field": "properties.length_km", "title": "Distance (km)"},
          {"field": "properties.grade", "title": "Grade"}
        ]
      }
    },
    {
      "name": "detailRegion",
      "data": {"url": "data/map_regions.json"},
      "transform": [
        {
          "filter": "chosenLga === 'All' ? datum.properties.name === 'Victoria' : datum.properties.name === chosenLga"
        }
      ],
      "mark": {"type": "geoshape", "fill": null, "stroke": "#d95d39", "strokeWidth": 2},
      "encoding": {"tooltip": [{"field": "properties.name", "title": "Selected area"}]}
    },
    {
      "data": {"url": "data/trail_labels.json"},
      "transform": [
        {"filter": "chosenLga === 'All' || datum.lga === chosenLga"},
        {
          "window": [{"op": "row_number", "as": "rank"}],
          "sort": [{"field": "length_km", "order": "descending"}, {"field": "name", "order": "ascending"}]
        },
        {"filter": "datum.rank === 1"},
        {"calculate": "datum.short_name + '\\n' + format(datum.length_km, '.1f') + ' km'", "as": "label"}
      ],
      "mark": {"type": "point", "filled": false, "size": 150, "stroke": "#a64629", "strokeWidth": 2},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"}
      }
    },
    {
      "data": {"url": "data/trail_labels.json"},
      "transform": [
        {"filter": "chosenLga === 'All' || datum.lga === chosenLga"},
        {
          "window": [{"op": "row_number", "as": "rank"}],
          "sort": [{"field": "length_km", "order": "descending"}, {"field": "name", "order": "ascending"}]
        },
        {"filter": "datum.rank === 1"},
        {"calculate": "datum.short_name + '\\n' + format(datum.length_km, '.1f') + ' km'", "as": "label"}
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "fontWeight": 700,
        "lineBreak": "\n",
        "color": "#173b37",
        "stroke": "white",
        "strokeWidth": 3,
        "limit": 220
      },
      "encoding": {"x": {"value": 8}, "y": {"value": 10}, "text": {"field": "label"}}
    },
    {
      "data": {"url": "data/trail_labels.json"},
      "transform": [
        {"filter": "chosenLga === 'All' || datum.lga === chosenLga"},
        {
          "window": [{"op": "row_number", "as": "rank"}],
          "sort": [{"field": "length_km", "order": "descending"}, {"field": "name", "order": "ascending"}]
        },
        {"filter": "datum.rank === 1"},
        {"calculate": "datum.short_name + '\\n' + format(datum.length_km, '.1f') + ' km'", "as": "label"}
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "fontWeight": 700,
        "lineBreak": "\n",
        "color": "#173b37",
        "limit": 220
      },
      "encoding": {"x": {"value": 8}, "y": {"value": 10}, "text": {"field": "label"}}
    }
  ],
  // Shared styling for this chart.
  "config": {"view": {"stroke": null}, "text": {"font": "Inter"}, "legend": {"columns": 2, "labelLimit": 150}},
  "padding": 0
}
