        {
          "calculate": "(2*atan(exp(log(tan(PI/4+regionFrame[1]*PI/360))+((170+(height-186)/2)-150)/(min((width-28)/regionFrame[2],(height-186)/regionFrame[3]))))-PI/2)*180/PI",
          "as": "min_label_lat"
