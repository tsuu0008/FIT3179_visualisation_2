// Study copy of charts/13_region_detail.json. The website loads strict JSON, not this file.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 404,
  "height": 250,
  "padding": 0,
  "background": "#ffffff",
  // Shared font, axis and legend settings.
  "config": {
    "view": {
      "stroke": null
    },
    "text": {
      "font": "Inter"
    }
  },
  // Parameters that the short HTML controls update; expressions react to those changes.
  "params": [
    {
      "name": "chosenLga",
      "value": "All"
    },
    {
      "name": "chosenGrade",
      "value": "All"
    },
    {
      "name": "visibleCount",
      "value": 194
    },
    {
      "name": "small",
      "value": false
    },
    {
      "name": "compact",
      "value": false
    },
    {
      "name": "zoom",
      "value": 1
    },
    {
      "name": "mapBounds",
      "expr": "data('mapBoundsData')[0]"
    },
    {
      "name": "mapCenter",
      "expr": "mapBounds ? mapBounds[chosenLga].center : [145,-37]"
    },
    {
      "name": "mapScale",
      "expr": "mapBounds ? min((width-28)/mapBounds[chosenLga].dx,(height-28)/mapBounds[chosenLga].dy)*zoom : 1"
    }
  ],
  // Reactive geographic centre, scale, translation and clipping.
  "projection": {
    "type": "mercator",
    "center": {
      "expr": "mapCenter"
    },
    "scale": {
      "expr": "mapScale"
    },
    "translate": {
      "expr": "[width/2,height/2]"
    },
    "clipExtent": {
      "expr": "[[0,0],[width,height]]"
    }
  },
  // Layers draw in order: context, data, emphasis and annotations.
  "layer": [
    {
      // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
      "data": {
        "name": "mapBoundsData",
        "url": "data/map_bounds.json"
      },
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "point",
        "opacity": 0,
        "size": 0
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 0
        }
      }
    },
    {
      "name": "detailBase",
      // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
      "data": {
        "url": "data/lga.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "geoshape",
        "fill": "#edf3ef",
        "stroke": "#b4c4bc",
        "strokeWidth": 0.6
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        },
        "tooltip": [
          {
            "field": "properties.name",
            "title": "Area"
          }
        ]
      }
    },
    {
      // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
      "data": {
        "url": "data/trails.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      // Ordered filtering and calculations. These definitions now live here rather than in app.js.
      "transform": [
        {
          "filter": "(chosenLga === 'All' || datum.properties.lga === chosenLga) && (chosenGrade === 'All' || datum.properties.grade === chosenGrade)"
        }
      ],
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeWidth": 2.5
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        },
        "color": {
          "field": "properties.grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ],
            "range": [
              "#2a9d8f",
              "#69b578",
              "#e9c46a",
              "#f4a261",
              "#e76f51",
              "#9aa2a6"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "properties.name",
            "title": "Trail"
          },
          {
            "field": "properties.length_km",
            "title": "Distance (km)"
          },
          {
            "field": "properties.grade",
            "title": "Grade"
          }
        ]
      }
    },
    {
      "name": "detailRegion",
      // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
      "data": {
        "url": "data/map_regions.json"
      },
      // Ordered filtering and calculations. These definitions now live here rather than in app.js.
      "transform": [
        {
          "filter": "chosenLga === 'All' ? datum.properties.name === 'Victoria' : datum.properties.name === chosenLga"
        }
      ],
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#d95d39",
        "strokeWidth": 2
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        },
        "tooltip": [
          {
            "field": "properties.name",
            "title": "Selected area"
          }
        ]
      }
    },
    {
      // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
      "data": {
        "url": "data/trail_labels.json"
      },
      // Ordered filtering and calculations. These definitions now live here rather than in app.js.
      "transform": [
        {
          "filter": "(chosenLga === 'All' || datum.lga === chosenLga) && (chosenGrade === 'All' || datum.grade === chosenGrade)"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "name",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "calculate": "datum.short_name + '\\n' + format(datum.length_km, '.1f') + ' km'",
          "as": "label"
        },
        {
          "calculate": "width/2 + mapScale * (datum.longitude-mapCenter[0]) * 0.0174532925199433",
          "as": "pointX"
        },
        {
          "calculate": "height/2 - mapScale*(log(tan(0.7853981633974483+datum.latitude*0.008726646259971648))-log(tan(0.7853981633974483+mapCenter[1]*0.008726646259971648)))",
          "as": "pointY"
        },
        {
          "filter": "datum.pointX > 8 && datum.pointX < width-8 && datum.pointY > 8 && datum.pointY < height-8"
        },
        {
          "calculate": "datum.pointX > width/2 ? clamp(datum.pointX-10,155,width-8) : clamp(datum.pointX+10,8,width-155)",
          "as": "labelX"
        },
        {
          "calculate": "clamp(datum.pointY-16,30,height-30)",
          "as": "labelY"
        }
      ],
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "point",
        "filled": false,
        "size": 150,
        "stroke": "#a64629",
        "strokeWidth": 2
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        }
      }
    },
    {
      // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
      "data": {
        "url": "data/trail_labels.json"
      },
      // Ordered filtering and calculations. These definitions now live here rather than in app.js.
      "transform": [
        {
          "filter": "(chosenLga === 'All' || datum.lga === chosenLga) && (chosenGrade === 'All' || datum.grade === chosenGrade)"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "name",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "calculate": "datum.short_name + '\\n' + format(datum.length_km, '.1f') + ' km'",
          "as": "label"
        },
        {
          "calculate": "width/2 + mapScale * (datum.longitude-mapCenter[0]) * 0.0174532925199433",
          "as": "pointX"
        },
        {
          "calculate": "height/2 - mapScale*(log(tan(0.7853981633974483+datum.latitude*0.008726646259971648))-log(tan(0.7853981633974483+mapCenter[1]*0.008726646259971648)))",
          "as": "pointY"
        },
        {
          "filter": "datum.pointX > 8 && datum.pointX < width-8 && datum.pointY > 8 && datum.pointY < height-8"
        },
        {
          "calculate": "datum.pointX > width/2 ? clamp(datum.pointX-10,155,width-8) : clamp(datum.pointX+10,8,width-155)",
          "as": "labelX"
        },
        {
          "calculate": "clamp(datum.pointY-16,30,height-30)",
          "as": "labelY"
        }
      ],
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "text",
        "align": {
          "expr": "datum.longitude > mapCenter[0] ? 'right' : 'left'"
        },
        "dx": 0,
        "dy": 0,
        "fontSize": 11,
        "fontWeight": 700,
        "lineBreak": "\n",
        "limit": {
          "expr": "small ? 170 : 150"
        },
        "color": "#173b37",
        "stroke": "white",
        "strokeWidth": 3
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "x": {
          "field": "labelX",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "y": {
          "field": "labelY",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "text": {
          "field": "label"
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Longest matching trail"
          },
          {
            "field": "length_km",
            "title": "Distance (km)"
          }
        ]
      }
    },
    {
      // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
      "data": {
        "url": "data/trail_labels.json"
      },
      // Ordered filtering and calculations. These definitions now live here rather than in app.js.
      "transform": [
        {
          "filter": "(chosenLga === 'All' || datum.lga === chosenLga) && (chosenGrade === 'All' || datum.grade === chosenGrade)"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "name",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "calculate": "datum.short_name + '\\n' + format(datum.length_km, '.1f') + ' km'",
          "as": "label"
        },
        {
          "calculate": "width/2 + mapScale * (datum.longitude-mapCenter[0]) * 0.0174532925199433",
          "as": "pointX"
        },
        {
          "calculate": "height/2 - mapScale*(log(tan(0.7853981633974483+datum.latitude*0.008726646259971648))-log(tan(0.7853981633974483+mapCenter[1]*0.008726646259971648)))",
          "as": "pointY"
        },
        {
          "filter": "datum.pointX > 8 && datum.pointX < width-8 && datum.pointY > 8 && datum.pointY < height-8"
        },
        {
          "calculate": "datum.pointX > width/2 ? clamp(datum.pointX-10,155,width-8) : clamp(datum.pointX+10,8,width-155)",
          "as": "labelX"
        },
        {
          "calculate": "clamp(datum.pointY-16,30,height-30)",
          "as": "labelY"
        }
      ],
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "text",
        "align": {
          "expr": "datum.longitude > mapCenter[0] ? 'right' : 'left'"
        },
        "dx": 0,
        "dy": 0,
        "fontSize": 11,
        "fontWeight": 700,
        "lineBreak": "\n",
        "limit": {
          "expr": "small ? 170 : 150"
        },
        "color": "#173b37"
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "x": {
          "field": "labelX",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "y": {
          "field": "labelY",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "text": {
          "field": "label"
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Longest matching trail"
          },
          {
            "field": "length_km",
            "title": "Distance (km)"
          }
        ]
      }
    },
    {
      // Input records, geometry or prepared table. The page loader reads the same path from the generated preview package.
      "data": {
        "values": [
          {}
        ]
      },
      // Ordered filtering and calculations. These definitions now live here rather than in app.js.
      "transform": [
        {
          "filter": "visibleCount === 0"
        }
      ],
      // The graphical object to draw. A zero-size point is used only to load map-fit constants.
      "mark": {
        "type": "text",
        "lineBreak": "\n",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#173b37",
        "stroke": "white",
        "strokeWidth": 0.4,
        "limit": {
          "expr": "small ? 170 : 0"
        }
      },
      // Connect a field to position, colour, area, text or geographic shape.
      "encoding": {
        "x": {
          "value": {
            "expr": "width/2"
          }
        },
        "y": {
          "value": {
            "expr": "height/2"
          }
        },
        "text": {
          "value": "No recorded trails\nin this selection"
        }
      }
    }
  ],
  // Small sizing metadata read by fitSize() in the HTML; it is not a data encoding.
  "usermeta": {
    "container": "#detail-map",
    "layout": "detail",
    "gutter": 65
  }
}
