    }
  ],
  "projection": {
    "type": "mercator",
    "center": {
      "expr": "[regionFrame[0],regionFrame[1]]"
    },
    "scale": {
      "expr": "min((width-28)/regionFrame[2],(height-134)/regionFrame[3])"
    },
    "translate": {
      "expr": "[width/2,118+(height-134)/2]"
    }
  },
  "layer": [
    {
      "name": "detailBase",
      "data": {
        "url": "data/lga.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#edf3ef",
        "stroke": "#cbd6d1",
        "strokeWidth": 0.4
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.name",
            "title": "Area"
          }
        ]
      },
      "transform": [
        {
          "filter": "chosenLga === 'All' || datum.properties.name === chosenLga"
        }
      ]
    },
    {
      "data": {
        "url": "data/lga_label_points.json"
      },
      "transform": [
        {
          "filter": "chosenLga === 'All' ? datum.name === 'Victoria' : datum.name === chosenLga"
        },
        {
          "calculate": "(regionFrame[0])+((width*.22)-width/2)/(min((width-28)/regionFrame[2],(height-134)/regionFrame[3]))*180/PI",
          "as": "callout_lon"
        },
        {
          "calculate": "(2*atan(exp(log(tan(PI/4+(regionFrame[1])*PI/360))+((118+(height-134)/2)-96)/(min((width-28)/regionFrame[2],(height-134)/regionFrame[3]))))-PI/2)*180/PI",
          "as": "callout_lat"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#5d7269",
        "strokeWidth": 1.1,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "callout_lon"
        },
        "latitude2": {
          "field": "callout_lat"
        }
      }
    },
    {
      "data": {
        "url": "data/trail_labels.json"
      },
      "transform": [
        {
          "filter": "chosenLga === 'All' || datum.lga === chosenLga"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "id",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/route_label_points.json"
            },
            "key": "id",
            "fields": [
              "lon",
              "lat",
              "name_label"
            ]
          },
          "as": [
            "anchor_lon",
            "anchor_lat",
            "annotation_name"
          ]
        },
        {
          "calculate": "(regionFrame[0])+((width*.78)-width/2)/(min((width-28)/regionFrame[2],(height-134)/regionFrame[3]))*180/PI",
          "as": "callout_lon"
        },
        {
          "calculate": "(2*atan(exp(log(tan(PI/4+(regionFrame[1])*PI/360))+((118+(height-134)/2)-96)/(min((width-28)/regionFrame[2],(height-134)/regionFrame[3]))))-PI/2)*180/PI",
          "as": "callout_lat"
        },
        {
          "calculate": "datum.annotation_name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + datum.grade + '\\nLongest route in this area'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#5d7269",
        "strokeWidth": 1.1,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "longitude": {
          "field": "anchor_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "anchor_lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "callout_lon"
        },
        "latitude2": {
          "field": "callout_lat"
        }
      }
    },
    {
      "name": "detailRegion",
      "data": {
        "url": "data/lga.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "chosenLga !== 'All' && datum.properties.name === chosenLga"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#cbd6d1",
        "strokeWidth": 0.4
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.name",
            "title": "Selected area"
          }
        ]
      }
    },
    {
      "name": "detailVictoria",
      "data": {
        "url": "data/victoria_outline.geojson",
        "format": {
          "type": "json"
        }
      },
      "transform": [
        {
          "filter": "chosenLga === 'All'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#cbd6d1",
        "strokeWidth": 0.4
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.name",
            "title": "Selected area"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/trails.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "chosenLga === 'All' || datum.properties.lga === chosenLga"
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeWidth": 2.5
      },
      "encoding": {
        "color": {
          "field": "properties.grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#CC79A7",
              "#252525",
              "#9B9B9B"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "properties.name",
            "title": "Trail"
          },
          {
            "field": "properties.length_km",
            "title": "Distance (km)"
          },
          {
            "field": "properties.grade",
            "title": "Grade"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/lga_label_points.json"
      },
      "transform": [
        {
          "filter": "chosenLga === 'All' ? datum.name === 'Victoria' : datum.name === chosenLga"
        }
      ],
      "mark": {
        "type": "point",
        "filled": false,
        "size": 210,
        "stroke": "#5d7269",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "url": "data/trail_labels.json"
      },
      "transform": [
        {
          "filter": "chosenLga === 'All' || datum.lga === chosenLga"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "id",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/route_label_points.json"
            },
            "key": "id",
            "fields": [
              "lon",
              "lat",
              "name_label"
            ]
          },
          "as": [
            "anchor_lon",
            "anchor_lat",
            "annotation_name"
          ]
        },
        {
          "calculate": "datum.annotation_name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + datum.grade + '\\nLongest route in this area'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "point",
        "filled": false,
        "size": 210,
        "stroke": "#5d7269",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "anchor_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "anchor_lat",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "chosenLga === 'All' || datum.lga === chosenLga"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            },
            {
              "op": "sum",
              "field": "length_km",
              "as": "km"
            }
          ]
        },
        {
          "calculate": "(chosenLga === 'All' ? 'Victoria' : chosenLga + ' LGA') + '\\n' + datum.n + ' recorded trails · ' + format(datum.km,'.1f') + ' km\\nArea anchor · not a trail'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 15,
        "color": "#20343A",
        "align": "left",
        "baseline": "top"
      },
      "encoding": {
        "x": {
          "value": 12
        },
        "y": {
          "value": 12
        },
        "text": {
          "field": "annotation"
        }
      }
    },
    {
      "data": {
        "url": "data/trail_labels.json"
      },
      "transform": [
        {
          "filter": "chosenLga === 'All' || datum.lga === chosenLga"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "id",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/route_label_points.json"
            },
            "key": "id",
            "fields": [
              "lon",
              "lat",
              "name_label"
            ]
          },
          "as": [
            "anchor_lon",
            "anchor_lat",
            "annotation_name"
          ]
        },
        {
          "calculate": "datum.annotation_name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + datum.grade + '\\nLongest route in this area'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 15,
        "color": "#20343A",
        "align": "right",
        "baseline": "top"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width-12"
          }
        },
        "y": {
          "value": 12
        },
        "text": {
          "field": "annotation"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "text": {
      "font": "Inter",
      "fontSize": 11,
      "color": "#20343A"
    },
    "legend": {
      "columns": 2,
      "labelLimit": 150
    }
  },
  "padding": 0,
  "description": "Unboxed callout text is reserved above the map. Light council boundaries sit behind trail marks. Regional pointers use interior LGA anchors; route pointers meet the displayed trail geometry or symbol.",
  "resolve": {
    "legend": {
      "color": "independent"
    }
  }
}
