// Vega/Vega-Lite specification with versioned source-data URLs.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 520,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "data": {
    "url": "data/lga.geojson?v=c1c375501f56",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "params": [
    {
      "name": "metric",
      "value": "resident",
      "bind": {
        "input": "select",
        "options": [
          "resident",
          "total"
        ],
        "name": "Colour by: ",
        "labels": [
          "Km per 100,000 residents",
          "Total recorded km"
        ]
      }
    },
    {
      "name": "mapFrame",
      "expr": "[145.46902564999868,-36.61327398827786,0.15732980049501755,0.11261417469557167]"
    }
  ],
  "projection": {
    "type": "mercator",
    "center": {
      "expr": "[mapFrame[0],mapFrame[1]]"
    },
    "scale": {
      "expr": "min((width-28)/mapFrame[2],(height-70)/mapFrame[3])"
    },
    "translate": {
      "expr": "[width/2,(height-70)/2]"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "#f8fafc",
        "strokeWidth": 0.7
      },
      "encoding": {
        "color": {
          "field": "supplyValue",
          "type": "quantitative",
          "scale": {
            "scheme": "tealblues",
            "type": "sqrt",
            "domain": [
              0,
              {
                "expr": "metric === 'resident' ? 850 : 150"
              }
            ]
          },
          "title": {
            "expr": "metric === 'resident' ? 'Km per 100,000 residents' : 'Total recorded kilometres'"
          },
          "legend": {
            "orient": "none",
            "legendX": {
              "expr": "width-232"
            },
            "legendY": {
              "expr": "height-35"
            },
            "gradientLength": 220,
            "gradientThickness": 12,
            "title": null,
            "titleFontSize": 11,
            "titlePadding": 6,
            "labelFontSize": 10,
            "padding": 0,
            "offset": 0
          }
        },
        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "LGA"
          },
          {
            "field": "properties.trail_count",
            "type": "quantitative",
            "title": "Trails"
          },
          {
            "field": "properties.trail_km",
            "type": "quantitative",
            "title": "Recorded km",
            "format": ".1f"
          },
          {
            "field": "properties.population",
            "type": "quantitative",
            "title": "Population (2025)",
            "format": ","
          },
          {
            "field": "properties.trail_km_per_100k",
            "type": "quantitative",
            "title": "Km per 100k",
            "format": ".1f"
          }
        ]
      },
      "transform": [
        {
          "calculate": "metric === 'resident' ? datum.properties.trail_km_per_100k : datum.properties.trail_km",
          "as": "supplyValue"
        }
      ]
    },
    {
      "data": {
        "url": "data/lga.geojson?v=c1c375501f56",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name === 'Murrindindi' || datum.properties.name === 'Yarra Ranges'"
