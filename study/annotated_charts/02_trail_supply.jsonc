            ]
          }
        },
        {
          "calculate": "metric === 'resident' ? 'Murrindindi · 844.2 km / 100k\\nHighest supply per resident' : 'Murrindindi · 132.1 km\\n32 trails form a regional cluster'",
          "as": "annotation"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 14,
        "align": "left",
        "baseline": "middle",
        "color": "#20343A",
        "dy": -18
      },
      "encoding": {
        "longitude": {
          "datum": 143.7,
