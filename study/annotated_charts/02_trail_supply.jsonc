          "calculate": "metric === 'resident' ? 'Baw Baw · 233.3 km / 100k\\nPopulation changes the comparison' : 'Baw Baw · 146.5 km\\nLargest total recorded distance'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#20343A",
        "strokeWidth": 1.1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
