          "as": "annotation"
        }
      ]
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "transform": [
        {
          "calculate": "metric === 'resident' ? 'HOW TO READ THE RATIO\\nRecorded km ÷ residents × 100,000\\nHigh values can reflect a small population.' : 'HOW TO READ TOTAL DISTANCE\\nAdd the recorded lengths of local trails.\\nThis measure does not adjust for population.'",
          "as": "note"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "font": "Inter",
        "fontSize": 11,
        "lineBreak": "\n",
        "lineHeight": 15,
        "fontWeight": 500,
        "color": "#20343A",
        "stroke": "white",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width*0.48"
          }
        },
        "y": {
          "value": 8
        },
        "text": {
          "field": "note"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "transform": [
        {
          "calculate": "metric === 'resident' ? 'HOW TO READ THE RATIO\\nRecorded km ÷ residents × 100,000\\nHigh values can reflect a small population.' : 'HOW TO READ TOTAL DISTANCE\\nAdd the recorded lengths of local trails.\\nThis measure does not adjust for population.'",
