// Current displayed specification; see DATA_AND_CAVEATS.md for methods.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 520,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "data": {
    "url": "data/lga.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "params": [
    {
      "name": "metric",
      "value": "resident",
      "bind": {
        "input": "select",
        "options": [
          "resident",
          "total"
        ],
        "name": "Colour by: ",
        "labels": [
          "Km per 100,000 residents",
          "Total recorded km"
        ]
      }
    },
    {
      "name": "mapFrame",
      "expr": "[145.46965331000007,-36.613358521639626,0.15730806974957048,0.11261841622677582]"
    }
  ],
  "projection": {
    "type": "mercator",
    "center": {
      "expr": "[mapFrame[0],mapFrame[1]]"
    },
    "scale": {
      "expr": "min((width-28)/mapFrame[2],(height-70)/mapFrame[3])"
    },
    "translate": {
      "expr": "[width/2,(height-70)/2]"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "#f8fafc",
        "strokeWidth": 0.7
      },
      "encoding": {
        "color": {
          "field": "supplyValue",
          "type": "quantitative",
          "scale": {
            "scheme": "tealblues",
            "type": "sqrt",
            "domain": [
              0,
              {
                "expr": "metric === 'resident' ? 850 : 150"
              }
            ]
          },
          "title": {
            "expr": "metric === 'resident' ? 'Km per 100,000 residents' : 'Total recorded kilometres'"
          },
          "legend": {
            "orient": "none",
            "legendX": {
              "expr": "width-232"
            },
            "legendY": {
              "expr": "height-35"
            },
            "gradientLength": 220,
            "gradientThickness": 12,
            "title": null,
            "titleFontSize": 11,
            "titlePadding": 6,
            "labelFontSize": 10,
            "padding": 0,
            "offset": 0
          }
        },
        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "LGA"
          },
          {
            "field": "properties.trail_count",
            "type": "quantitative",
            "title": "Trails"
          },
          {
            "field": "properties.trail_km",
            "type": "quantitative",
            "title": "Recorded km",
            "format": ".1f"
          },
          {
            "field": "properties.population",
            "type": "quantitative",
            "title": "Population (2025)",
            "format": ","
          },
          {
            "field": "properties.trail_km_per_100k",
            "type": "quantitative",
            "title": "Km per 100k",
            "format": ".1f"
          }
        ]
      },
      "transform": [
        {
          "calculate": "metric === 'resident' ? datum.properties.trail_km_per_100k : datum.properties.trail_km",
          "as": "supplyValue"
        }
      ]
    },
    {
      "data": {
        "url": "data/lga.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name === 'Murrindindi' || datum.properties.name === 'Baw Baw'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#20343A",
        "strokeWidth": 1.3
      }
    },
    {
      "data": {
        "values": [
          {
            "region_name": "Murrindindi"
          }
        ]
      },
      "transform": [
        {
          "lookup": "region_name",
          "from": {
            "data": {
              "url": "data/lga_label_points.json"
            },
            "key": "name",
            "fields": [
              "lon",
              "lat"
            ]
          }
        },
        {
          "calculate": "metric === 'resident' ? 'Murrindindi · 844.2 km / 100k\\nHighest supply per resident' : 'Murrindindi · 132.1 km\\n32 trails form a regional cluster'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#20343A",
        "strokeWidth": 1.1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "datum": 143.7
        },
        "latitude2": {
          "datum": -35.1
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "region_name": "Murrindindi"
          }
        ]
      },
      "transform": [
        {
          "lookup": "region_name",
          "from": {
            "data": {
              "url": "data/lga_label_points.json"
            },
            "key": "name",
            "fields": [
              "lon",
              "lat"
            ]
          }
        },
        {
          "calculate": "metric === 'resident' ? 'Murrindindi · 844.2 km / 100k\\nHighest supply per resident' : 'Murrindindi · 132.1 km\\n32 trails form a regional cluster'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "point",
        "filled": false,
        "stroke": "#20343A",
        "size": 130,
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 14,
        "align": "left",
        "baseline": "middle",
        "color": "#20343A",
        "dy": -18,
        "stroke": "white",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "longitude": {
          "datum": 143.7,
          "type": "quantitative"
        },
        "latitude": {
          "datum": -35.1,
          "type": "quantitative"
        },
        "text": {
          "field": "annotation"
        }
      },
      "data": {
        "values": [
          {
            "region_name": "Murrindindi"
          }
        ]
      },
      "transform": [
        {
          "lookup": "region_name",
