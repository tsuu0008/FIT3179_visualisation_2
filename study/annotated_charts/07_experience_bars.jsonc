// Vega/Vega-Lite specification with versioned source-data URLs.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 600,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "data": {
    "url": "data/trails.json?v=d0f82fb8345d"
  },
  "transform": [
    {
      "filter": "datum.gradient !== 'Unknown' && datum.experience !== 'Unknown'"
    },
    {
      "calculate": "datum.experience === 'No experience required' ? 'None required' : datum.experience === 'Bushwalking experience recommended' ? 'Recommended' : datum.experience === 'Experienced bushwalkers' ? 'Experienced' : 'Very experienced'",
      "as": "experience_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 2
      },
      "encoding": {
        "y": {
          "field": "gradient",
          "type": "nominal",
          "sort": [
            "Flat",
            "Gentle hills",
            "Short steep hills",
            "Very steep",
            "Very steep and difficult"
          ],
          "title": null,
          "axis": {
            "labelLimit": 130,
            "labelExpr": "datum.label === 'Very steep and difficult' ? 'Steep + difficult' : datum.label"
          }
        },
        "x": {
          "aggregate": "count",
          "type": "quantitative",
          "stack": "zero",
          "title": "Number of trails",
          "scale": {
            "domain": [
              0,
              100
            ],
            "nice": false
          }
        },
        "color": {
          "field": "experience_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "None required",
              "Recommended",
              "Experienced",
              "Very experienced"
            ],
            "range": [
              "#9bd8ca",
              "#44a693",
              "#176b61",
              "#0b3f3a"
            ]
          },
          "title": "Experience"
        },
        "order": {
          "field": "experience_label",
          "sort": "ascending"
        },
        "tooltip": [
          {
            "field": "gradient",
            "title": "Terrain"
          },
          {
            "field": "experience",
            "title": "Experience"
          },
          {
            "aggregate": "count",
            "title": "Trails"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "gradient",
            "experience_label"
          ]
        },
        {
          "stack": "n",
          "groupby": [
            "gradient"
          ],
          "sort": [
            {
              "field": "experience_label",
              "order": "ascending"
            }
          ],
          "as": [
            "start",
            "end"
          ]
        },
        {
          "calculate": "(datum.start + datum.end) / 2",
          "as": "mid"
        },
        {
          "filter": "datum.n >= 6"
        },
        {
          "calculate": "datum.gradient === 'Short steep hills' && datum.experience_label === 'Recommended' ? datum.n + ' trails\\nExperience advised' : datum.gradient === 'Gentle hills' && datum.experience_label === 'None required' ? datum.n + ' trails\\nNo experience needed' : format(datum.n,'d')",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 700,
        "lineBreak": "\n",
        "lineHeight": 15
      },
      "encoding": {
        "x": {
          "field": "mid",
          "type": "quantitative"
        },
        "y": {
          "field": "gradient",
          "type": "nominal",
          "sort": [
            "Flat",
            "Gentle hills",
            "Short steep hills",
            "Very steep",
            "Very steep and difficult"
          ],
          "title": null,
          "axis": {
            "labelLimit": 130,
            "labelExpr": "datum.label === 'Very steep and difficult' ? 'Steep + difficult' : datum.label"
          }
        },
        "text": {
          "field": "annotation"
        },
        "color": {
          "condition": {
            "test": "datum.experience_label === 'None required'",
            "value": "#173b37"
          },
          "value": "white"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "trail_count"
            }
          ],
          "groupby": [
            "gradient"
          ]
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#173b37",
        "limit": 170
      },
      "encoding": {
        "y": {
          "field": "gradient",
          "type": "nominal",
          "sort": [
            "Flat",
            "Gentle hills",
            "Short steep hills",
            "Very steep",
            "Very steep and difficult"
          ]
        },
        "x": {
          "field": "trail_count",
          "type": "quantitative"
        },
        "text": {
          "field": "trail_count"
        }
      }
    },
    {
      "name": "insight_bar_outline",
      "data": {
        "values": [
          {
            "gradient": "Short steep hills",
            "n": 83
          }
        ]
      },
      "mark": {
        "type": "bar",
        "filled": false,
        "stroke": "#b94e13",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "n",
          "type": "quantitative"
        },
        "x2": {
          "datum": 0
        },
        "y": {
          "field": "gradient",
          "type": "nominal",
          "sort": [
            "Flat",
            "Gentle hills",
            "Short steep hills",
            "Very steep",
            "Very steep and difficult"
          ],
          "title": null,
          "axis": {
            "labelLimit": 130,
            "labelExpr": "datum.label === 'Very steep and difficult' ? 'Steep + difficult' : datum.label"
          }
        }
      }
    },
    {
      "name": "insight_explanation",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 600,
        "lineHeight": 15,
        "lineBreak": "\n",
        "color": "#24443f"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "max(0,width-260)"
          }
        },
        "y": {
          "value": -77
        },
        "text": {
          "value": "Short steep hills: 83 routes (largest group).\n53 advise experience:\n48 recommended + 5 experienced.\nPreparation matters even on a short walk."
        }
      }
    },
    {
      "name": "review_experience_leader",
      "data": {
        "values": [
          {
            "gradient": "Short steep hills",
            "n": 83
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#b94e13",
        "strokeWidth": 1.3,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "n",
          "type": "quantitative"
        },
        "y": {
          "field": "gradient",
          "type": "nominal",
          "sort": [
            "Flat",
            "Gentle hills",
            "Short steep hills",
            "Very steep",
            "Very steep and difficult"
          ],
          "title": null,
          "axis": {
            "labelLimit": 130,
            "labelExpr": "datum.label === 'Very steep and difficult' ? 'Steep + difficult' : datum.label"
          }
        },
        "x2": {
          "value": {
            "expr": "width-90"
          }
        },
        "y2": {
          "value": -8
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6,
      "tickCount": 7
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "orient": "bottom",
      "columns": 2,
      "titleFontSize": 13,
      "padding": 8,
      "labelLimit": 200,
      "direction": "horizontal",
      "symbolType": "circle",
      "symbolStrokeWidth": 0,
      "symbolOpacity": 1
    },
    "text": {
      "font": "Inter",
      "fontSize": 11,
      "color": "#20343A"
    }
  },
  "padding": {
    "top": 8,
    "left": 5,
    "right": 18,
    "bottom": 5
  },
  "description": "Direct labels and explanatory callouts are part of the plotting area. Grade colours are consistent across charts.",
  "usermeta": {
    "annotation_design": "On-chart highlighted finding with a reason for its significance; filtered findings follow the selected cohort."
  }
}
