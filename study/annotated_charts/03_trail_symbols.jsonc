        {
          "calculate": "datum.lga + ' LGA\\n' + datum.n + (datum.n === 1 ? ' matching trail' : ' matching trails') + '\\nLargest regional cluster\\nCount covers this whole LGA'",
          "as": "annotation"
        },
        {
          "lookup": "lga",
          "from": {
            "data": {
              "url": "data/lga_label_points.json"
            },
            "key": "name",
            "fields": [
              "lon",
              "lat"
            ]
          }
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 13,
        "color": "#20343A",
        "align": "left",
        "baseline": "top"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width-252"
          }
        },
        "y": {
          "value": {
            "expr": "height-132"
          }
        },
        "text": {
          "field": "annotation"
        }
      }
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "calculate": "((chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')) ? 1 : 0",
          "as": "match"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "match",
              "as": "total"
            }
          ]
        },
        {
          "filter": "datum.total === 0"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "color": "#173b37",
        "align": "left"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width-252"
          }
        },
        "y": {
          "value": {
            "expr": "height-110"
          }
        },
        "text": {
