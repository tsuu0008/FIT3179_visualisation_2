            },
            "key": "name",
            "fields": [
              "lon",
              "lat"
            ]
          }
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": true,
        "size": 250,
        "fill": "white",
        "stroke": "#355b72",
        "strokeWidth": 1.7,
        "opacity": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      },
      "name": "areaNumberHalo"
    },
    {
      "data": {
        "url": "data/trails.json?v=8682a4aafe0b"
      },
      "transform": [
        {
          "filter": "(chosenCode === 'All' || datum.grade === chosenCode) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "lga"
          ]
        },
        {
