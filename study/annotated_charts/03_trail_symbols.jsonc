// Current displayed specification; see DATA_AND_CAVEATS.md for methods.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 600,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "params": [
    {
      "name": "chosenGrade",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "Grade 1",
          "Grade 2",
          "Grade 3",
          "Grade 4",
          "Grade 5",
          "Unknown"
        ],
        "name": "Grade: "
      }
    },
    {
      "name": "accessOnly",
      "value": false,
      "bind": {
        "input": "checkbox",
        "name": "Full/partial access only: "
      }
    },
    {
      "name": "mapFrame",
      "expr": "[145.46965331000007,-36.613358521639626,0.15730806974957048,0.11261841622677582]"
    }
  ],
  "projection": {
    "type": "mercator",
    "center": {
      "expr": "[mapFrame[0],mapFrame[1]]"
    },
    "scale": {
      "expr": "min((width-28)/mapFrame[2],(height-154)/mapFrame[3])"
    },
    "translate": {
      "expr": "[width/2,(height-154)/2]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/lga.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1f5f4",
        "stroke": "#cbd6d1",
        "strokeWidth": 0.4
      },
      "encoding": {}
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "id",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/route_label_points.json"
            },
            "key": "id",
            "fields": [
              "name_label"
            ]
          },
          "as": [
            "annotation_name"
          ]
        },
        {
          "calculate": "datum.annotation_name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + datum.grade + '\\nLongest matching route'",
          "as": "annotation"
        },
        {
          "calculate": "mapFrame[0]+((width-274)-width/2)/(min((width-28)/mapFrame[2],(height-154)/mapFrame[3]))*180/PI",
          "as": "callout_lon"
        },
        {
          "calculate": "(2*atan(exp(log(tan(PI/4+mapFrame[1]*PI/360))+(((height-154)/2)-(height-144))/(min((width-28)/mapFrame[2],(height-154)/mapFrame[3]))))-PI/2)*180/PI",
          "as": "callout_lat"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#5d7269",
        "strokeWidth": 1.1,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "callout_lon"
        },
        "latitude2": {
          "field": "callout_lat"
        }
      }
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "lga"
          ]
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "n",
              "order": "descending"
            },
            {
              "field": "lga",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "calculate": "datum.lga + ' LGA\\n' + datum.n + (datum.n === 1 ? ' matching trail' : ' matching trails') + '\\nLargest regional cluster\\nCount covers this whole LGA'",
          "as": "annotation"
        },
        {
          "lookup": "lga",
          "from": {
            "data": {
              "url": "data/lga_label_points.json"
            },
            "key": "name",
            "fields": [
              "lon",
              "lat"
            ]
          }
        },
        {
          "calculate": "mapFrame[0]+((width-262)-width/2)/(min((width-28)/mapFrame[2],(height-154)/mapFrame[3]))*180/PI",
          "as": "callout_lon"
        },
        {
          "calculate": "(2*atan(exp(log(tan(PI/4+mapFrame[1]*PI/360))+(((height-154)/2)-(height-127))/(min((width-28)/mapFrame[2],(height-154)/mapFrame[3]))))-PI/2)*180/PI",
          "as": "callout_lat"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#5d7269",
        "strokeWidth": 1.1,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "callout_lon"
        },
        "latitude2": {
          "field": "callout_lat"
        }
      }
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "lga"
          ]
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "n",
              "order": "descending"
            },
            {
              "field": "lga",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "calculate": "datum.lga + ' LGA\\n' + datum.n + (datum.n === 1 ? ' matching trail' : ' matching trails') + '\\nLargest regional cluster\\nCount covers this whole LGA'",
          "as": "annotation"
        },
        {
          "lookup": "lga",
          "from": {
            "data": {
              "url": "data/lga_label_points.json"
            },
            "key": "name",
            "fields": [
              "lon",
              "lat"
            ]
          }
        },
        {
          "lookup": "lga",
          "from": {
            "data": {
              "url": "data/lga.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "properties.name",
            "fields": [
              "geometry"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#cbd6d1",
        "strokeWidth": 0.4
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        },
        "tooltip": [
          {
            "field": "lga",
            "title": "Highlighted LGA"
          },
          {
            "field": "n",
            "title": "Matching trails"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "mark": {
        "type": "point",
        "filled": true,
        "opacity": 0.85,
        "stroke": "#ffffff",
        "strokeWidth": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "length_km",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              95
            ],
            "range": [
              22,
              650
            ]
          },
          "title": "Distance (km)",
          "legend": {
            "values": [
              1,
              5,
              20,
              95
            ],
            "columns": 2,
            "direction": "horizontal",
            "labelFontSize": 10,
            "orient": "none",
            "legendX": 174,
            "legendY": {
              "expr": "height-132"
            },
            "padding": 0,
            "offset": 0,
            "titleFontSize": 11,
            "columnPadding": 12
          }
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#CC79A7",
              "#252525",
              "#9B9B9B"
            ]
          },
          "title": "Grade",
          "legend": {
            "columns": 2,
            "direction": "horizontal",
            "labelLimit": 70,
            "labelFontSize": 10,
            "orient": "none",
            "legendX": 8,
            "legendY": {
              "expr": "height-132"
            },
            "padding": 0,
            "offset": 0,
            "titleFontSize": 11,
            "columnPadding": 12
          }
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Trail"
          },
          {
            "field": "length_km",
            "title": "Distance (km)",
            "format": ".1f"
          },
          {
            "field": "grade",
            "title": "Grade"
          },
          {
            "field": "access",
            "title": "Disabled access"
          }
        ],
        "shape": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ],
            "range": [
              "circle",
              "square",
              "triangle-up",
              "diamond",
              "triangle-down",
              "cross"
            ]
          },
          "legend": {
            "columns": 2,
            "direction": "horizontal",
            "labelLimit": 70,
            "labelFontSize": 10,
            "orient": "none",
            "legendX": 8,
            "legendY": {
              "expr": "height-132"
            },
            "padding": 0,
            "offset": 0,
            "titleFontSize": 11,
            "columnPadding": 12
          },
          "title": "Grade"
        }
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        }
      ]
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "window": [
