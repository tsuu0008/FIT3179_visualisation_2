// STUDY COPY ONLY; the website loads the matching .json.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "autosize": {"type": "fit", "contains": "padding"},
  "background": null,
  // Vega-Lite creates these controls directly.
  "params": [
    {
      "name": "chosenGrade",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5", "Unknown"],
        "name": "Grade: "
      }
    },
    {
      "name": "accessOnly",
      "value": false,
      "bind": {"input": "checkbox", "name": "Full/partial access only: "}
    }
  ],
  "projection": {"type": "mercator"},
  // Draw the layers in order.
  "layer": [
    {
      // Input records or prepared plotting values.
  "data": {"url": "data/lga.geojson", "format": {"type": "json", "property": "features"}},
      "mark": {"type": "geoshape", "fill": "#f1f5f4", "stroke": "#c8d4d1", "strokeWidth": 0.6},
      "encoding": {}
    },
    {
      "data": {"url": "data/trails.json"},
      "mark": {"type": "circle", "opacity": 0.68, "stroke": "#ffffff", "strokeWidth": 0.45},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "size": {
          "field": "length_km",
          "type": "quantitative",
          "scale": {"type": "linear", "domain": [0, 95], "range": [22, 650]},
          "title": "Distance (km)",
          "legend": {"values": [1, 5, 20, 95], "columns": 2, "direction": "horizontal", "labelFontSize": 11}
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": ["Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5", "Unknown"],
            "range": ["#e4d6ef", "#ba94d0", "#925bb2", "#652b86", "#310747", "#9aa2a6"]
          },
          "title": "Grade",
          "legend": {"columns": 2, "direction": "horizontal", "labelLimit": 70, "labelFontSize": 11}
        },
        "tooltip": [
          {"field": "name", "title": "Trail"},
          {"field": "length_km", "title": "Distance (km)", "format": ".1f"},
          {"field": "grade", "title": "Grade"},
          {"field": "access", "title": "Disabled access"}
        ]
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        }
      ]
    },
    {
      "data": {"url": "data/trail_labels.json"},
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "window": [{"op": "row_number", "as": "annotation_rank"}],
          "sort": [{"field": "length_km", "order": "descending"}, {"field": "name", "order": "ascending"}]
        },
        {"filter": "datum.annotation_rank === 1"},
        {"calculate": "datum.short_name + '\\n' + format(datum.length_km, '.1f') + ' km'", "as": "label"}
      ],
      "mark": {"type": "point", "filled": false, "stroke": "#b34e2d", "strokeWidth": 2.5, "size": 230},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"}
      }
    },
    {
      "data": {"url": "data/trail_labels.json"},
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "window": [{"op": "row_number", "as": "annotation_rank"}],
          "sort": [{"field": "length_km", "order": "descending"}, {"field": "name", "order": "ascending"}]
        },
        {"filter": "datum.annotation_rank === 1"},
        {"calculate": "datum.short_name + '\\n' + format(datum.length_km, '.1f') + ' km'", "as": "label"}
      ],
      "mark": {
        "type": "text",
        "align": {
          "expr": "scale('projection', [datum.longitude, datum.latitude])[0] < 90 ? 'left' : scale('projection', [datum.longitude, datum.latitude])[0] > width - 90 ? 'right' : 'center'"
        },
        "baseline": {"expr": "scale('projection', [datum.longitude, datum.latitude])[1] < 40 ? 'top' : 'bottom'"},
        "dy": {"expr": "scale('projection', [datum.longitude, datum.latitude])[1] < 40 ? 14 : -24"},
        "fontSize": 11,
        "fontWeight": 700,
        "lineBreak": "\n",
        "color": "#173b37",
        "stroke": "white",
        "strokeWidth": 3,
        "limit": 180
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "data": {"url": "data/trail_labels.json"},
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "window": [{"op": "row_number", "as": "annotation_rank"}],
          "sort": [{"field": "length_km", "order": "descending"}, {"field": "name", "order": "ascending"}]
        },
        {"filter": "datum.annotation_rank === 1"},
        {"calculate": "datum.short_name + '\\n' + format(datum.length_km, '.1f') + ' km'", "as": "label"}
      ],
      "mark": {
        "type": "text",
        "align": {
          "expr": "scale('projection', [datum.longitude, datum.latitude])[0] < 90 ? 'left' : scale('projection', [datum.longitude, datum.latitude])[0] > width - 90 ? 'right' : 'center'"
        },
        "baseline": {"expr": "scale('projection', [datum.longitude, datum.latitude])[1] < 40 ? 'top' : 'bottom'"},
        "dy": {"expr": "scale('projection', [datum.longitude, datum.latitude])[1] < 40 ? 14 : -24"},
        "fontSize": 11,
        "fontWeight": 700,
        "lineBreak": "\n",
        "color": "#173b37",
        "limit": 180
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "data": {"url": "data/trails.json"},
      "transform": [
        {
          "calculate": "((chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')) ? 1 : 0",
          "as": "match"
        },
        {"aggregate": [{"op": "sum", "field": "match", "as": "total"}]},
        {"filter": "datum.total === 0"}
      ],
      "mark": {"type": "text", "fontSize": 12, "color": "#173b37"},
      "encoding": {
        "x": {"value": {"expr": "width/2"}},
        "y": {"value": {"expr": "height/2"}},
        "text": {"value": "No trails match this selection"}
      }
    }
  ],
  // Shared chart styles.
  "config": {
    "view": {"stroke": null},
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "domainColor": "#9aa7a4",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "padding": 8,
      "columns": 2,
      "direction": "horizontal",
      "labelLimit": 150
    },
    "header": {"labelFont": "Inter", "titleFont": "Inter", "labelColor": "#0f172a"}
  }
}
