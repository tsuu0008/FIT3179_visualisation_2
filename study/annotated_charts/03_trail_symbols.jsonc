// Current displayed specification; see DATA_AND_CAVEATS.md for methods.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 680,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "params": [
    {
      "name": "chosenGrade",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "Grade 1",
          "Grade 2",
          "Grade 3",
          "Grade 4",
          "Grade 5",
          "Unknown"
        ],
        "name": "Grade: "
      }
    },
    {
      "name": "accessOnly",
      "value": false,
      "bind": {
        "input": "checkbox",
        "name": "Full/partial access only: "
      }
    },
    {
      "name": "mapFrame",
      "expr": "[145.46965331000007,-36.613358521639626,0.15730806974957048,0.11261841622677582]"
    }
  ],
  "projection": {
    "type": "mercator",
    "center": {
      "expr": "[mapFrame[0],mapFrame[1]]"
    },
    "scale": {
      "expr": "min((width-28)/mapFrame[2],(height-154)/mapFrame[3])"
    },
    "translate": {
      "expr": "[width/2,(height-154)/2]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/lga.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e5ede8",
        "stroke": "#9cafa5",
        "strokeWidth": 0.65
      },
      "encoding": {}
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "lga"
          ]
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "n",
              "order": "descending"
            },
            {
              "field": "lga",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "calculate": "datum.lga + ' LGA\\n' + datum.n + (datum.n === 1 ? ' matching trail' : ' matching trails') + '\\nLargest regional cluster\\nCount covers whole area'",
          "as": "annotation"
        },
        {
          "lookup": "lga",
          "from": {
            "data": {
              "url": "data/lga_label_points.json"
            },
            "key": "name",
            "fields": [
              "lon",
              "lat"
            ]
          }
        },
        {
          "lookup": "lga",
          "from": {
            "data": {
              "url": "data/lga.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "properties.name",
            "fields": [
              "geometry"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#cddde8",
        "stroke": "#4c6c80",
        "strokeWidth": 1.1
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        },
        "tooltip": [
          {
            "field": "lga",
            "title": "Highlighted LGA"
          },
          {
            "field": "n",
            "title": "Matching trails"
          }
        ]
      },
      "name": "selectedCouncil"
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "mark": {
        "type": "point",
        "filled": true,
        "opacity": 1,
        "stroke": "#ffffff",
        "strokeWidth": 0.75
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "length_km",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              95
            ],
            "range": [
              40,
              650
            ]
          },
          "title": "Distance (km)",
          "legend": {
            "values": [
              1,
              5,
              20,
              95
            ],
            "columns": 2,
            "direction": "horizontal",
            "labelFontSize": 10,
            "orient": "none",
            "legendX": 174,
            "legendY": {
              "expr": "height-132"
            },
            "padding": 0,
            "offset": 0,
            "titleFontSize": 11,
            "columnPadding": 12
          }
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#CC79A7",
              "#252525",
              "#9B9B9B"
            ]
          },
          "title": "Grade",
          "legend": {
            "columns": 2,
            "direction": "horizontal",
            "labelLimit": 70,
            "labelFontSize": 10,
            "orient": "none",
            "legendX": 8,
            "legendY": {
              "expr": "height-132"
            },
            "padding": 0,
            "offset": 0,
            "titleFontSize": 11,
            "columnPadding": 12
          }
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Trail"
          },
          {
            "field": "length_km",
            "title": "Distance (km)",
            "format": ".1f"
          },
          {
            "field": "grade",
            "title": "Grade"
          },
          {
            "field": "access",
            "title": "Disabled access"
          }
        ],
        "shape": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ],
            "range": [
              "circle",
              "square",
              "triangle-up",
              "diamond",
              "triangle-down",
              "cross"
            ]
          },
          "legend": {
            "columns": 2,
            "direction": "horizontal",
            "labelLimit": 70,
            "labelFontSize": 10,
            "orient": "none",
            "legendX": 8,
            "legendY": {
              "expr": "height-132"
            },
            "padding": 0,
            "offset": 0,
            "titleFontSize": 11,
            "columnPadding": 12
          },
          "title": "Grade"
        }
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        }
      ],
      "name": "trailSymbols"
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "id",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/route_label_points.json"
            },
            "key": "id",
            "fields": [
              "name_label"
            ]
          },
          "as": [
            "annotation_name"
          ]
        },
        {
          "calculate": "datum.annotation_name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + datum.grade + '\\nLongest matching route'",
          "as": "annotation"
        },
        {
          "calculate": "pow(sqrt(2 * (40 + 610 * datum.length_km / 95)) + 8, 2)",
          "as": "ring_size"
        }
      ],
      "mark": {
        "type": "point",
        "filled": false,
        "stroke": "#5B2C83",
        "strokeWidth": 1.8
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "ring_size",
          "type": "quantitative",
          "scale": null,
          "legend": null
        }
      },
      "name": "longestTrailRing"
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "id",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/route_label_points.json"
            },
            "key": "id",
            "fields": [
              "name_label"
            ]
          },
          "as": [
            "annotation_name"
          ]
        },
        {
          "calculate": "datum.annotation_name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + datum.grade + '\\nLongest matching route'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 15,
        "color": "#5B2C83",
        "align": "left",
        "baseline": "top"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width-260"
          }
        },
        "y": {
          "value": {
            "expr": "height-70"
          }
        },
        "text": {
          "field": "annotation"
        }
      }
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "lga"
          ]
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "n",
              "order": "descending"
            },
            {
              "field": "lga",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "calculate": "datum.lga + ' LGA\\n' + datum.n + (datum.n === 1 ? ' matching trail' : ' matching trails') + '\\nLargest regional cluster\\nCount covers whole area'",
          "as": "annotation"
        },
        {
          "lookup": "lga",
          "from": {
            "data": {
              "url": "data/lga_label_points.json"
            },
            "key": "name",
            "fields": [
              "lon",
              "lat"
            ]
          }
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 15,
        "color": "#355b72",
        "align": "left",
        "baseline": "top"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width-260"
          }
        },
        "y": {
          "value": {
            "expr": "height-132"
          }
        },
        "text": {
          "field": "annotation"
        }
      }
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "calculate": "((chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')) ? 1 : 0",
          "as": "match"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "match",
              "as": "total"
            }
          ]
        },
        {
          "filter": "datum.total === 0"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "color": "#173b37",
        "align": "left"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width-252"
          }
        },
        "y": {
          "value": {
            "expr": "height-110"
          }
        },
        "text": {
          "value": "No trails match this selection"
        }
      }
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "lga"
          ]
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "n",
              "order": "descending"
            },
            {
              "field": "lga",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "calculate": "datum.lga + ' LGA\\n' + datum.n + (datum.n === 1 ? ' matching trail' : ' matching trails') + '\\nLargest regional cluster\\nCount covers whole area'",
          "as": "annotation"
        },
        {
          "lookup": "lga",
          "from": {
            "data": {
              "url": "data/lga_label_points.json"
            },
            "key": "name",
            "fields": [
              "lon",
              "lat"
            ]
          }
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": true,
        "size": 240,
        "fill": "white",
        "stroke": "#355b72",
        "strokeWidth": 1.6,
        "opacity": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      },
      "name": "areaNumberHalo"
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "lga"
          ]
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "n",
              "order": "descending"
            },
            {
              "field": "lga",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "calculate": "datum.lga + ' LGA\\n' + datum.n + (datum.n === 1 ? ' matching trail' : ' matching trails') + '\\nLargest regional cluster\\nCount covers whole area'",
          "as": "annotation"
        },
        {
          "lookup": "lga",
          "from": {
            "data": {
              "url": "data/lga_label_points.json"
            },
            "key": "name",
            "fields": [
              "lon",
              "lat"
            ]
          }
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 700,
        "dx": 0,
        "dy": 0,
        "baseline": "middle",
        "align": "center",
        "color": "#355b72"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "value": "A"
        },
        "tooltip": {
          "value": "A: highlighted council with the most matching trails."
        }
      },
      "name": "areaNumber"
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "id",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/route_label_points.json"
            },
            "key": "id",
            "fields": [
              "name_label"
            ]
          },
          "as": [
            "annotation_name"
          ]
        },
        {
          "calculate": "datum.annotation_name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + datum.grade + '\\nLongest matching route'",
          "as": "annotation"
        },
        {
          "calculate": "pow(sqrt(2 * (40 + 610 * datum.length_km / 95)) + 8, 2)",
          "as": "ring_size"
        },
        {
          "calculate": "datum.longitude + (sqrt(datum.ring_size)/2+12) / min((width-28)/mapFrame[2],(height-154)/mapFrame[3]) * 180 / 3.141592653589793",
          "as": "badge_lon"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": true,
        "size": 240,
        "fill": "white",
        "stroke": "#5B2C83",
        "strokeWidth": 1.6,
        "opacity": 1
      },
      "encoding": {
        "longitude": {
          "field": "badge_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        }
      },
      "name": "routeNumberHalo"
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "id",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/route_label_points.json"
            },
            "key": "id",
            "fields": [
              "name_label"
            ]
          },
          "as": [
            "annotation_name"
          ]
        },
        {
          "calculate": "datum.annotation_name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + datum.grade + '\\nLongest matching route'",
          "as": "annotation"
        },
        {
          "calculate": "pow(sqrt(2 * (40 + 610 * datum.length_km / 95)) + 8, 2)",
          "as": "ring_size"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 700,
        "dx": {
          "expr": "sqrt(datum.ring_size)/2+12"
        },
        "dy": 0,
        "baseline": "middle",
        "align": "center",
        "color": "#5B2C83"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "value": "B"
        },
        "tooltip": {
          "value": "B: ring around the longest matching trail; see the matching note below."
        }
      },
      "name": "routeNumber"
    },
    {
      "name": "symbolFooterBBadge",
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "id",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/route_label_points.json"
            },
            "key": "id",
            "fields": [
              "name_label"
            ]
          },
          "as": [
            "annotation_name"
          ]
        },
        {
          "calculate": "datum.annotation_name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + datum.grade + '\\nLongest matching route'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": true,
        "size": 240,
        "fill": "white",
        "stroke": "#5B2C83",
        "strokeWidth": 1.6,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width-274"
          }
        },
        "y": {
          "value": {
            "expr": "height-64"
          }
        }
      }
    },
    {
      "name": "symbolFooterBLetter",
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "window": [
