      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "id",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/route_label_points.json"
            },
            "key": "id",
            "fields": [
              "name_label"
            ]
          },
          "as": [
            "annotation_name"
          ]
        },
        {
          "calculate": "datum.annotation_name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + datum.grade + '\\nLongest matching route'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 13,
        "color": "#20343A",
        "align": "left",
        "baseline": "top"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width-252"
          }
        },
        "y": {
          "value": {
            "expr": "height-70"
          }
        },
        "text": {
          "field": "annotation"
        }
      }
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
