// Vega/Vega-Lite specification with versioned source-data URLs.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 650,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "params": [
    {
      "name": "chosenCode",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "C1",
          "C2",
          "C3",
          "C4",
          "C5",
          "C6",
          "3",
          "Unknown"
        ],
        "name": "Code: "
      }
    },
    {
      "name": "accessOnly",
      "value": false,
      "bind": {
        "input": "checkbox",
        "name": "Full/partial access only: "
      }
    },
    {
      "name": "mapFrame",
      "expr": "[145.46902564999868,-36.61327398827786,0.15732980049501755,0.11261417469557167]"
    }
  ],
  "projection": {
    "type": "mercator",
    "center": {
      "expr": "[mapFrame[0],mapFrame[1]]"
    },
    "scale": {
      "expr": "min(max(width-300,300)/mapFrame[2],(height-70)/mapFrame[3])"
    },
    "translate": {
      "expr": "[width/2,(height-70)/2]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/lga.geojson?v=c1c375501f56",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e5ede8",
        "stroke": "#9cafa5",
        "strokeWidth": 0.65
      },
      "encoding": {}
    },
    {
      "data": {
        "url": "data/trails.json?v=8682a4aafe0b"
      },
      "transform": [
        {
          "filter": "(chosenCode === 'All' || datum.grade === chosenCode) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "lga"
          ]
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "n",
              "order": "descending"
            },
            {
              "field": "lga",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "calculate": "datum.lga + ' · ' + datum.n + ' matching routes\\nLargest council cluster\\nHighlights where more choices concentrate.\\nCount covers the whole council.'",
          "as": "annotation"
        },
        {
          "lookup": "lga",
          "from": {
            "data": {
              "url": "data/lga_label_points.json?v=97a15a2d1153"
            },
            "key": "name",
            "fields": [
              "lon",
              "lat"
            ]
          }
        },
        {
          "lookup": "lga",
          "from": {
            "data": {
              "url": "data/lga.geojson?v=c1c375501f56",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "properties.name",
            "fields": [
              "geometry"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#cddde8",
        "stroke": "#4c6c80",
        "strokeWidth": 1.1
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        },
        "tooltip": [
          {
            "field": "lga",
            "title": "Highlighted LGA"
          },
          {
            "field": "n",
            "title": "Matching trails"
          }
        ]
      },
      "name": "selectedCouncil"
    },
    {
      "data": {
        "url": "data/trails.json?v=8682a4aafe0b"
      },
      "mark": {
        "type": "point",
        "filled": true,
        "opacity": 1,
        "stroke": "#ffffff",
        "strokeWidth": 0.75
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "length_km",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              95
            ],
            "range": [
              40,
              650
            ]
          },
          "title": "Distance (km)",
          "legend": {
            "values": [
              1,
              5,
              20,
              95
            ],
            "columns": 2,
            "direction": "horizontal",
            "labelFontSize": 10,
            "orient": "none",
            "legendX": 174,
            "legendY": {
              "expr": "height-132"
            },
            "padding": 0,
            "offset": 0,
            "titleFontSize": 11,
            "columnPadding": 12
          }
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C6",
              "3",
              "Unknown"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#CC79A7",
              "#252525",
              "#6f52a3",
              "#985d3f",
              "#9daca9"
            ]
          },
          "title": "Recorded code",
          "legend": {
            "columns": 2,
            "direction": "horizontal",
            "labelLimit": 70,
            "labelFontSize": 10,
            "orient": "none",
            "legendX": 8,
            "legendY": {
              "expr": "height-132"
            },
            "padding": 0,
            "offset": 0,
            "titleFontSize": 11,
            "columnPadding": 12
          }
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Trail"
          },
          {
            "field": "length_km",
            "title": "Distance (km)",
            "format": ".1f"
          },
          {
            "field": "grade",
            "title": "Code"
          },
          {
            "field": "access",
            "title": "Disabled access"
          },
          {
            "field": "closure",
            "title": "Recorded route status"
          }
        ],
        "shape": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C6",
              "3",
              "Unknown"
            ],
            "range": [
              "circle",
              "square",
              "triangle-up",
              "diamond",
              "cross",
              "triangle-down",
              "triangle-left",
              "triangle-right"
            ]
          },
          "legend": {
            "columns": 2,
            "direction": "horizontal",
            "labelLimit": 70,
            "labelFontSize": 10,
            "orient": "none",
            "legendX": 8,
            "legendY": {
              "expr": "height-132"
            },
            "padding": 0,
            "offset": 0,
            "titleFontSize": 11,
            "columnPadding": 12
          },
          "title": "Recorded code"
        }
      },
      "transform": [
        {
          "filter": "(chosenCode === 'All' || datum.grade === chosenCode) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        }
      ],
      "name": "trailSymbols"
    },
    {
      "data": {
        "url": "data/trails.json?v=8682a4aafe0b"
      },
      "transform": [
        {
          "filter": "(chosenCode === 'All' || datum.grade === chosenCode) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "joinaggregate": [
            {
              "op": "median",
              "field": "length_km",
              "as": "matched_median"
            }
          ]
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "id",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/route_label_points.json?v=5097fd9f4489"
            },
            "key": "id",
            "fields": [
              "name_label"
            ]
          },
          "as": [
            "annotation_name"
          ]
        },
        {
          "calculate": "datum.annotation_name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + datum.grade + '\\nLongest matching route\\n' + (datum.length_km > datum.matched_median ? format(datum.length_km/datum.matched_median,'.1f') + '× matching median: a longer commitment.' : 'Matches the median: no length contrast.')",
          "as": "annotation"
        },
        {
          "calculate": "pow(sqrt(2 * (40 + 610 * datum.length_km / 95)) + 8, 2)",
          "as": "ring_size"
        }
      ],
      "mark": {
        "type": "point",
        "filled": false,
        "stroke": "#5B2C83",
        "strokeWidth": 1.8
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "ring_size",
          "type": "quantitative",
          "scale": null,
          "legend": null
        }
      },
      "name": "longestTrailRing"
    },
    {
      "data": {
        "url": "data/trails.json?v=8682a4aafe0b"
      },
      "transform": [
        {
          "filter": "(chosenCode === 'All' || datum.grade === chosenCode) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "joinaggregate": [
            {
              "op": "median",
              "field": "length_km",
              "as": "matched_median"
            }
          ]
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "id",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/route_label_points.json?v=5097fd9f4489"
            },
            "key": "id",
            "fields": [
              "name_label"
            ]
          },
          "as": [
            "annotation_name"
          ]
        },
        {
          "calculate": "datum.annotation_name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + datum.grade + '\\nLongest matching route\\n' + (datum.length_km > datum.matched_median ? format(datum.length_km/datum.matched_median,'.1f') + '× matching median\\nAn unusually long outing.' : 'Matches the middle distance.')",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 16,
        "color": "#5B2C83",
        "align": "left",
        "baseline": "top"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width-153"
          }
        },
        "y": {
          "value": {
            "expr": "height*.29"
          }
        },
        "text": {
          "field": "annotation"
        }
      }
    },
    {
      "data": {
        "url": "data/trails.json?v=8682a4aafe0b"
      },
      "transform": [
        {
          "filter": "(chosenCode === 'All' || datum.grade === chosenCode) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "lga"
          ]
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "n",
              "order": "descending"
            },
            {
              "field": "lga",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "calculate": "datum.lga + '\\n' + datum.n + (datum.n === 1 ? ' matching route' : ' matching routes') + '\\nLargest council cluster\\nMore choices concentrate\\nin this council area.'",
          "as": "annotation"
        },
        {
          "lookup": "lga",
          "from": {
            "data": {
              "url": "data/lga_label_points.json?v=97a15a2d1153"
            },
            "key": "name",
            "fields": [
              "lon",
              "lat"
            ]
          }
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 16,
        "color": "#355b72",
        "align": "left",
        "baseline": "top"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width-245"
          }
        },
        "y": {
          "value": {
            "expr": "height-150"
          }
        },
        "text": {
          "field": "annotation"
        }
      }
    },
    {
      "data": {
        "url": "data/trails.json?v=8682a4aafe0b"
      },
      "transform": [
        {
          "calculate": "((chosenCode === 'All' || datum.grade === chosenCode) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')) ? 1 : 0",
          "as": "match"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "match",
              "as": "total"
            }
          ]
        },
        {
          "filter": "datum.total === 0"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "color": "#173b37",
        "align": "left"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width-252"
          }
        },
        "y": {
          "value": {
            "expr": "height-110"
          }
        },
        "text": {
          "value": "No trails match this selection"
        }
      }
    },
