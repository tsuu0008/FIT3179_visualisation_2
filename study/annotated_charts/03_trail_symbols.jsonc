    },
    {
      "data": {
        "url": "data/trails.json?v=8682a4aafe0b"
      },
      "transform": [
        {
          "filter": "(chosenCode === 'All' || datum.grade === chosenCode) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "joinaggregate": [
            {
              "op": "median",
              "field": "length_km",
              "as": "matched_median"
            }
          ]
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "id",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/route_label_points.json?v=5097fd9f4489"
            },
            "key": "id",
            "fields": [
              "name_label"
            ]
          },
          "as": [
            "annotation_name"
          ]
        },
        {
          "calculate": "datum.annotation_name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + datum.grade + '\\nLongest matching route\\n' + (datum.length_km > datum.matched_median ? format(datum.length_km/datum.matched_median,'.1f') + '× matching median: a longer commitment.' : 'Matches the median: no length contrast.')",
          "as": "annotation"
        },
        {
          "calculate": "pow(sqrt(2 * (40 + 610 * datum.length_km / 95)) + 8, 2)",
          "as": "ring_size"
        },
        {
          "calculate": "datum.longitude + (sqrt(datum.ring_size)/2+12) / min((width-28)/mapFrame[2],(height-154)/mapFrame[3]) * 180 / 3.141592653589793",
          "as": "badge_lon"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": true,
        "size": 250,
        "fill": "white",
        "stroke": "#5B2C83",
        "strokeWidth": 1.7,
