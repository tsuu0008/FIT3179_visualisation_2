        },
        {
          "calculate": "mapFrame[0]+((width-274)-width/2)/(min((width-28)/mapFrame[2],(height-154)/mapFrame[3]))*180/PI",
          "as": "callout_lon"
        },
        {
          "calculate": "(2*atan(exp(log(tan(PI/4+mapFrame[1]*PI/360))+(((height-154)/2)-(height-144))/(min((width-28)/mapFrame[2],(height-154)/mapFrame[3]))))-PI/2)*180/PI",
          "as": "callout_lat"
