      },
      "transform": [
        {
          "filter": "(chosenCode === 'All' || datum.grade === chosenCode) && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "joinaggregate": [
            {
              "op": "median",
              "field": "length_km",
              "as": "matched_median"
            }
          ]
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "id",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/route_label_points.json?v=5097fd9f4489"
            },
            "key": "id",
            "fields": [
              "name_label"
            ]
          },
          "as": [
            "annotation_name"
          ]
        },
        {
          "calculate": "datum.annotation_name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + datum.grade + '\\nLongest matching route\\n' + (datum.length_km > datum.matched_median ? format(datum.length_km/datum.matched_median,'.1f') + '× matching median: a longer commitment.' : 'Matches the median: no length contrast.')",
          "as": "annotation"
        },
        {
          "calculate": "pow(sqrt(2 * (40 + 610 * datum.length_km / 95)) + 8, 2)",
          "as": "ring_size"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 700,
        "dx": {
          "expr": "sqrt(datum.ring_size)/2+12"
        },
        "dy": 0,
        "baseline": "middle",
        "align": "center",
        "color": "#5B2C83"
