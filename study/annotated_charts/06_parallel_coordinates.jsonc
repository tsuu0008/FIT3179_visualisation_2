  "transform": [
    {
      "filter": "(chosenCode === 'All' || datum.grade === chosenCode) && (chosenLga === 'All' || datum.lga === chosenLga)"
    },
    {
      "calculate": "datum.id === pickTrail ? 1 : 0",
      "as": "selected_match"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "length_km",
          "as": "max_length"
        },
        {
          "op": "min",
          "field": "length_km",
          "as": "min_length"
        },
        {
          "op": "max",
          "field": "selected_match",
          "as": "selected_exists"
        },
        {
          "op": "median",
          "field": "length_km",
          "as": "matching_middle"
        }
      ]
    },
    {
      "calculate": "datum.length_km === datum.max_length ? datum.id : null",
      "as": "longest_candidate"
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "longest_candidate",
          "as": "longest_id"
        }
      ]
    }
  ],
