// STUDY COPY ONLY: the website loads the matching .json, not this .jsonc.
// Prepared axis/position fields locate each trail. Detail groups four points into one line.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Prepared per-axis positions; one grouped line per trail. Missing values occupy a separate lane.",
  "width": 1000,
  "height": 400,
  "autosize": {"type": "fit", "contains": "padding"},
  "background": null,
  // Vega-Lite creates these controls; no JavaScript event handler is needed.
  "params": [
    {
      "name": "focusTrail",
      "value": "Track Ninety Six",
      "bind": {
        "input": "select",
        "options": ["None", "Track Ninety Six", "Upper Yarra Walking Track", "Great Dividing Trail"],
        "name": "Trace an example: "
      }
    }
  ],
  // Draw these layers in order, from background to foreground.
  "layer": [
    {
      // Input records or prepared plotting values.
  "data": {"values": [{}]},
      "mark": {"type": "rect", "color": "#eef3f0"},
      "encoding": {
        "x": {"datum": -0.05, "type": "quantitative", "axis": null, "scale": {"domain": [-0.05, 3.65]}},
        "y": {"datum": -21, "type": "quantitative", "axis": null, "scale": {"domain": [-22, 120]}},
        "x2": {"datum": 3.65},
        "y2": {"datum": -8}
      }
    },
    {
      "data": {
        "values": [
          {"axis": 0, "label": "Walking grade"},
          {"axis": 1, "label": "Distance (km)¹"},
          {"axis": 2, "label": "Time (hours)¹"},
          {"axis": 3, "label": "Terrain"}
        ]
      },
      "mark": {"type": "rule", "color": "#a9bfb4"},
      "encoding": {
        "x": {"field": "axis", "type": "quantitative", "scale": {"domain": [-0.05, 3.65]}, "axis": null},
        "y": {"datum": 0, "type": "quantitative", "axis": null, "scale": {"domain": [-22, 120]}},
        "y2": {"datum": 100}
      }
    },
    {
      "data": {"url": "data/parallel_points.json"},
      "mark": {"type": "line", "opacity": 0.22, "strokeWidth": 1.2},
      "encoding": {
        "x": {"field": "axis", "type": "quantitative", "scale": {"domain": [-0.05, 3.65]}, "axis": null},
        "y": {"field": "position", "type": "quantitative", "scale": {"domain": [-22, 120]}, "axis": null},
        "detail": {"field": "id"},
        "order": {"field": "axis"},
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": ["Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5", "Unknown"],
            "range": ["#2a9d8f", "#69b578", "#e9c46a", "#f4a261", "#e76f51", "#9aa2a6"]
          },
          "title": "Grade"
        },
        "tooltip": [
          {"field": "name", "title": "Trail"},
          {"field": "grade", "title": "Grade"},
          {"field": "length_km", "title": "Distance (km)"},
          {"field": "hours", "title": "Hours"},
          {"field": "gradient", "title": "Terrain"}
        ]
      }
    },
    {
      "data": {"url": "data/parallel_points.json"},
      // Filter, group or calculate before drawing.
  "transform": [{"filter": "datum.name === focusTrail"}],
      "mark": {"type": "line", "strokeWidth": 3.5, "point": {"filled": true, "size": 50, "stroke": "white"}},
      "encoding": {
        "x": {"field": "axis", "type": "quantitative", "scale": {"domain": [-0.05, 3.65]}, "axis": null},
        "y": {"field": "position", "type": "quantitative", "scale": {"domain": [-22, 120]}, "axis": null},
        "detail": {"field": "id"},
        "order": {"field": "axis"},
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": ["Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5", "Unknown"],
            "range": ["#2a9d8f", "#69b578", "#e9c46a", "#f4a261", "#e76f51", "#9aa2a6"]
          },
          "title": "Grade"
        },
        "tooltip": [
          {"field": "name", "title": "Trail"},
          {"field": "grade", "title": "Grade"},
          {"field": "length_km", "title": "Distance (km)"},
          {"field": "hours", "title": "Hours"},
          {"field": "gradient", "title": "Terrain"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"axis": 0, "position": 0.0, "label": "1"},
          {"axis": 0, "position": 25.0, "label": "2"},
          {"axis": 0, "position": 50.0, "label": "3"},
          {"axis": 0, "position": 75.0, "label": "4"},
          {"axis": 0, "position": 100.0, "label": "5"},
          {"axis": 0, "position": -15, "label": "Not recorded"},
          {"axis": 1, "position": 0.0, "label": "0"},
          {"axis": 1, "position": 10.259783520851542, "label": "1"},
          {"axis": 1, "position": 22.941573387056177, "label": "5"},
          {"axis": 1, "position": 32.44428422615251, "label": "10"},
          {"axis": 1, "position": 51.298917604257696, "label": "25"},
          {"axis": 1, "position": 72.54762501100116, "label": "50"},
          {"axis": 1, "position": 100.0, "label": "95"},
          {"axis": 2, "position": 0.0, "label": "0"},
          {"axis": 2, "position": 14.433756729740644, "label": "1"},
          {"axis": 2, "position": 28.867513459481287, "label": "4"},
          {"axis": 2, "position": 50.0, "label": "12"},
          {"axis": 2, "position": 70.71067811865476, "label": "24"},
          {"axis": 2, "position": 100.0, "label": "48"},
          {"axis": 2, "position": -15, "label": "Not recorded"},
          {"axis": 3, "position": 0.0, "label": "Flat"},
          {"axis": 3, "position": 25.0, "label": "Gentle hills"},
          {"axis": 3, "position": 50.0, "label": "Short steep hills"},
          {"axis": 3, "position": 75.0, "label": "Very steep"},
          {"axis": 3, "position": 100.0, "label": "Steep + difficult"},
          {"axis": 3, "position": -15, "label": "Not recorded"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 7,
        "fontSize": 11,
        "color": "#334d43",
        "stroke": "white",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {"field": "axis", "type": "quantitative", "scale": {"domain": [-0.05, 3.65]}, "axis": null},
        "y": {"field": "position", "type": "quantitative", "scale": {"domain": [-22, 120]}, "axis": null},
        "text": {"field": "label"}
      }
    },
    {
      "data": {
        "values": [
          {"axis": 0, "position": 0.0, "label": "1"},
          {"axis": 0, "position": 25.0, "label": "2"},
          {"axis": 0, "position": 50.0, "label": "3"},
          {"axis": 0, "position": 75.0, "label": "4"},
          {"axis": 0, "position": 100.0, "label": "5"},
          {"axis": 0, "position": -15, "label": "Not recorded"},
          {"axis": 1, "position": 0.0, "label": "0"},
          {"axis": 1, "position": 10.259783520851542, "label": "1"},
          {"axis": 1, "position": 22.941573387056177, "label": "5"},
          {"axis": 1, "position": 32.44428422615251, "label": "10"},
          {"axis": 1, "position": 51.298917604257696, "label": "25"},
          {"axis": 1, "position": 72.54762501100116, "label": "50"},
          {"axis": 1, "position": 100.0, "label": "95"},
          {"axis": 2, "position": 0.0, "label": "0"},
          {"axis": 2, "position": 14.433756729740644, "label": "1"},
          {"axis": 2, "position": 28.867513459481287, "label": "4"},
          {"axis": 2, "position": 50.0, "label": "12"},
          {"axis": 2, "position": 70.71067811865476, "label": "24"},
          {"axis": 2, "position": 100.0, "label": "48"},
          {"axis": 2, "position": -15, "label": "Not recorded"},
          {"axis": 3, "position": 0.0, "label": "Flat"},
          {"axis": 3, "position": 25.0, "label": "Gentle hills"},
          {"axis": 3, "position": 50.0, "label": "Short steep hills"},
          {"axis": 3, "position": 75.0, "label": "Very steep"},
          {"axis": 3, "position": 100.0, "label": "Steep + difficult"},
          {"axis": 3, "position": -15, "label": "Not recorded"}
        ]
      },
      "mark": {"type": "text", "align": "left", "dx": 7, "fontSize": 11, "color": "#334d43"},
      "encoding": {
        "x": {"field": "axis", "type": "quantitative", "scale": {"domain": [-0.05, 3.65]}, "axis": null},
        "y": {"field": "position", "type": "quantitative", "scale": {"domain": [-22, 120]}, "axis": null},
        "text": {"field": "label"}
      }
    },
    {
      "data": {
        "values": [
          {"axis": 0, "label": "Walking grade"},
          {"axis": 1, "label": "Distance (km)¹"},
          {"axis": 2, "label": "Time (hours)¹"},
          {"axis": 3, "label": "Terrain"}
        ]
      },
      "mark": {"type": "text", "align": "left", "fontSize": 12, "fontWeight": 700, "color": "#173b37"},
      "encoding": {
        "x": {"field": "axis", "type": "quantitative", "scale": {"domain": [-0.05, 3.65]}, "axis": null},
        "y": {"datum": 112, "type": "quantitative", "axis": null, "scale": {"domain": [-22, 120]}},
        "text": {"field": "label"}
      }
    },
    {
      "data": {"url": "data/parallel_points.json"},
      "transform": [{"filter": "datum.name === focusTrail && datum.axis === 2"}],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "dy": -14,
        "lineBreak": "\n",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#9c4227"
      },
      "encoding": {
        "x": {"field": "axis", "type": "quantitative", "scale": {"domain": [-0.05, 3.65]}, "axis": null},
        "y": {"field": "position", "type": "quantitative", "scale": {"domain": [-22, 120]}, "axis": null},
        "text": {"field": "annotation"}
      }
    }
  ],
  // Shared styling for this chart.
  "config": {
    "view": {"stroke": null},
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6,
      "tickCount": 7
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "padding": 8,
      "columns": 3,
      "labelLimit": 100,
      "orient": "bottom",
      "symbolOpacity": 1
    }
  }
}
