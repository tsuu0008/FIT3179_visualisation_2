{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 610,
  "height": 360,
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "domainColor": "#9aa7a4",
      "labelFont": "Inter",
      "titleFont": "Inter"
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom"
    },
    "header": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#0f172a"
    }
  },
  "data": {
    "url": "data/access_waffle.json"
  },
  "mark": {
    "type": "square",
    "size": 660,
    "cornerRadius": 3
  },
  "encoding": {
    "x": {
      "field": "column",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "sort": "descending",
      "axis": null
    },
    "color": {
      "field": "status",
      "type": "nominal",
      "scale": {
        "domain": [
          "Full or partial access",
          "No disabled access"
        ],
        "range": [
          "#e76f51",
          "#d8e2df"
        ]
      },
      "title": "Recorded access"
    },
    "tooltip": [
      {
        "field": "status",
        "title": "Each square = 1%"
      }
    ]
  }
}