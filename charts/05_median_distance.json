{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "background": null,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#405652",
      "titleColor": "#24443f",
      "gridColor": "#e4ebe7"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "data": {
    "url": "data/trails.json"
  },
  "transform": [
    {
      "filter": "datum.track_code !== 'Unknown'"
    },
    {
      "aggregate": [
        {
          "op": "median",
          "field": "length_km",
          "as": "median_km"
        },
        {
          "op": "count",
          "as": "n"
        }
      ],
      "groupby": [
        "track_code"
      ]
    },
    {
      "calculate": "format(datum.median_km,'.1f') + ' km (n=' + datum.n + ')'",
      "as": "label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#bccfc8"
      },
      "encoding": {
        "y": {
          "field": "track_code",
          "type": "ordinal",
          "sort": [
            "C1",
            "C2",
            "C3",
            "C4",
            "C5",
            "C6",
            "3"
          ],
          "title": "Source code"
        },
        "x": {
          "field": "median_km",
          "type": "quantitative",
          "title": "Median distance (km)",
          "scale": {
            "domain": [
              0,
              10
            ]
          }
        },
        "x2": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 95
      },
      "encoding": {
        "y": {
          "field": "track_code",
          "type": "ordinal",
          "sort": [
            "C1",
            "C2",
            "C3",
            "C4",
            "C5",
            "C6",
            "3"
          ],
          "title": "Source code"
        },
        "x": {
          "field": "median_km",
          "type": "quantitative",
          "title": "Median distance (km)",
          "scale": {
            "domain": [
              0,
              10
            ]
          }
        },
        "color": {
          "field": "track_code",
          "type": "nominal",
          "scale": {
            "domain": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C6",
              "3",
              "Unknown"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#CC79A7",
              "#252525",
              "#6f52a3",
              "#ad6f3b",
              "#9daca9"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 12,
        "color": "#24443f"
      },
      "encoding": {
        "y": {
          "field": "track_code",
          "type": "ordinal",
          "sort": [
            "C1",
            "C2",
            "C3",
            "C4",
            "C5",
            "C6",
            "3"
          ],
          "title": "Source code"
        },
        "x": {
          "field": "median_km",
          "type": "quantitative",
          "title": "Median distance (km)",
          "scale": {
            "domain": [
              0,
              10
            ]
          }
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "description": "Median distance by source code. Small C1 and C6 groups are shown with their counts; code is not relabelled as public walking grade."
}
