{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 498,
  "height": 360,
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6,
      "tickCount": 7
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "padding": 8
    }
  },
  "data": {
    "url": "data/trails.json"
  },
  "transform": [
    {
      "filter": "datum.grade !== 'Unknown' && isValid(datum.length_km)"
    },
    {
      "aggregate": [
        {
          "op": "median",
          "field": "length_km",
          "as": "median_km"
        },
        {
          "op": "count",
          "as": "trail_count"
        }
      ],
      "groupby": [
        "grade"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 4,
        "strokeCap": "round"
      },
      "encoding": {
        "y": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "Grade 1",
            "Grade 2",
            "Grade 3",
            "Grade 4",
            "Grade 5"
          ],
          "title": null
        },
        "x": {
          "field": "median_km",
          "type": "quantitative",
          "title": "Median trail distance (km)",
          "scale": {
            "domain": [
              0,
              {
                "expr": "width < 320 ? 32 : 27"
              }
            ],
            "nice": false
          }
        },
        "x2": {
          "datum": 0
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5"
            ],
            "range": [
              "#2a9d8f",
              "#69b578",
              "#e9c46a",
              "#f4a261",
              "#e76f51"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 170,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "y": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "Grade 1",
            "Grade 2",
            "Grade 3",
            "Grade 4",
            "Grade 5"
          ],
          "title": null
        },
        "x": {
          "field": "median_km",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              {
                "expr": "width < 320 ? 32 : 27"
              }
            ],
            "nice": false
          }
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5"
            ],
            "range": [
              "#2a9d8f",
              "#69b578",
              "#e9c46a",
              "#f4a261",
              "#e76f51"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "grade",
            "title": "Grade"
          },
          {
            "field": "median_km",
            "title": "Median distance (km)",
            "format": ".1f"
          },
          {
            "field": "trail_count",
            "title": "Trails"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": false,
        "stroke": "#a64629",
        "strokeWidth": 2,
        "size": 360
      },
      "encoding": {
        "y": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "Grade 1",
            "Grade 2",
            "Grade 3",
            "Grade 4",
            "Grade 5"
          ],
          "title": null
        },
        "x": {
          "field": "median_km",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              {
                "expr": "width < 320 ? 32 : 27"
              }
            ],
            "nice": false
          }
        },
        "tooltip": [
          {
            "field": "grade",
            "title": "Grade"
          },
          {
            "field": "median_km",
            "title": "Median distance (km)",
            "format": ".1f"
          },
          {
            "field": "trail_count",
            "title": "Trails"
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.grade === 'Grade 5'"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#173b37",
        "lineBreak": "\n",
        "limit": {
          "expr": "small ? 170 : 0"
        }
      },
      "encoding": {
        "y": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "Grade 1",
            "Grade 2",
            "Grade 3",
            "Grade 4",
            "Grade 5"
          ]
        },
        "x": {
          "field": "median_km",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              {
                "expr": "width < 320 ? 32 : 27"
              }
            ],
            "nice": false
          }
        },
        "text": {
          "field": "annotation"
        }
      },
      "transform": [
        {
          "calculate": "datum.grade === 'Grade 5' ? format(datum.median_km, '.1f') + ' km\\nOnly ' + datum.trail_count + ' trails' : format(datum.median_km, '.2f') + ' km · n=' + datum.trail_count",
          "as": "annotation"
        }
      ]
    }
  ],
  "usermeta": {
    "container": "#chart-05",
    "layout": "standard",
    "gutter": 65
  },
  "params": [
    {
      "name": "small",
      "value": false
    },
    {
      "name": "compact",
      "value": false
    }
  ]
}
