{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 310,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "#ffffff",
  "params": [
    {
      "name": "chosenLga",
      "value": "Murrindindi",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "Alpine",
          "Ararat",
          "Baw Baw",
          "Benalla",
          "Cardinia",
          "Central Goldfields",
          "Colac Otway",
          "East Gippsland",
          "Gannawarra",
          "Glenelg",
          "Golden Plains",
          "Greater Bendigo",
          "Hindmarsh",
          "Horsham",
          "Indigo",
          "Latrobe (Vic.)",
          "Loddon",
          "Macedon Ranges",
          "Mansfield",
          "Mildura",
          "Mitchell",
          "Moorabool",
          "Mount Alexander",
          "Murrindindi",
          "Northern Grampians",
          "Pyrenees",
          "Towong",
          "Unincorporated Vic",
          "Wellington",
          "Whittlesea",
          "Yarra Ranges"
        ],
        "name": "Area: ",
        "labels": [
          "All Victoria",
          "Alpine",
          "Ararat",
          "Baw Baw",
          "Benalla",
          "Cardinia",
          "Central Goldfields",
          "Colac Otway",
          "East Gippsland",
          "Gannawarra",
          "Glenelg",
          "Golden Plains",
          "Greater Bendigo",
          "Hindmarsh",
          "Horsham",
          "Indigo",
          "Latrobe (Vic.)",
          "Loddon",
          "Macedon Ranges",
          "Mansfield",
          "Mildura",
          "Mitchell",
          "Moorabool",
          "Mount Alexander",
          "Murrindindi",
          "Northern Grampians",
          "Pyrenees",
          "Towong",
          "Unincorporated Vic",
          "Wellington",
          "Whittlesea",
          "Yarra Ranges"
        ]
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "name": "detailBase",
      "data": {
        "url": "data/lga.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#edf3ef",
        "stroke": "#b4c4bc",
        "strokeWidth": 0.6
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.name",
            "title": "Area"
          }
        ]
      },
      "transform": [
        {
          "filter": "chosenLga === 'All' || datum.properties.name === chosenLga"
        }
      ]
    },
    {
      "data": {
        "url": "data/trails.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "chosenLga === 'All' || datum.properties.lga === chosenLga"
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeWidth": 2.5
      },
      "encoding": {
        "color": {
          "field": "properties.grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#CC79A7",
              "#252525",
              "#9B9B9B"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "properties.name",
            "title": "Trail"
          },
          {
            "field": "properties.length_km",
            "title": "Distance (km)"
          },
          {
            "field": "properties.grade",
            "title": "Grade"
          }
        ]
      }
    },
    {
      "name": "detailRegion",
      "data": {
        "url": "data/map_regions.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "chosenLga === 'All' ? datum.properties.name === 'Victoria' : datum.properties.name === chosenLga"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#d95d39",
        "strokeWidth": 2
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.name",
            "title": "Selected area"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/trail_labels.json"
      },
      "transform": [
        {
          "filter": "chosenLga === 'All' || datum.lga === chosenLga"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "id",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "calculate": "datum.short_name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + datum.grade + '\\nLongest in this area'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#20343A",
        "size": 70,
        "stroke": "white"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 13,
        "align": {
          "expr": "datum.annotation_align"
        },
        "baseline": "middle",
        "color": "#20343A",
        "dx": {
          "expr": "datum.annotation_dx"
        },
        "dy": -29,
        "stroke": "white",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "annotation"
        }
      },
      "data": {
        "url": "data/trail_labels.json"
      },
      "transform": [
        {
          "filter": "chosenLga === 'All' || datum.lga === chosenLga"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "id",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "calculate": "datum.short_name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + datum.grade + '\\nLongest in this area'",
          "as": "annotation"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 13,
        "align": {
          "expr": "datum.annotation_align"
        },
        "baseline": "middle",
        "color": "#20343A",
        "dx": {
          "expr": "datum.annotation_dx"
        },
        "dy": -29
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "annotation"
        }
      },
      "data": {
        "url": "data/trail_labels.json"
      },
      "transform": [
        {
          "filter": "chosenLga === 'All' || datum.lga === chosenLga"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "id",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank === 1"
        },
        {
          "calculate": "datum.short_name + '\\n' + format(datum.length_km,'.1f') + ' km · ' + datum.grade + '\\nLongest in this area'",
          "as": "annotation"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 13,
        "align": "left",
        "baseline": "top",
        "color": "#20343A",
        "stroke": "white",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "x": {
          "value": 10
        },
        "y": {
          "value": 17
        },
        "text": {
          "field": "annotation"
        }
      },
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "chosenLga === 'All' || datum.lga === chosenLga"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            },
            {
              "op": "sum",
              "field": "length_km",
              "as": "km"
            }
          ]
        },
        {
          "calculate": "(chosenLga === 'All' ? 'Victoria' : chosenLga) + ' · ' + datum.n + ' trails\\n' + format(datum.km,'.1f') + ' km; a route can cross borders'",
          "as": "annotation"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 13,
        "align": "left",
        "baseline": "top",
        "color": "#20343A"
      },
      "encoding": {
        "x": {
          "value": 10
        },
        "y": {
          "value": 17
        },
        "text": {
          "field": "annotation"
        }
      },
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "chosenLga === 'All' || datum.lga === chosenLga"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            },
            {
              "op": "sum",
              "field": "length_km",
              "as": "km"
            }
          ]
        },
        {
          "calculate": "(chosenLga === 'All' ? 'Victoria' : chosenLga) + ' · ' + datum.n + ' trails\\n' + format(datum.km,'.1f') + ' km; a route can cross borders'",
          "as": "annotation"
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "text": {
      "font": "Inter",
      "fontSize": 11,
      "color": "#20343A"
    },
    "legend": {
      "columns": 2,
      "labelLimit": 150
    }
  },
  "padding": 0,
  "description": "Direct labels and explanatory callouts are part of the plotting area. Grade colours are consistent across charts."
}
