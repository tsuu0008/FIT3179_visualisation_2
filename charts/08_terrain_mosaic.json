        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "title": "Grade mix within terrain",
          "axis": {
            "format": ".0%"
          },
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unclassified",
              "Unknown"
