{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 390,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "data": {
    "url": "data/mosaic.json"
  },
  "transform": [
    {
      "calculate": "(datum.x0 + datum.x1) / 2",
      "as": "xmid"
    },
    {
      "calculate": "(datum.y0 + datum.y1) / 2",
      "as": "ymid"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#f8fafc",
        "strokeWidth": 1.5,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0.024420095923542263,
              0.17797682140535606,
              0.5885887292765913,
              0.9045800856167394,
              0.969548081821962
            ],
            "labelExpr": "datum.value < 0.10119845866444917 ? ['Flat','4.9%'] : datum.value < 0.3832827753409737 ? ['Gentle hills','25.8%'] : datum.value < 0.7465844074466654 ? ['Short steep','56.3%'] : datum.value < 0.9370640837193507 ? ['Very','steep','6.9%'] : ['Steep','+ hard','6.1%']",
            "labelAngle": 0,
            "labelAlign": "center",
            "labelBaseline": "top",
            "labelPadding": 7,
            "labelLimit": 220,
            "labelFontSize": 10,
            "ticks": true,
            "tickSize": 5,
            "grid": false,
            "title": [
              "Terrain",
              "share of recorded kilometres"
            ],
            "titlePadding": 10,
            "titleFontSize": 12,
            "labelOverlap": false,
            "labelLineHeight": 12
          }
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "axis": {
            "format": ".0%",
            "values": [
              0,
              0.5,
              1
            ],
            "title": "Grade mix (%)",
            "titleFontSize": 12,
            "titlePadding": 10,
            "grid": false,
            "labelFontSize": 11
          },
          "scale": {
            "domain": [
              0,
              1
            ],
            "nice": false
          }
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#CC79A7",
              "#252525",
              "#9B9B9B"
            ]
          },
          "title": "Grade"
        },
        "tooltip": [
          {
            "field": "gradient",
            "title": "Terrain"
          },
          {
            "field": "grade",
            "title": "Grade"
          },
          {
            "field": "km",
            "title": "Recorded km",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 15,
        "align": "center",
        "baseline": "middle",
        "color": "#20343A",
        "stroke": "white",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "x": {
          "field": "xmid",
          "type": "quantitative"
        },
        "y": {
          "field": "ymid",
          "type": "quantitative"
        },
        "text": {
          "field": "annotation"
        }
      },
      "transform": [
        {
          "filter": "datum.gradient === 'Short steep hills' && datum.grade === 'Grade 3'"
        },
        {
          "calculate": "datum.grade + ' · ' + format(datum.km,'.1f') + ' km\\n' + (width < 550 ? 'The biggest block\\nof walking distance' : 'The biggest block of walking distance')",
          "as": "annotation"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 15,
        "align": "center",
        "baseline": "middle",
        "color": "#20343A"
      },
      "encoding": {
        "x": {
          "field": "xmid",
          "type": "quantitative"
        },
        "y": {
          "field": "ymid",
          "type": "quantitative"
        },
        "text": {
          "field": "annotation"
        }
      },
      "transform": [
        {
          "filter": "datum.gradient === 'Short steep hills' && datum.grade === 'Grade 3'"
        },
        {
          "calculate": "datum.grade + ' · ' + format(datum.km,'.1f') + ' km\\n' + (width < 550 ? 'The biggest block\\nof walking distance' : 'The biggest block of walking distance')",
          "as": "annotation"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 15,
        "align": "center",
        "baseline": "middle",
        "color": "#20343A",
        "stroke": "white",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "x": {
          "field": "xmid",
          "type": "quantitative"
        },
        "y": {
          "field": "ymid",
          "type": "quantitative"
        },
        "text": {
          "field": "annotation"
        }
      },
      "transform": [
        {
          "filter": "datum.gradient === 'Short steep hills' && datum.grade === 'Grade 4'"
        },
        {
          "calculate": "datum.grade + ' · ' + format(datum.km,'.1f') + ' km\\n' + (width < 550 ? 'Same terrain,\\nhigher difficulty' : 'Same terrain, higher difficulty')",
          "as": "annotation"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 15,
        "align": "center",
        "baseline": "middle",
        "color": "#20343A"
      },
      "encoding": {
        "x": {
          "field": "xmid",
          "type": "quantitative"
        },
        "y": {
          "field": "ymid",
          "type": "quantitative"
        },
        "text": {
          "field": "annotation"
        }
      },
      "transform": [
        {
          "filter": "datum.gradient === 'Short steep hills' && datum.grade === 'Grade 4'"
        },
        {
          "calculate": "datum.grade + ' · ' + format(datum.km,'.1f') + ' km\\n' + (width < 550 ? 'Same terrain,\\nhigher difficulty' : 'Same terrain, higher difficulty')",
          "as": "annotation"
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "orient": "bottom",
      "direction": "horizontal",
      "padding": 8,
      "columns": 3,
      "labelLimit": 150,
      "symbolType": "circle",
      "symbolStrokeWidth": 0,
      "symbolOpacity": 1
    },
    "text": {
      "font": "Inter",
      "fontSize": 11,
      "color": "#20343A"
    }
  },
  "padding": {
    "top": 5,
    "left": 5,
    "right": 5,
    "bottom": 5
  },
  "description": "Direct labels and explanatory callouts are part of the plotting area. Grade colours are consistent across charts."
}
