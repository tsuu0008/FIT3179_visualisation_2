            "columns": 4,
            "symbolType": "circle",
            "titleLimit": 220
          }
        },
        "tooltip": [
          {
            "field": "gradient",
            "title": "Terrain"
          },
          {
            "field": "grade",
            "title": "Grade"
          },
          {
            "field": "km",
            "format": ".2f",
            "title": "Kilometres"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "(datum.x0+datum.x1)/2",
          "as": "cx"
        },
        {
          "calculate": "(datum.y0+datum.y1)/2",
          "as": "cy"
        },
        {
          "filter": "(datum.x1-datum.x0) > 0.13 && (datum.y1-datum.y0) > 0.12"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "cx",
          "type": "quantitative"
        },
        "y": {
          "field": "cy",
          "type": "quantitative"
        },
        "text": {
          "field": "grade"
        },
        "color": {
          "condition": {
            "test": "datum.grade === 'Grade 5' || datum.grade === 'Unclassified'",
            "value": "white"
          },
          "value": "#152d2a"
        }
      }
