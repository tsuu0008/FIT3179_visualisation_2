{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "background": null,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#405652",
      "titleColor": "#24443f",
      "gridColor": "#e4ebe7"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "data": {
    "url": "data/mosaic.json?v=47450bcc79d0"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "title": "Terrain (width shows kilometre share)",
          "axis": {
            "values": [
              0.02639698805412443,
              0.1718988846741776,
              0.5675847817471549,
              0.8852827945422631,
              0.9631999094151612
            ],
            "labelExpr": "abs(datum.value - 0.02639698805412443) < 0.000001 ? \"Flat\" : abs(datum.value - 0.1718988846741776) < 0.000001 ? \"Gentle hills\" : abs(datum.value - 0.5675847817471549) < 0.000001 ? \"Short steep\" : abs(datum.value - 0.8852827945422631) < 0.000001 ? \"Very steep\" : abs(datum.value - 0.9631999094151612) < 0.000001 ? \"Steep + difficult\" : ''",
            "labelAngle": -30,
            "labelLimit": 140,
            "labelFontSize": 10
          },
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "title": "Source-code mix within terrain",
          "axis": {
            "format": ".0%"
          },
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "track_code",
          "type": "nominal",
          "scale": {
            "domain": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C6",
              "3",
              "Unknown"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#CC79A7",
              "#252525",
              "#6f52a3",
              "#ad6f3b",
              "#9daca9"
            ]
          },
          "legend": {
            "title": "Recorded track code",
            "orient": "bottom",
            "columns": 4,
            "symbolType": "circle",
            "titleLimit": 220
          }
        },
        "tooltip": [
          {
            "field": "gradient",
            "title": "Terrain"
          },
          {
            "field": "track_code",
            "title": "Source code"
          },
          {
            "field": "km",
            "format": ".2f",
            "title": "Kilometres"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "(datum.x0+datum.x1)/2",
          "as": "cx"
        },
        {
          "calculate": "(datum.y0+datum.y1)/2",
          "as": "cy"
        },
        {
          "filter": "(datum.x1-datum.x0) > 0.13 && (datum.y1-datum.y0) > 0.12"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "cx",
          "type": "quantitative"
        },
        "y": {
          "field": "cy",
          "type": "quantitative"
        },
        "text": {
          "field": "track_code"
        },
        "color": {
          "condition": {
            "test": "datum.track_code === 'C5' || datum.track_code === 'C6'",
            "value": "white"
          },
          "value": "#152d2a"
        }
      }
    }
  ],
  "description": "Mosaic area represents kilometres among records with known terrain and source code. Missing source codes are excluded explicitly."
}
