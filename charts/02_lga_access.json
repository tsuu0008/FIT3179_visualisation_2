{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 1000,
  "height": 550,
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "domainColor": "#9aa7a4",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom",
      "titleLimit": 300,
      "labelFontSize": 12,
      "titleFontSize": 13,
      "padding": 8
    },
    "header": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#0f172a"
    }
  },
  "data": {
    "url": "data/lga.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "projection": {
    "type": "mercator",
    "center": [
      144.8,
      -37.2
    ],
    "scale": 4300
  },
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "#f8fafc",
        "strokeWidth": 0.7
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        },
        "color": {
          "field": "properties.trail_km_per_100k",
          "type": "quantitative",
          "scale": {
            "scheme": "tealblues",
            "type": "sqrt"
          },
          "title": "Trail km per 100,000 residents"
        },
        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "LGA"
          },
          {
            "field": "properties.trail_count",
            "type": "quantitative",
            "title": "Trails"
          },
          {
            "field": "properties.trail_km",
            "type": "quantitative",
            "title": "Recorded km",
            "format": ".1f"
          },
          {
            "field": "properties.population",
            "type": "quantitative",
            "title": "Population (2025)",
            "format": ","
          },
          {
            "field": "properties.trail_km_per_100k",
            "type": "quantitative",
            "title": "Km per 100k",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "datum.properties.trail_km_per_100k",
          "as": "supply"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "annotation_rank"
            }
          ],
          "sort": [
            {
              "field": "supply",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.annotation_rank === 1"
        },
        {
          "calculate": "datum.properties.name + '\\n' + format(datum.supply, '.0f') + ' km / 100,000 residents'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": -14,
        "font": "Inter",
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#173b37",
        "limit": 240,
        "lineBreak": "\n",
        "stroke": "white",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "longitude": {
          "field": "properties.annotation_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "properties.annotation_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "annotation"
        }
      }
    },
    {
      "transform": [
        {
          "calculate": "datum.properties.trail_km_per_100k",
          "as": "supply"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "annotation_rank"
            }
          ],
          "sort": [
            {
              "field": "supply",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.annotation_rank === 1"
        },
        {
          "calculate": "datum.properties.name + '\\n' + format(datum.supply, '.0f') + ' km / 100,000 residents'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": -14,
        "font": "Inter",
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#173b37",
        "limit": 240,
        "lineBreak": "\n"
      },
      "encoding": {
        "longitude": {
          "field": "properties.annotation_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "properties.annotation_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "annotation"
        }
      }
    }
  ]
}