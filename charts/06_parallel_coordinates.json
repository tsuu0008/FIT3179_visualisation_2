        "color": "#eef3f0"
      },
      "encoding": {
        "x": {
          "datum": -0.05,
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -0.05,
              3.4
            ]
          }
        },
        "y": {
          "datum": -21,
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -22,
              145
            ]
          }
        },
        "x2": {
          "datum": 3.4
        },
        "y2": {
          "datum": -8
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "axis": 0,
            "label": "Walking grade"
          },
          {
            "axis": 1,
            "label": "Distance (km)¹"
          },
          {
            "axis": 2,
            "label": "Time (hours)¹"
          },
          {
            "axis": 3,
            "label": "Terrain"
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#a9bfb4"
      },
      "encoding": {
        "x": {
          "field": "axis",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.05,
              3.4
            ]
          },
          "axis": null
        },
        "y": {
          "datum": 0,
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -22,
              145
            ]
          }
        },
        "y2": {
          "datum": 100
        }
      }
    },
    {
      "data": {
        "url": "data/parallel_points.json"
      },
      "mark": {
        "type": "line",
        "opacity": 0.22,
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "axis",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.05,
              3.4
            ]
          },
          "axis": null
        },
        "y": {
          "field": "position",
          "type": "quantitative",
          "scale": {
            "domain": [
              -22,
              145
            ]
          },
          "axis": null
        },
        "detail": {
          "field": "id"
        },
        "order": {
          "field": "axis"
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#CC79A7",
              "#252525",
              "#9B9B9B"
            ]
          },
          "title": "Grade",
          "legend": {
            "title": "Walking grade",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 6,
            "symbolType": "stroke",
            "symbolStrokeWidth": 4,
            "symbolOpacity": 1,
            "labelFontSize": 12,
            "titleFontSize": 12,
            "labelLimit": 100,
            "offset": 16
          }
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Trail"
          },
          {
            "field": "grade",
            "title": "Grade"
          },
          {
            "field": "length_km",
            "title": "Distance (km)"
          },
          {
            "field": "hours",
            "title": "Hours"
          },
          {
            "field": "gradient",
            "title": "Terrain"
          }
        ]
      },
      "transform": [
        {
          "filter": "(pcGrade === 'All' || datum.grade === pcGrade) && (pcArea === 'All' || datum.lga === pcArea) && (pcTime === 'All' || (pcTime === 'Known' ? isValid(datum.hours) && datum.hours > 0 : !isValid(datum.hours) || datum.hours <= 0))"
        }
      ]
    },
    {
      "data": {
        "url": "data/parallel_points.json"
      },
      "transform": [
        {
          "filter": "(pcGrade === 'All' || datum.grade === pcGrade) && (pcArea === 'All' || datum.lga === pcArea) && (pcTime === 'All' || (pcTime === 'Known' ? isValid(datum.hours) && datum.hours > 0 : !isValid(datum.hours) || datum.hours <= 0))"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "focus_rank"
            }
          ],
          "groupby": [
            "axis"
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "id",
              "order": "ascending"
            }
          ]
        },
        {
