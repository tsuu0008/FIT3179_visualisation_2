{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 340,
  "height": 340,
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "domainColor": "#9aa7a4",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "padding": 8
    },
    "header": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#0f172a"
    }
  },
  "data": {
    "url": "data/access_waffle.json"
  },
  "mark": {
    "type": "square",
    "size": 900,
    "cornerRadius": 3
  },
  "encoding": {
    "x": {
      "field": "column",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "sort": "descending",
      "axis": null
    },
    "color": {
      "field": "status",
      "type": "nominal",
      "scale": {
        "domain": [
          "Full or partial access",
          "No disabled access"
        ],
        "range": [
          "#e76f51",
          "#d8e2df"
        ]
      },
      "title": "Recorded access"
    },
    "tooltip": [
      {
        "field": "status",
        "title": "Each square = 1%"
      }
    ]
  },
  "title": {
    "text": "15 of 179 rated trails indicate access",
    "subtitle": "8 highlighted squares ≈ 8%; exact share: 8.4%",
    "anchor": "start",
    "font": "Inter",
    "fontSize": 15,
    "subtitleFontSize": 12,
    "color": "#173b37",
    "subtitleColor": "#536a64",
    "offset": 16
  }
}