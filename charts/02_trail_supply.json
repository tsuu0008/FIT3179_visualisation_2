{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "autosize": {"type": "fit", "contains": "padding"},
  "background": null,
  "data": {"url": "data/lga.geojson", "format": {"type": "json", "property": "features"}},
  "params": [
    {
      "name": "metric",
      "value": "resident",
      "bind": {
        "input": "select",
        "options": ["resident", "total"],
        "name": "Colour by: ",
        "labels": ["Km per 100,000 residents", "Total recorded km"]
      }
    }
  ],
  "projection": {"type": "mercator"},
  "layer": [
    {
      "mark": {"type": "geoshape", "stroke": "#f8fafc", "strokeWidth": 0.7},
      "encoding": {
        "color": {
          "field": "supplyValue",
          "type": "quantitative",
          "scale": {
            "scheme": "tealblues",
            "type": "sqrt",
            "domain": [0, {"expr": "metric === 'resident' ? 844.2 : 146.5"}]
          },
          "title": {"expr": "metric === 'resident' ? 'Km per 100,000 residents' : 'Total recorded kilometres'"}
        },
        "tooltip": [
          {"field": "properties.name", "type": "nominal", "title": "LGA"},
          {"field": "properties.trail_count", "type": "quantitative", "title": "Trails"},
          {"field": "properties.trail_km", "type": "quantitative", "title": "Recorded km", "format": ".1f"},
          {
            "field": "properties.population",
            "type": "quantitative",
            "title": "Population (2025)",
            "format": ","
          },
          {
            "field": "properties.trail_km_per_100k",
            "type": "quantitative",
            "title": "Km per 100k",
            "format": ".1f"
          }
        ]
      },
      "transform": [
        {
          "calculate": "metric === 'resident' ? datum.properties.trail_km_per_100k : datum.properties.trail_km",
          "as": "supplyValue"
        }
      ]
    },
    {
      "transform": [
        {
          "calculate": "metric === 'resident' ? datum.properties.trail_km_per_100k : datum.properties.trail_km",
          "as": "supplyValue"
        },
        {
          "window": [{"op": "row_number", "as": "rank"}],
          "sort": [{"field": "supplyValue", "order": "descending"}]
        },
        {"filter": "datum.rank === 1"},
        {
          "calculate": "datum.properties.name + '\\n' + format(datum.supplyValue, '.1f') + (metric === 'resident' ? ' km / 100,000' : ' km recorded')",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "fontWeight": 700,
        "lineBreak": "\n",
        "color": "#173b37",
        "stroke": "white",
        "strokeWidth": 3,
        "limit": 240
      },
      "encoding": {"x": {"value": 8}, "y": {"value": 10}, "text": {"field": "annotation"}}
    },
    {
      "transform": [
        {
          "calculate": "metric === 'resident' ? datum.properties.trail_km_per_100k : datum.properties.trail_km",
          "as": "supplyValue"
        },
        {
          "window": [{"op": "row_number", "as": "rank"}],
          "sort": [{"field": "supplyValue", "order": "descending"}]
        },
        {"filter": "datum.rank === 1"},
        {
          "calculate": "datum.properties.name + '\\n' + format(datum.supplyValue, '.1f') + (metric === 'resident' ? ' km / 100,000' : ' km recorded')",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "fontWeight": 700,
        "lineBreak": "\n",
        "color": "#173b37",
        "limit": 240
      },
      "encoding": {"x": {"value": 8}, "y": {"value": 10}, "text": {"field": "annotation"}}
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "domainColor": "#9aa7a4",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom",
      "titleLimit": 300,
      "labelFontSize": 12,
      "titleFontSize": 13,
      "padding": 8,
      "columns": 2,
      "direction": "horizontal",
      "labelLimit": 150,
      "gradientLength": 220
    },
    "header": {"labelFont": "Inter", "titleFont": "Inter", "labelColor": "#0f172a"}
  }
}
