{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 520,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "data": {
    "url": "data/lga.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "params": [
    {
      "name": "metric",
      "value": "resident",
      "bind": {
        "input": "select",
        "options": [
          "resident",
          "total"
        ],
        "name": "Colour by: ",
        "labels": [
          "Km per 100,000 residents",
          "Total recorded km"
        ]
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "#f8fafc",
        "strokeWidth": 0.7
      },
      "encoding": {
        "color": {
          "field": "supplyValue",
          "type": "quantitative",
          "scale": {
            "scheme": "tealblues",
            "type": "sqrt",
            "domain": [
              0,
              {
                "expr": "metric === 'resident' ? 850 : 150"
              }
            ]
          },
          "title": {
            "expr": "metric === 'resident' ? 'Km per 100,000 residents' : 'Total recorded kilometres'"
          }
        },
        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "LGA"
          },
          {
            "field": "properties.trail_count",
            "type": "quantitative",
            "title": "Trails"
          },
          {
            "field": "properties.trail_km",
            "type": "quantitative",
            "title": "Recorded km",
            "format": ".1f"
          },
          {
            "field": "properties.population",
            "type": "quantitative",
            "title": "Population (2025)",
            "format": ","
          },
          {
            "field": "properties.trail_km_per_100k",
            "type": "quantitative",
            "title": "Km per 100k",
            "format": ".1f"
          }
        ]
      },
      "transform": [
        {
          "calculate": "metric === 'resident' ? datum.properties.trail_km_per_100k : datum.properties.trail_km",
          "as": "supplyValue"
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "lon": 145.702891875,
            "lat": -37.4585353125
          }
        ]
      },
      "transform": [
        {
          "calculate": "metric === 'resident' ? 'Murrindindi · 844.2 km / 100k\\nHighest supply per resident' : 'Murrindindi · 132.1 km\\n32 trails form a regional cluster'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#20343A",
        "strokeWidth": 1.1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "datum": 143.7
        },
        "latitude2": {
          "datum": -35.1
        }
