{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 1000,
  "height": 390,
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "domainColor": "#9aa7a4",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6,
      "tickCount": 7
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "padding": 8
    },
    "header": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#0f172a"
    }
  },
  "data": {
    "url": "data/trails.json"
  },
  "transform": [
    {
      "filter": "isValid(datum.length_km) && isValid(datum.hours) && datum.hours > 0"
    },
    {
      "calculate": "datum.length_km / datum.hours",
      "as": "pace_kmh"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "point",
        "filled": true,
        "opacity": 0.68,
        "size": 72
      },
      "encoding": {
        "x": {
          "field": "length_km",
          "type": "quantitative",
          "title": "Distance (km)"
        },
        "y": {
          "field": "hours",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              52
            ]
          },
          "title": "Estimated time (hours)"
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ],
            "range": [
              "#2a9d8f",
              "#69b578",
              "#e9c46a",
              "#f4a261",
              "#e76f51",
              "#9aa2a6"
            ]
          },
          "title": "Grade"
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Trail"
          },
          {
            "field": "grade",
            "title": "Grade"
          },
          {
            "field": "length_km",
            "title": "Distance (km)"
          },
          {
            "field": "hours",
            "title": "Hours"
          },
          {
            "field": "pace_kmh",
            "title": "Implied pace (km/h)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "regression": "hours",
          "on": "length_km",
          "method": "linear"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#153e3a",
        "strokeDash": [
          6,
          4
        ],
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "length_km",
          "type": "quantitative"
        },
        "y": {
          "field": "hours",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": false,
        "size": 240,
        "stroke": "#b34e2d",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "length_km",
          "type": "quantitative",
          "title": "Distance (km)"
        },
        "y": {
          "field": "hours",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              52
            ]
          },
          "title": "Estimated time (hours)"
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Trail"
          },
          {
            "field": "grade",
            "title": "Grade"
          },
          {
            "field": "length_km",
            "title": "Distance (km)"
          },
          {
            "field": "hours",
            "title": "Hours"
          },
          {
            "field": "pace_kmh",
            "title": "Implied pace (km/h)",
            "format": ".1f"
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.name === 'Track Ninety Six' || datum.name === 'Great Dividing Trail'"
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.name === 'Track Ninety Six' || datum.name === 'Great Dividing Trail'"
        },
        {
          "calculate": "datum.name + '\\n' + format(datum.length_km, '.1f') + ' km \u00b7 ' + format(datum.hours, '.0f') + ' hours'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -7,
        "dy": -12,
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#173b37",
        "lineBreak": "\n"
      },
      "encoding": {
        "x": {
          "field": "length_km",
          "type": "quantitative"
        },
        "y": {
          "field": "hours",
          "type": "quantitative"
        },
        "text": {
          "field": "annotation"
        }
      }
    },
    {
      "transform": [
        {
          "regression": "hours",
          "on": "length_km",
          "method": "linear",
          "params": true
        },
        {
          "calculate": "'Trend: ' + format(datum.coef[1], '.2f') + ' h/km'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "fontSize": 12,
        "color": "#173b37",
        "dy": -8
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width - 14"
          }
        },
        "y": {
          "value": {
            "expr": "height * 0.47"
          }
        },
        "text": {
          "field": "annotation"
        }
      }
    }
  ]
}
