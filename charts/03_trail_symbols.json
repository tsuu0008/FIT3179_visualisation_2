{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 1000,
  "height": 540,
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "domainColor": "#9aa7a4",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "padding": 8
    },
    "header": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#0f172a"
    }
  },
  "projection": {
    "type": "mercator",
    "center": [
      144.8,
      -37.2
    ],
    "scale": 4300
  },
  "layer": [
    {
      "data": {
        "url": "data/lga.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1f5f4",
        "stroke": "#c8d4d1",
        "strokeWidth": 0.6
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        }
      }
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.68,
        "stroke": "#ffffff",
        "strokeWidth": 0.45
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "length_km",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "range": [
              18,
              900
            ]
          },
          "title": "Distance (km)"
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ],
            "range": [
              "#2a9d8f",
              "#69b578",
              "#e9c46a",
              "#f4a261",
              "#e76f51",
              "#9aa2a6"
            ]
          },
          "title": "Grade"
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Trail"
          },
          {
            "field": "length_km",
            "title": "Distance (km)",
            "format": ".1f"
          },
          {
            "field": "grade",
            "title": "Grade"
          },
          {
            "field": "access",
            "title": "Disabled access"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "(chosenGrade === 'All' || datum.grade === chosenGrade) && (chosenLga === 'All' || datum.lga === chosenLga) && isValid(datum.length_km) && datum.length_km <= maximumKm && (!accessOnly || datum.access === 'Full' || datum.access === 'Partial')"
        },
        {
          "filter": "selectedTrail === '' || datum.name === selectedTrail"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "annotation_rank"
            }
          ],
          "sort": [
            {
              "field": "length_km",
              "order": "descending"
            },
            {
              "field": "name",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.annotation_rank === 1"
        },
        {
          "calculate": "datum.name + '\\n' + format(datum.length_km, '.1f') + ' km'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": -14,
        "font": "Inter",
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#173b37",
        "limit": 240,
        "lineBreak": "\n"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}