{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 500,
  "height": 270,
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 11,
      "orient": "bottom",
      "columns": 2
    }
  },
  "data": {
    "url": "data/trails.json"
  },
  "transform": [
    {
      "filter": "datum.gradient !== 'Unknown' && datum.experience !== 'Unknown'"
    },
    {
      "calculate": "datum.experience === 'No experience required' ? 'None required' : datum.experience === 'Bushwalking experience recommended' ? 'Recommended' : datum.experience === 'Experienced bushwalkers' ? 'Experienced' : 'Very experienced'",
      "as": "experience_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 2
      },
      "encoding": {
        "y": {
          "field": "gradient",
          "type": "nominal",
          "sort": [
            "Flat",
            "Gentle hills",
            "Short steep hills",
            "Very steep",
            "Very steep and difficult"
          ],
          "title": null,
          "axis": {
            "labelLimit": 155
          }
        },
        "x": {
          "aggregate": "count",
          "type": "quantitative",
          "stack": "zero",
          "title": "Number of trails"
        },
        "color": {
          "field": "experience_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "None required",
              "Recommended",
              "Experienced",
              "Very experienced"
            ],
            "range": [
              "#9bd8ca",
              "#44a693",
              "#176b61",
              "#0b3f3a"
            ]
          },
          "title": "Experience"
        },
        "order": {
          "field": "experience_label",
          "sort": "ascending"
        },
        "tooltip": [
          {
            "field": "gradient",
            "title": "Terrain"
          },
          {
            "field": "experience",
            "title": "Experience"
          },
          {
            "aggregate": "count",
            "title": "Trails"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "trail_count"
            }
          ],
          "groupby": [
            "gradient"
          ]
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#173b37"
      },
      "encoding": {
        "y": {
          "field": "gradient",
          "type": "nominal",
          "sort": [
            "Flat",
            "Gentle hills",
            "Short steep hills",
            "Very steep",
            "Very steep and difficult"
          ]
        },
        "x": {
          "field": "trail_count",
          "type": "quantitative"
        },
        "text": {
          "field": "trail_count"
        }
      }
    }
  ]
}
