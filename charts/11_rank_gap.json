{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 520,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "data": {
    "url": "data/lga_stats.json"
  },
  "transform": [
    {
      "filter": "datum.trail_count > 0 && datum.population_rank <= 18"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#a8b8b4",
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "field": "name",
          "type": "nominal",
          "sort": {
            "field": "population_rank",
            "op": "min",
            "order": "ascending"
          },
          "title": null,
          "axis": {
            "grid": true,
            "gridColor": "#e6ece9",
            "gridWidth": 0.7,
            "ticks": false,
            "labelLimit": 145
          },
          "scale": {
            "padding": 0.9
          }
        },
        "x": {
          "field": "population_rank",
          "type": "quantitative",
          "title": [
            "Rank among areas with trails",
            "1 = highest"
          ],
          "scale": {
            "domain": [
              0,
              32
            ],
            "nice": false
          },
          "axis": {
            "values": [
              1,
              5,
              10,
              15,
              20,
              25,
              30,
              31
            ],
            "grid": true,
            "gridColor": "#ccd6d2",
            "gridDash": [
              2,
              3
            ],
            "gridWidth": 1
          }
        },
        "x2": {
          "field": "supply_rank"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "stroke": "#d95d39",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "name",
          "type": "nominal",
          "sort": {
            "field": "population_rank",
            "op": "min",
            "order": "ascending"
          },
          "title": null
        },
        "x": {
          "field": "population_rank",
          "type": "quantitative",
          "title": [
            "Rank among areas with trails",
            "1 = highest"
          ],
          "scale": {
            "domain": [
              0,
              32
            ],
            "nice": false
          }
        },
        "x2": {
          "field": "supply_rank"
        }
      },
      "transform": [
        {
          "filter": "datum.name === 'Whittlesea' || datum.name === 'Cardinia'"
        }
      ]
    },
    {
      "transform": [
        {
          "fold": [
            "population_rank",
            "supply_rank"
          ],
          "as": [
            "measure",
            "rank"
          ]
        },
        {
          "calculate": "datum.measure === 'population_rank' ? 'Population rank' : 'Trail supply rank'",
          "as": "measure_label"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 95
      },
      "encoding": {
        "y": {
          "field": "name",
          "type": "nominal",
          "sort": {
            "field": "population_rank",
            "op": "min",
            "order": "ascending"
          },
          "title": null
        },
        "x": {
          "field": "rank",
          "type": "quantitative"
        },
        "color": {
          "field": "measure_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "Population rank",
              "Trail supply rank"
            ],
            "range": [
              "#264653",
              "#e76f51"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "labelLimit": 180
          }
        },
        "tooltip": [
          {
            "field": "name",
            "title": "LGA"
          },
          {
            "field": "measure_label",
            "title": "Measure"
          },
          {
            "field": "rank",
            "title": "Rank"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.name === 'Whittlesea' || datum.name === 'Cardinia'"
        },
        {
          "calculate": "(datum.population_rank + datum.supply_rank) / 2",
          "as": "annotation_rank"
        },
        {
          "calculate": "'Population ' + datum.population_rank + ' → supply ' + datum.supply_rank + ' · fewer km per resident'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 600,
        "align": "center",
        "baseline": "bottom",
        "dy": -8,
        "color": "#20343A",
        "stroke": "white",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "x": {
          "field": "annotation_rank",
          "type": "quantitative"
        },
        "y": {
          "field": "name",
          "type": "nominal",
          "sort": {
            "field": "population_rank",
            "op": "min",
            "order": "ascending"
          },
          "title": null
        },
        "text": {
          "field": "annotation"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.name === 'Whittlesea' || datum.name === 'Cardinia'"
        },
        {
          "calculate": "(datum.population_rank + datum.supply_rank) / 2",
          "as": "annotation_rank"
        },
        {
          "calculate": "'Population ' + datum.population_rank + ' → supply ' + datum.supply_rank + ' · fewer km per resident'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 600,
        "align": "center",
        "baseline": "bottom",
        "dy": -8,
        "color": "#20343A"
      },
      "encoding": {
        "x": {
          "field": "annotation_rank",
          "type": "quantitative"
        },
        "y": {
          "field": "name",
          "type": "nominal",
          "sort": {
            "field": "population_rank",
            "op": "min",
            "order": "ascending"
          },
          "title": null
        },
        "text": {
          "field": "annotation"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "domainColor": "#9aa7a4",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "padding": 8,
      "columns": 1,
      "labelLimit": 220
    },
    "header": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#0f172a"
    },
    "text": {
      "font": "Inter",
      "fontSize": 11,
      "color": "#20343A"
    }
  },
  "description": "Full-width rank comparison on a 1–31 rank range, with row and rank gridlines and direct annotations above the two highlighted rows."
}
