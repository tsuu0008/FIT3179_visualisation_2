    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 12,
        "fontWeight": 700,
        "lineBreak": "\n",
        "lineHeight": 17,
        "color": "#20343A"
      },
      "encoding": {
