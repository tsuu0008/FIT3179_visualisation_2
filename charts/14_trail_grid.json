{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 550,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "description": "Square spatial bin map of retained trail midpoints in fixed 25 km equal-area cells. A clipped grid shows empty land bins. The lettered peak-bin pointer and explanation share the legend footer.",
  "projection": {
    "type": "identity",
    "reflectY": true,
    "scale": {
      "expr": "min((width-20)/840000,(height-20)/600000)"
    },
    "translate": {
      "expr": "[width/2-30000*(min((width-20)/840000,(height-20)/600000)),8+340000*(min((width-20)/840000,(height-20)/600000))]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/trail_grid.json?v=afcdeb1e2476",
        "format": {
          "type": "json",
          "property": "outline"
        },
        "name": "grid_outline"
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0f3f5",
        "stroke": "#8b9da8",
        "strokeWidth": 0.8
      }
    },
    {
      "name": "landGrid",
      "data": {
        "url": "data/trail_grid.json?v=afcdeb1e2476",
        "name": "grid_lines",
        "format": {
          "type": "json",
          "property": "grid_lines"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#b5c2cb",
        "strokeWidth": 0.65
      }
    },
    {
      "name": "gridCells",
      "data": {
        "url": "data/trail_grid.json?v=afcdeb1e2476",
        "format": {
          "type": "json",
          "property": "cells"
        },
        "name": "grid_cells"
      },
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -390000,
              450000
            ],
            "range": [
              {
                "expr": "width/2-420000*(min((width-20)/840000,(height-20)/600000))"
              },
              {
                "expr": "width/2+420000*(min((width-20)/840000,(height-20)/600000))"
              }
            ],
            "nice": false,
            "zero": false
          }
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -260000,
              340000
            ],
            "range": [
              {
                "expr": "8+600000*(min((width-20)/840000,(height-20)/600000))"
              },
              8
            ],
            "nice": false,
            "zero": false
          }
        },
        "x2": {
          "field": "x1"
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "count_band",
          "type": "ordinal",
          "scale": {
            "domain": [
              "0",
              "1",
              "2–3",
              "4–6",
              "7–13"
            ],
            "range": [
              "#f0f3f5",
              "#d3e4ed",
              "#8abbd5",
              "#3e87b0",
              "#13557c"
            ]
          },
          "legend": {
            "title": "Trails per 25 km bin",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 5,
            "symbolType": "circle",
            "symbolSize": 110,
            "titleLimit": 300,
            "labelExpr": "datum.label === '0' ? '0 recorded' : datum.label"
          }
        },
        "tooltip": [
          {
            "field": "trail_count",
            "title": "Recorded trails"
          },
          {
            "field": "share",
            "type": "quantitative",
            "format": ".1%",
            "title": "Share of all 195 trails"
          },
          {
            "field": "areas",
            "title": "Council counts"
          },
          {
            "field": "trail_km",
            "type": "quantitative",
            "format": ".1f",
            "title": "Combined trail km"
          },
          {
            "field": "cell_id",
            "title": "Grid cell"
          }
        ]
      }
    },
    {
      "name": "gridPeakHalo",
      "data": {
        "url": "data/trail_grid.json?v=afcdeb1e2476",
        "format": {
          "type": "json",
          "property": "cells"
        },
        "name": "grid_cells"
      },
