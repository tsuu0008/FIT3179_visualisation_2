{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "background": null,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#405652",
      "titleColor": "#24443f",
      "gridColor": "#e4ebe7"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "data": {
    "url": "data/distance_points.json"
  },
  "mark": {
    "type": "point",
    "filled": true,
    "size": 50,
    "opacity": 0.65
  },
  "encoding": {
    "x": {
      "field": "length_km",
      "type": "quantitative",
      "title": "Recorded distance (km; square-root spacing)",
      "scale": {
        "type": "sqrt",
        "domain": [
          0,
          100
        ]
      },
      "axis": {
        "values": [
          0,
          1,
          5,
          10,
          20,
          40,
          60,
          95
        ]
      }
    },
    "y": {
      "field": "track_code",
      "type": "ordinal",
      "sort": [
        "C1",
        "C2",
        "C3",
        "C4",
        "C5",
        "C6",
        "3",
        "Unknown"
      ],
      "title": "Source code"
    },
    "yOffset": {
      "field": "lane",
      "type": "quantitative"
    },
    "color": {
      "field": "track_code",
      "type": "nominal",
      "scale": {
        "domain": [
          "C1",
          "C2",
          "C3",
          "C4",
          "C5",
          "C6",
          "3",
          "Unknown"
        ],
        "range": [
          "#0072B2",
          "#E69F00",
          "#009E73",
          "#CC79A7",
          "#252525",
          "#6f52a3",
          "#ad6f3b",
          "#9daca9"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "name",
        "title": "Trail"
      },
      {
        "field": "track_code",
        "title": "Source code"
      },
      {
        "field": "length_km",
        "title": "Distance (km)",
        "format": ".2f"
      },
      {
        "field": "duration_group",
        "title": "Source duration category"
      },
      {
        "field": "gradient",
        "title": "Terrain"
      },
      {
        "field": "lga",
        "title": "Council"
      }
    ]
  },
  "description": "Individual trail distances including missing source-code records. Vertical offsets only separate overlapping points."
}
