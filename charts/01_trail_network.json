{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/lga.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eef3f1",
        "stroke": "#9eafaa",
        "strokeWidth": 0.8
      },
      "encoding": {}
    },
    {
      "data": {
        "url": "data/trails.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeWidth": 3,
        "strokeCap": "round"
      },
      "encoding": {
        "color": {
          "field": "properties.grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#CC79A7",
              "#252525",
              "#9B9B9B"
            ]
          },
          "title": "Grade",
          "legend": {
            "orient": "bottom",
            "columns": 3,
            "title": "Walking grade"
          }
        },
        "opacity": {
          "value": 0.9
        },
        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "Trail"
          },
          {
            "field": "properties.grade",
            "type": "nominal",
            "title": "Grade"
          },
          {
            "field": "properties.length_km",
            "type": "quantitative",
            "title": "Distance (km)",
            "format": ".1f"
          },
          {
            "field": "properties.hours",
            "type": "quantitative",
            "title": "Time (hours)",
            "format": ".1f"
          },
          {
            "field": "properties.lga",
            "type": "nominal",
            "title": "LGA"
          }
        ]
      }
    },
