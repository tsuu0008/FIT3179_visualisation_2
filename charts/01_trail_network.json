{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 1000,
  "height": 560,
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "domainColor": "#9aa7a4",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6
    },
    "legend": {
      "labelColor": "#e8f3ef",
      "titleColor": "#ffffff",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "orient": "bottom",
      "padding": 8
    },
    "header": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#0f172a"
    }
  },
  "projection": {
    "type": "mercator",
    "center": [
      144.8,
      -37.2
    ],
    "scale": 4300
  },
  "layer": [
    {
      "data": {
        "url": "data/lga.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eef3f1",
        "stroke": "#9eafaa",
        "strokeWidth": 0.8
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        }
      }
    },
    {
      "data": {
        "url": "data/trails.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "params": [
        {
          "name": "gradePick",
          "select": {
            "type": "point",
            "fields": [
              "properties.grade"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeWidth": 3,
        "strokeCap": "round"
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        },
        "color": {
          "field": "properties.grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5",
              "Unknown"
            ],
            "range": [
              "#2a9d8f",
              "#69b578",
              "#e9c46a",
              "#f4a261",
              "#e76f51",
              "#9aa2a6"
            ]
          },
          "title": "Walking grade"
        },
        "opacity": {
          "condition": {
            "param": "gradePick",
            "value": 0.92
          },
          "value": 0.1
        },
        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "Trail"
          },
          {
            "field": "properties.grade",
            "type": "nominal",
            "title": "Grade"
          },
          {
            "field": "properties.length_km",
            "type": "quantitative",
            "title": "Distance (km)",
            "format": ".1f"
          },
          {
            "field": "properties.hours",
            "type": "quantitative",
            "title": "Time (hours)",
            "format": ".1f"
          },
          {
            "field": "properties.lga",
            "type": "nominal",
            "title": "LGA"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "datum.name === 'Upper Yarra Walking Track'"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 130,
        "filled": true,
        "color": "#7f1d1d",
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Trail"
          },
          {
            "field": "length_km",
            "title": "Distance (km)"
          },
          {
            "field": "grade",
            "title": "Grade"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/trails.json"
      },
      "transform": [
        {
          "filter": "datum.name === 'Upper Yarra Walking Track'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": -10,
        "font": "Inter",
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#7f1d1d",
        "lineBreak": "\n"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "value": "Longest recorded walk\nUpper Yarra · 95 km"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 145.67450984000004,
            "latitude": -37.28121487409041,
            "lga": "Murrindindi",
            "label": "Murrindindi\n32 recorded trails"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 9,
        "dy": -18,
        "font": "Inter",
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#173b37",
        "limit": 240,
        "lineBreak": "\n"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "url": "data/lga.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name === 'Murrindindi' && (chosenLga === 'All' || chosenLga === 'Murrindindi')"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fillOpacity": 0,
        "stroke": "#d95d39",
        "strokeWidth": 2.5,
        "strokeDash": [
          5,
          3
        ]
      },
      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        }
      }
    }
  ]
}