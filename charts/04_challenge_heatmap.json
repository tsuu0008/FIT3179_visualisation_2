{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 500,
  "height": 330,
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "domainColor": "#9aa7a4",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 6
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "padding": 8
    },
    "header": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#0f172a"
    }
  },
  "data": {
    "url": "data/trails.json"
  },
  "transform": [
    {
      "filter": "datum.grade !== 'Unknown' && datum.gradient !== 'Unknown'"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "trail_count"
        }
      ],
      "groupby": [
        "grade",
        "gradient"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 4
      },
      "encoding": {
        "x": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "Grade 1",
            "Grade 2",
            "Grade 3",
            "Grade 4",
            "Grade 5"
          ],
          "title": "Australian walking track grade",
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "gradient",
          "type": "nominal",
          "sort": [
            "Very steep and difficult",
            "Very steep",
            "Short steep hills",
            "Gentle hills",
            "Flat"
          ],
          "title": "Typical gradient"
        },
        "color": {
          "field": "trail_count",
          "type": "quantitative",
          "scale": {
            "scheme": "yellowgreenblue"
          },
          "title": "Trail count"
        },
        "tooltip": [
          {
            "field": "grade",
            "title": "Grade"
          },
          {
            "field": "gradient",
            "title": "Gradient"
          },
          {
            "field": "trail_count",
            "title": "Trails"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 700
      },
      "encoding": {
        "x": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "Grade 1",
            "Grade 2",
            "Grade 3",
            "Grade 4",
            "Grade 5"
          ],
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "gradient",
          "type": "nominal",
          "sort": [
            "Very steep and difficult",
            "Very steep",
            "Short steep hills",
            "Gentle hills",
            "Flat"
          ]
        },
        "text": {
          "field": "trail_count"
        },
        "color": {
          "condition": {
            "test": "datum.trail_count > 22",
            "value": "white"
          },
          "value": "#12332f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.grade === 'Grade 3' && datum.gradient === 'Short steep hills'"
        }
      ],
      "mark": {
        "type": "rect",
        "fillOpacity": 0,
        "stroke": "#d95d39",
        "strokeWidth": 3,
        "cornerRadius": 4
      },
      "encoding": {
        "x": {
          "field": "grade",
          "type": "ordinal",
          "sort": [
            "Grade 1",
            "Grade 2",
            "Grade 3",
            "Grade 4",
            "Grade 5"
          ],
          "title": "Australian walking track grade",
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "gradient",
          "type": "nominal",
          "sort": [
            "Very steep and difficult",
            "Very steep",
            "Short steep hills",
            "Gentle hills",
            "Flat"
          ],
          "title": "Typical gradient"
        }
      }
    }
  ]
}