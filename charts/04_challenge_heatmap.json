{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "background": null,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#405652",
      "titleColor": "#24443f",
      "gridColor": "#e4ebe7"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "data": {
    "url": "data/trails.json"
  },
  "transform": [
    {
      "filter": "datum.track_code !== 'Unknown' && datum.gradient !== 'Unknown'"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "trail_count"
        }
      ],
      "groupby": [
        "track_code",
        "gradient"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "track_code",
          "type": "ordinal",
          "sort": [
            "C1",
            "C2",
            "C3",
            "C4",
            "C5",
            "C6",
            "3"
          ],
          "title": "Recorded source code"
        },
        "y": {
          "field": "gradient",
          "type": "ordinal",
          "sort": [
            "Flat",
            "Gentle hills",
            "Short steep hills",
            "Very steep",
            "Very steep and difficult"
          ],
          "title": null,
          "axis": {
            "labelLimit": 145,
            "labelExpr": "datum.label === 'Very steep and difficult' ? 'Very steep + difficult' : datum.label"
          }
        },
        "color": {
          "field": "trail_count",
          "type": "quantitative",
          "scale": {
            "scheme": "blues"
          },
          "legend": {
            "title": "Trails",
            "orient": "bottom"
          }
        },
        "tooltip": [
          {
            "field": "track_code",
            "title": "Source code"
          },
          {
            "field": "gradient",
            "title": "Terrain"
          },
          {
            "field": "trail_count",
            "title": "Trails"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "track_code",
          "type": "ordinal",
          "sort": [
            "C1",
            "C2",
            "C3",
            "C4",
            "C5",
            "C6",
            "3"
          ],
          "title": "Recorded source code"
        },
        "y": {
          "field": "gradient",
          "type": "ordinal",
          "sort": [
            "Flat",
            "Gentle hills",
            "Short steep hills",
            "Very steep",
            "Very steep and difficult"
          ],
          "title": null,
          "axis": {
            "labelLimit": 145,
            "labelExpr": "datum.label === 'Very steep and difficult' ? 'Very steep + difficult' : datum.label"
          }
        },
        "text": {
          "field": "trail_count"
        },
        "color": {
          "condition": {
            "test": "datum.trail_count >= 20",
            "value": "white"
          },
          "value": "#183e3b"
        }
      }
    }
  ],
  "description": "Joint counts of unmodified source track codes and terrain. Missing codes are excluded, not assigned a difficulty grade."
}
