{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 1000,
  "height": 340,
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#d9e2df",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 13,
      "titleFontSize": 13
    },
    "legend": {
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "orient": "bottom",
      "direction": "horizontal"
    }
  },
  "data": {
    "url": "data/parallel.json"
  },
  "transform": [
    {
      "filter": "datum.grade !== 'Unknown'"
    },
    {
      "aggregate": [
        {
          "op": "median",
          "field": "value",
          "as": "median_value"
        }
      ],
      "groupby": [
        "grade",
        "metric",
        "order"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "opacity": 0.82
      },
      "encoding": {
        "x": {
          "field": "metric",
          "type": "ordinal",
          "sort": [
            "Distance",
            "Time",
            "Grade",
            "Steps",
            "Signage"
          ],
          "title": null,
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "median_value",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "axis": {
            "title": "Median relative value",
            "format": ".0%"
          }
        },
        "detail": {
          "field": "grade"
        },
        "order": {
          "field": "order"
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5"
            ],
            "range": [
              "#2a9d8f",
              "#69b578",
              "#e9c46a",
              "#f4a261",
              "#e76f51"
            ]
          },
          "title": "Grade"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 115,
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "metric",
          "type": "ordinal",
          "sort": [
            "Distance",
            "Time",
            "Grade",
            "Steps",
            "Signage"
          ],
          "title": null
        },
        "y": {
          "field": "median_value",
          "type": "quantitative"
        },
        "color": {
          "field": "grade",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grade 1",
              "Grade 2",
              "Grade 3",
              "Grade 4",
              "Grade 5"
            ],
            "range": [
              "#2a9d8f",
              "#69b578",
              "#e9c46a",
              "#f4a261",
              "#e76f51"
            ]
          },
          "title": "Grade"
        },
        "tooltip": [
          {
            "field": "grade",
            "title": "Grade"
          },
          {
            "field": "metric",
            "title": "Measure"
          },
          {
            "field": "median_value",
            "title": "Median relative value",
            "format": ".0%"
          }
        ]
      }
    }
  ]
}
